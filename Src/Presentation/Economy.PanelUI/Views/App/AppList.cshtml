@model IEnumerable<AppDto>

@{
    ViewData["Title"] = "Uygulamalar";
}


<main>
    <div class="container-fluid">
        <!-- Breadcrumb start -->
        <div class="row m-1">
            <div class="col-12 ">
                <h4 class="main-title">@ViewData["Title"] </h4>
                <ul class="app-line-breadcrumbs mb-3">
                    <li class="">
                        <a class="f-s-14 f-w-500" href="#">
                            <span>
                                <i class="ph-duotone  ph-table f-s-16"></i> Anasayfa
                            </span>
                        </a>
                    </li>
                    <li class="active">
                        <a class="f-s-14 f-w-500" href="#">@ViewData["Title"]</a>
                    </li>
                </ul>
            </div>
        </div>

        <!-- Breadcrumb end -->
        <!-- tables start  -->
        <div class="row table-section">

            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                            </div>
                            <div>
                                <div class="app-btn-list">
                                    <a class="btn btn-primary" asp-action="CreateApp">Yeni Ekle</a>
                                </div>
                            </div>
                        </div>
                    </div>
          
                </div>
            </div>
            <!-- Hoverable Table start -->
            <div class="col-xl-12">
                <div class="card">
                    <div class="card-header">
                        <h5> Kayıtlar </h5>
                        <p>
                           Aşağıda kayıtlı bilgiler bulunmaktadır.
                        </p>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-bottom-border table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>@Html.DisplayNameFor(model => model.Id)</th>
                                        <th>@Html.DisplayNameFor(model => model.HotelName)</th>
                                        <th>@Html.DisplayNameFor(model => model.ServerName)</th>
                                        <th>@Html.DisplayNameFor(model => model.DatabaseName)</th>
                                        <th>@Html.DisplayNameFor(model => model.UserName)</th>
                                        <th>@Html.DisplayNameFor(model => model.PasswordStatus)</th>
                                        <th>@Html.DisplayNameFor(model => model.Domain)</th>
                                        <th>İşlemler</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>@Html.DisplayFor(modelItem => item.Id)</td>
                                            <td>@Html.DisplayFor(modelItem => item.HotelName)</td>
                                            <td>@Html.DisplayFor(modelItem => item.ServerName)</td>
                                            <td>@Html.DisplayFor(modelItem => item.DatabaseName)</td>
                                            <td>@Html.DisplayFor(modelItem => item.UserName)</td>
                                            <td>@Html.DisplayFor(modelItem => item.PasswordStatus)</td>
                                            <td>@Html.DisplayFor(modelItem => item.Domain)</td>
                                            <td>
                                                <a asp-action="EditApp" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Güncelle</a>
                                                <a asp-action="DetailsApp" asp-route-id="@item.Id" class="btn btn-sm btn-info ms-1">İncele</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Hoverable Table end -->


        </div>
        <!-- tables-end  -->
    </div>
</main>


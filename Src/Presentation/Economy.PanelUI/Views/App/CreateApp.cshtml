@using Economy.Core.Enums
@using Economy.Panel.UI.Models.AppViewModels
@model AppCreateViewModel

@{
    ViewData["Title"] = "Uygulama Oluştur";
}
<main>
    <div class="container-fluid">
        @await Html.PartialAsync("_breadcrumbs")

        <!-- tables start  -->
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                            </div>
                            <div>
                                <div class="app-btn-list">
                                    <a class="btn btn-primary" asp-action="CreateApp">Yeni Ekle</a>
                                    <a class="btn btn-info" asp-action="AppList">Tüm Kayıtlar</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Hoverable Table start -->
            <div class="col-xl-12">
                <div class="card">
                    <div class="card-header">
                        <p>
                            Aşağıda formu doldurarak bir uygulama oluşturabilirsiniz.
                        </p>
                    </div>
                    <div class="card-body">
                        <div class="row p-2">
                            <div class="col-md-6 offset-md-3">

                                <form asp-action="CreateApp" method="post" class="needs-validation" novalidate>
                                    <div class="row">
                                        <div class="form-group col-md-6 mb-3">
                                            <label asp-for="HotelName"></label>
                                            <input asp-for="HotelName" class="form-control" />
                                            <span asp-validation-for="HotelName" class="text-danger"></span>
                                        </div>

                                        <div class="form-group col-md-6 mb-3">
                                            <label asp-for="ServerName"></label>
                                            <input asp-for="ServerName" class="form-control" />
                                            <span asp-validation-for="ServerName" class="text-danger"></span>
                                        </div>

                                        <div class="form-group col-md-6 mb-3">
                                            <label asp-for="DatabaseName"></label>
                                            <input asp-for="DatabaseName" class="form-control" />
                                            <span asp-validation-for="DatabaseName" class="text-danger"></span>
                                        </div>

                                       

                                        <div class="form-group col-md-6 mb-3">
                                            <div class="form-check mt-4">
                                                <input asp-for="IsPassword" class="form-check-input" id="isPasswordCheck" />
                                                <label asp-for="IsPassword" class="form-check-label"></label>
                                            </div>
                                        </div>
                                        <div id="passwordContainer">
                                            <div class="form-group col-md-6 mb-3">
                                                <label asp-for="UserName"></label>
                                                <input asp-for="UserName" class="form-control" />
                                                <span asp-validation-for="UserName" class="text-danger"></span>
                                            </div>
                                            <div class="form-group col-md-6 mb-3">
                                                <label asp-for="Password"></label>
                                                <input asp-for="Password" type="password" class="form-control" />
                                                <span asp-validation-for="Password" class="text-danger"></span>
                                            </div>

                                        </div>
                                     
                                        <div class="form-group col-md-12 mb-3">
                                            <label asp-for="Domain"></label>
                                            <input asp-for="Domain" class="form-control" />
                                            <span asp-validation-for="Domain" class="text-danger"></span>
                                        </div>

                                        <!-- Yeni eklenen alanlar -->
                                        <div class="form-group col-md-6 mb-3">
                                            <label asp-for="AccessMode"></label>
                                            <select asp-for="AccessMode" class="form-select"
                                                    asp-items="Html.GetEnumSelectList<AppAccessMode>()">
                                            </select>
                                            <span asp-validation-for="AccessMode" class="text-danger"></span>
                                        </div>

                                        <div class="form-group col-md-6 mb-3">
                                            <label asp-for="Theme"></label>
                                            <select asp-for="Theme" class="form-select"
                                                    asp-items="Html.GetEnumSelectList<AppTheme>()">
                                            </select>
                                            <span asp-validation-for="Theme" class="text-danger"></span>
                                        </div>

                                        <div class="form-group col-md-12 mb-3">
                                            <label asp-for="ApiKey"></label>
                                            <input asp-for="ApiKey" class="form-control" readonly />
                                            <span asp-validation-for="ApiKey" class="text-danger"></span>
                                        </div>

                                    </div>

                                    <button type="submit" class="btn btn-primary mt-3 float-end">Oluştur</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const isPasswordCheckbox = document.getElementById('isPasswordCheck');
        const passwordInput = document.querySelector('input[name="Password"]');
        const passwordContainer = document.getElementById('passwordContainer');

        function togglePassword() {
            const showPassword = isPasswordCheckbox.checked;
            passwordContainer.style.display = showPassword ? 'block' : 'none';

            if (showPassword) {
                passwordInput.setAttribute('required', 'required');
            } else {
                passwordInput.removeAttribute('required');
                passwordInput.value = '';
            }
        }

        togglePassword();
        isPasswordCheckbox.addEventListener('change', togglePassword);
    </script>
}
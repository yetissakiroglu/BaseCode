@using Economy.Base.Application.Dtos.BaseModels
@model IEnumerable<AppUserListDto>

@{
    ViewData["Title"] = "Kullanıcı Listesi";
}

<main>
    <div class="container-fluid">
        <!-- Breadcrumb start -->
        <div class="row m-1">
            <div class="col-12 ">
                <h4 class="main-title">@ViewData["Title"] </h4>
                <ul class="app-line-breadcrumbs mb-3">
                    <li class="">
                        <a class="f-s-14 f-w-500" href="#">
                            <span>
                                <i class="ph-duotone  ph-table f-s-16"></i> Anasayfa
                            </span>
                        </a>
                    </li>
                    <li class="active">
                        <a class="f-s-14 f-w-500" href="#">@ViewData["Title"]</a>
                    </li>
                </ul>
            </div>
        </div>

        <!-- Breadcrumb end -->
        <!-- tables start  -->
        <div class="row table-section">

            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                            </div>
                            <div>
                                <div class="app-btn-list">
                                    <a class="btn btn-primary" asp-action="CreateUser">Yeni Ekle</a>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
            <!-- Hoverable Table start -->
            <div class="col-xl-12">
                <div class="card">
                    <div class="card-header">
                        <h5> Kayıtlar </h5>
                        <p>
                            Aşağıda kayıtlı bilgiler bulunmaktadır.
                        </p>
                    </div>
                    <div class="card-body">


                        <table class="table">
                            <thead>
                                <tr>
                                    <th>
                                        @Html.DisplayNameFor(model => model.Id)
                                    </th>
                                    <th>
                                        @Html.DisplayNameFor(model => model.FirstName)
                                    </th>
                                    <th>
                                        @Html.DisplayNameFor(model => model.LastName)
                                    </th>
                                    <th>
                                        @Html.DisplayNameFor(model => model.TenantName)
                                    </th>
                                    <th>
                                        @Html.DisplayNameFor(model => model.UserName)
                                    </th>
                                   
                                    <th>
                                        @Html.DisplayNameFor(model => model.EmailConfirmed)
                                    </th>
                                    <th>
                                        @Html.DisplayNameFor(model => model.PhoneNumberConfirmed)
                                    </th>
                                    <th>
                                        @Html.DisplayNameFor(model => model.IsDefaultAdmin)
                                    </th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Id)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.FirstName)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.LastName)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.TenantName)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.UserName)
                                        </td>
                                     
                                        <td>
                                            @item.EmailConfirmed.ToTurkishYesNo()
                                        </td>
                                        <td>
                                            @item.PhoneNumberConfirmed.ToTurkishYesNo()
                                        </td>
                                        <td>
                                            @item.IsDefaultAdmin.ToTurkishYesNo()
                                        </td>
                                        <td>
                                            @Html.ActionLink("Güncelle", "EditUser", new { id=item.Id }) |
                                            @Html.ActionLink("İncele", "DetailsUser", new { id = item.Id }) 
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                    </div>
                </div>
            </div>
            <!-- Hoverable Table end -->


        </div>
        <!-- tables-end  -->
    </div>
</main>



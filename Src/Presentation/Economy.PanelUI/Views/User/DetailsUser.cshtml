@model Economy.Base.Application.Dtos.BaseModels.AppUserDto

@{
    ViewData["Title"] = "Kullanıcı Detayı";
}

<main>
    <div class="container-fluid">
        <!-- Başlık & Breadcrumb -->
        @await Html.PartialAsync("_breadcrumbs")

        <!-- Üst Butonlar -->
        <div class="row mb-2">
            <div class="col-12 text-end">
                <form id="antiForgeryForm">@Html.AntiForgeryToken()</form>
                <div class="app-btn-list">
                    <button id="deleteBtn" class="btn btn-danger">Sil</button>
                    <a asp-action="EditUser" asp-route-id="@Model.Id" class="btn btn-primary">Güncelle</a>
                    <a asp-action="UserList" class="btn btn-info">Tüm Kayıtlar</a>
                </div>
            </div>
        </div>

        <!-- Kullanıcı Bilgileri -->
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h5>Kullanıcı Bilgileri</h5>
                        <p>Aşağıda kullanıcıya ait detaylı bilgiler yer almaktadır.</p>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-xl-6 offset-xl-3">
                                <dl class="row">
                                    <dt class="col-sm-3">Ad</dt>
                                    <dd class="col-sm-9">@Model.FirstName</dd>

                                    <dt class="col-sm-3">Soyad</dt>
                                    <dd class="col-sm-9">@Model.LastName</dd>

                                    <dt class="col-sm-3">Kullanıcı Adı</dt>
                                    <dd class="col-sm-9">@Model.UserName</dd>

                                    <dt class="col-sm-3">E-posta</dt>
                                    <dd class="col-sm-9">@Model.Email</dd>

                                    <dt class="col-sm-3">Telefon</dt>
                                    <dd class="col-sm-9">@Model.PhoneNumber</dd>

                                    <dt class="col-sm-3">E-posta Onayı</dt>
                                    <dd class="col-sm-9">@Model.EmailConfirmed.ToTurkishYesNo()</dd>

                                    <dt class="col-sm-3">Telefon Onayı</dt>
                                    <dd class="col-sm-9">@Model.PhoneNumberConfirmed.ToTurkishYesNo()</dd>

                                    <dt class="col-sm-3">İki Faktörlü Giriş</dt>
                                    <dd class="col-sm-9">@Model.TwoFactorEnabled.ToTurkishYesNo()</dd>

                                    <dt class="col-sm-3">Kilit Durumu</dt>
                                    <dd class="col-sm-9">
                                        @if (Model.LockoutEnabled)
                                        {
                                            <text>@Model.LockoutEnd?.ToString("g")</text>
                                        }
                                        else
                                        {
                                            <text>Kapalı</text>
                                        }
                                    </dd>

                                    <dt class="col-sm-3">Başarısız Giriş Sayısı</dt>
                                    <dd class="col-sm-9">@Model.AccessFailedCount</dd>

                                    <dt class="col-sm-3">Varsayılan Admin</dt>
                                    <dd class="col-sm-9">@Model.IsDefaultAdmin.ToTurkishYesNo()</dd>

                                    <dt class="col-sm-3">Silinmiş mi?</dt>
                                    <dd class="col-sm-9">@Model.IsDeleted.ToTurkishYesNo()</dd>
                                </dl>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <script>
        $('#deleteBtn').click(function () {
            postResponseModelDelete('@Url.Action("DeleteUser", "User")', { id: @Model.Id });
        });
    </script>
}

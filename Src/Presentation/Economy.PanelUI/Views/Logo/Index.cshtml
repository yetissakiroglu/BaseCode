@model Economy.Panel.UI.Models.SettingLogoViewModels.AppSettingLogoCreateEditViewModel

@{
    ViewData["Title"] = "Index";
}








<h2>Resim Seç ve Kırp</h2>
<input type="file" id="fileInput" accept="image/*" />
<br>
<br>
<img id="image" />

<br>
<button id="cropButton">Kırp</button>

<h3>Kırpılmış Sonuç:</h3>
<img id="croppedResult" />

<!-- Cropper.js JS -->
<script src="https://unpkg.com/cropperjs/dist/cropper.min.js"></script>

<script>
    let cropper;
    const image = document.getElementById('image');
    const fileInput = document.getElementById('fileInput');
    const croppedResult = document.getElementById('croppedResult');
    const cropButton = document.getElementById('cropButton');

    fileInput.addEventListener('change', function (e) {
        const file = e.target.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = function (event) {
                image.src = event.target.result;

                // Önceki cropper varsa kaldır
                if (cropper) cropper.destroy();

                // Yeni cropper başlat
                cropper = new Cropper(image, {
                    aspectRatio: 1, // Kare kırpma
                    viewMode: 1
                });
            };
            reader.readAsDataURL(file);
        }
    });

    cropButton.addEventListener('click', function () {
        if (!cropper) {
            alert("Önce bir resim seçin!");
            return;
        }

        const canvas = cropper.getCroppedCanvas({
            width: 300,
            height: 300
        });

        // Kırpılan resmi göster
        croppedResult.src = canvas.toDataURL('image/png');
    });
</script>







<h1>Index</h1>

<h4>AppSettingLogoCreateEditViewModel</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Index">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Id" class="control-label"></label>
                <input asp-for="Id" class="form-control" />
                <span asp-validation-for="Id" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="LogoPath" class="control-label"></label>
                <input asp-for="LogoPath" class="form-control" />
                <span asp-validation-for="LogoPath" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="MobileLogoPath" class="control-label"></label>
                <input asp-for="MobileLogoPath" class="form-control" />
                <span asp-validation-for="MobileLogoPath" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="FaviconPath" class="control-label"></label>
                <input asp-for="FaviconPath" class="form-control" />
                <span asp-validation-for="FaviconPath" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>


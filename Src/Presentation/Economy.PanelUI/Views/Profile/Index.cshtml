@using Economy.Panel.UI.Models.ProfileViewModels
@model UserProfileViewModel

@{
    ViewData["Title"] = "Profil";
}
<main>
    <div class="container-fluid">
        @await Html.PartialAsync("_breadcrumbs")

        <div class="row">
            <div class="col-lg-12 col-xxl-12 col-box-4 order-lg--1">
                <div class="card">
                    <div class="card-body">
                        <div class="profile-container">
                            <div class="image-details">
                                <div class="profile-image"></div>
                                <div class="profile-pic">
                                    <div class="avatar-upload">
                                        <div class="avatar-edit">
                                            <input accept=".png, .jpg, .jpeg" id="imageUpload" type="file">
                                            <label for="imageUpload"><i class="ti ti-photo-heart"></i></label>
                                        </div>
                                        <div class="avatar-preview">
                                            <div id="imgPreview">
                                                <img src="@Model.PhotoUrl" class="rounded-circle" width="100" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="person-details">
                                <h5 class="f-w-600">
                                    @Model.FullName
                                    <img alt="instagram-check-mark" class="w-20 h-20" src="../assets/images/profile-app/01.png">
                                </h5>
                                <p>@Model.JobTitle </p>
                            </div>
                        </div>

                        <div class="about-list mt-4">
                            <div>
                                <span class="fw-medium"><i class="ti ti-briefcase"></i> Yetki </span>
                                <span class="float-end f-s-13 text-secondary">
                                    @foreach (var item in Model.Roles)
                                    {
                                        <text>@item</text>
                                    }
                                </span>
                            </div>
                            <div>
                                <span class="fw-medium"><i class="ti ti-mail"></i> E-Posta </span>
                                <span class="float-end f-s-13 text-secondary">@Model.Email</span>
                            </div>
                            <div>
                                <span class="fw-medium"><i class="ti ti-phone"></i> Telefon </span>
                                <span class="float-end f-s-13 text-secondary">@Model.Phone</span>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>
@using Economy.Panel.UI.Models.SecuritySettingsPageViewModels
@model SecuritySettingsPageViewModel
@{
    ViewData["Title"] = "Güvenlik Ayarları";
}

<h3 class="mb-3">Güvenlik Ayarları</h3>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<form asp-action="Security" asp-controller="Settings" method="post" class="card card-body">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div class="row g-4">
        <div class="col-12">
            <h6 class="border-bottom pb-2">Parola Politikası</h6>
        </div>

        <div class="col-md-4">
            <label asp-for="PasswordRequiredLength" class="form-label"></label>
            <input asp-for="PasswordRequiredLength" type="number" class="form-control" min="4" max="128" />
            <span asp-validation-for="PasswordRequiredLength" class="text-danger"></span>
        </div>

        <div class="col-md-8 d-flex flex-wrap align-items-end gap-4">
            <div class="form-check">
                <input asp-for="PasswordRequireDigit" class="form-check-input" />
                <label asp-for="PasswordRequireDigit" class="form-check-label"></label>
            </div>
            <div class="form-check">
                <input asp-for="PasswordRequireLowercase" class="form-check-input" />
                <label asp-for="PasswordRequireLowercase" class="form-check-label"></label>
            </div>
            <div class="form-check">
                <input asp-for="PasswordRequireUppercase" class="form-check-input" />
                <label asp-for="PasswordRequireUppercase" class="form-check-label"></label>
            </div>
            <div class="form-check">
                <input asp-for="PasswordRequireNonAlphanumeric" class="form-check-input" />
                <label asp-for="PasswordRequireNonAlphanumeric" class="form-check-label"></label>
            </div>
        </div>

        <div class="col-12 mt-3">
            <h6 class="border-bottom pb-2">Hesap Kilitleme (Lockout)</h6>
        </div>

        <div class="col-md-4">
            <label asp-for="LockoutTimeSpanMinutes" class="form-label"></label>
            <input asp-for="LockoutTimeSpanMinutes" type="number" class="form-control" min="1" max="1440" />
            <span asp-validation-for="LockoutTimeSpanMinutes" class="text-danger"></span>
        </div>

        <div class="col-md-4">
            <label asp-for="LockoutMaxFailedAccessAttempts" class="form-label"></label>
            <input asp-for="LockoutMaxFailedAccessAttempts" type="number" class="form-control" min="1" max="20" />
            <span asp-validation-for="LockoutMaxFailedAccessAttempts" class="text-danger"></span>
        </div>

        <div class="col-md-4 d-flex align-items-end">
            <div class="form-check">
                <input asp-for="LockoutAllowedForNewUsers" class="form-check-input" />
                <label asp-for="LockoutAllowedForNewUsers" class="form-check-label"></label>
            </div>
        </div>

        <div class="col-12 mt-3">
            <h6 class="border-bottom pb-2">Giriş Doğrulama</h6>
        </div>

        <div class="col-md-6">
            <div class="form-check">
                <input asp-for="SignInRequireConfirmedEmail" class="form-check-input" />
                <label asp-for="SignInRequireConfirmedEmail" class="form-check-label"></label>
            </div>
            <div class="form-check mt-2">
                <input asp-for="SignInRequireConfirmedPhoneNumber" class="form-check-input" />
                <label asp-for="SignInRequireConfirmedPhoneNumber" class="form-check-label"></label>
            </div>
        </div>

        <div class="col-md-6">
            <div class="form-check">
                <input asp-for="TwoFactorRequired" class="form-check-input" />
                <label asp-for="TwoFactorRequired" class="form-check-label"></label>
            </div>
            <div class="form-text mt-1">
                Açık ise tüm kullanıcılar için 2FA zorunlu tutulur (uygulama tarafında kontrol etmen gerekir).
            </div>
        </div>
    </div>

    <div class="d-flex gap-2 mt-4">
        <button type="submit" class="btn btn-primary">Kaydet</button>
        <a href="/Settings/General" class="btn btn-outline-secondary">Genel Ayarlar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

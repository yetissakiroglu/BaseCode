@model Economy.Panel.UI.Models.SlideViewModels.AppSlideViewModel

@{
    ViewData["Title"] = "Slide Detay";
}

<main>
    <div class="container-fluid">
        @await Html.PartialAsync("_breadcrumbs")
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                            </div>
                            <div>
                                <form id="antiForgeryForm">
                                    @Html.AntiForgeryToken()
                                </form>
                                <div class="app-btn-list">
                                    <button id="deleteBtn" class="btn btn-danger">Sil</button>
                                    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Güncelleme</a>
                                    <a class="btn btn-primary" asp-action="Index">Tüm Kayıtlar</a>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
            <div class="col-xl-12">
                <div class="card">
                    <div class="card-header">
                        <h5> Kayıtlar </h5>
                        <p>
                            Aşağıda kayıtlı bilgiler bulunmaktadır.
                        </p>
                    </div>
                    <div class="card-body">

                        <div class="row p-2">
                            <div class="col-md-6 offset-md-3">
                                <dl class="row">
                                    <dt class="col-sm-2">
                                        @Html.DisplayNameFor(model => model.Id)
                                    </dt>
                                    <dd class="col-sm-10">
                                        @Html.DisplayFor(model => model.Id)
                                    </dd>
                                    <dt class="col-sm-2">
                                        @Html.DisplayNameFor(model => model.Sequence)
                                    </dt>
                                    <dd class="col-sm-10">
                                        @Html.DisplayFor(model => model.Sequence)
                                    </dd>
                                    <dt class="col-sm-2">
                                        @Html.DisplayNameFor(model => model.WebImageFile)
                                    </dt>
                                    <dd class="col-sm-10">
                                        <img width="100" src="@Html.DisplayFor(model => model.WebImageFile)" />
                                    </dd>
                                    <dt class="col-sm-2">
                                        @Html.DisplayNameFor(model => model.MobilImageFile)
                                    </dt>
                                    <dd class="col-sm-10">
                                        <img width="100" src="@Html.DisplayFor(model => model.MobilImageFile)" />
                                        
                                    </dd>
                                </dl>

                            </div>
                        </div>




                    </div>
                </div>
            </div>
        </div>
    </div>
</main>


@section Scripts {
    <script>
        $('#deleteBtn').click(function () {
            postResponseModelDelete('@Url.Action("Delete", "Slide")',{ id: @Model.Id })
        });
    </script>
}


@model Economy.Panel.UI.Models.SlideViewModels.AppSlideCreateEditViewModel

@{
    ViewData["Title"] = "Slide Ekle";
}

<!-- ✅ Cropper.js CSS -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css" rel="stylesheet" />

<main>
    <div class="container-fluid">
        @await Html.PartialAsync("_breadcrumbs")
        <div class="row m-1">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                            </div>
                            <div>
                                <div class="app-btn-list">
                                    <a class="btn btn-primary" asp-action="Index">Tüm Kayıtlar</a>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-12">
                <form asp-action="Create" method="post" class="app-form rounded-control needs-validation" novalidate>
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />

                    <div class="card equal-card">
                        <div class="card-header">
                            <h5>Slider Çevirileri</h5>
                            <p>Her dil için çevirileri aşağıdan düzenleyebilirsiniz.</p>
                        </div>
                        <div class="card-body">
                            <ul class="nav nav-tabs tab-light-secondary" role="tablist">
                                @for (int i = 0; i < Model.Translations.Count; i++)
                                {
                                    var t = Model.Translations[i];
                                    var isActive = i == 0 ? "active" : "";
                                    <li class="nav-item" role="presentation">
                                        <button class="nav-link gap-2 @isActive"
                                                id="lang-tab-@i"
                                                data-bs-toggle="tab"
                                                data-bs-target="#lang-tab-pane-@i"
                                                type="button"
                                                role="tab"
                                                aria-selected="@(i == 0 ? "true" : "false")">
                                            <i class="@t.LanguageIcon?.ToLower()"></i> @t.LanguageName
                                        </button>
                                    </li>
                                }
                            </ul>

                            <div class="tab-content">

                                <!-- MASAÜSTÜ LOGO -->
                                <section class="py-4 px-3 bg-white rounded-4 shadow-sm mb-5 border">

                                    <h4 class="fw-bold text-primary mb-4 border-bottom pb-2">🖥️ Masaüstü Logo</h4>

                                    <div class="row g-4 align-items-start">

                                        <!-- Mevcut Logo -->
                                        <div class="col-md-2 text-center">
                                            <div class="border rounded-3 p-3 shadow-sm h-100">
                                                <p class="fw-semibold text-secondary mb-2">Sistemdeki Logo</p>
                                                <img src="@Model.WebImageFile" class="img-fluid rounded" style="max-height: 150px;" alt="Mevcut Logo" />
                                            </div>
                                        </div>

                                        <!-- Yeni Logo Yükle -->
                                        <div class="col-md-8 text-center">
                                            <div class="border rounded-3 p-3 shadow-sm h-100">
                                                <p class="fw-semibold text-secondary mb-2 fs-5">Yeni Logo Yükle</p>
                                                <input type="file" class="form-control mb-3" id="logoInput" accept="image/*" />
                                                <img id="logoPreview" class="img-fluid rounded border shadow-sm mb-3"
                                                     style="max-height: 100px;" src="@(Model.WebImageFile ?? "/images/onizleme.jpg")" alt="Logo Önizleme" />
                                                <button type="button" id="cropLogoBtn" class="btn btn-outline-primary px-4 shadow-sm">Kırp</button>
                                            </div>
                                        </div>

                                        <!-- Kırpılmış Görsel -->
                                        <div class="col-md-2 text-center">
                                            <div class="border rounded-3 p-3 shadow-sm h-100">
                                                <p class="fw-semibold text-secondary mb-2">Kırpılmış Görsel</p>
                                                <img id="croppedLogoResult" class="img-fluid rounded border border-primary shadow"
                                                     style="max-height: 150px;" alt="Kırpılmış Logo"
                                                     src="@(Model.WebImageFile ?? "/images/onizleme.jpg")" />
                                                <input type="hidden" name="ThumbnailBase64" id="ThumbnailBase64" value="@Model.WebImageFile" />
                                            </div>
                                        </div>
                                    </div>
                                </section>

                                <hr class="my-5" />

                                <!-- MOBİL LOGO -->
                                <section class="py-4 px-3 bg-white rounded-4 shadow-sm mb-5 border">

                                    <h4 class="fw-bold text-primary mb-4 border-bottom pb-2">📱 Mobil Logo</h4>

                                    <div class="row g-4 align-items-start">

                                        <!-- Mevcut Mobil Logo -->
                                        <div class="col-md-2 text-center">
                                            <div class="border rounded-3 p-3 shadow-sm h-100">
                                                <p class="fw-semibold text-secondary mb-2">Sistemdeki Mobil Logo</p>
                                                <img src="@Model.MobileImageFile" class="img-fluid rounded" style="max-height: 150px;" alt="Mevcut Mobil Logo" />
                                            </div>
                                        </div>

                                        <!-- Yeni Mobil Logo Yükle -->
                                        <div class="col-md-8 text-center">
                                            <div class="border rounded-3 p-3 shadow-sm h-100">
                                                <p class="fw-semibold text-secondary mb-2 fs-5">Yeni Mobil Logo Yükle</p>
                                                <input class="form-control mb-3" type="file" id="mobileLogoInput" accept="image/*" />
                                                <img id="mobileLogoPreview" class="img-fluid rounded border shadow-sm mb-3"
                                                     style="max-height: 100px;" src="@(Model.MobileImageFile ?? "/images/onizleme.jpg")" alt="Mobil Logo Önizleme" />
                                                <button type="button" id="cropMobileLogoBtn" class="btn btn-outline-primary px-4 shadow-sm">Kırp</button>
                                            </div>
                                        </div>

                                        <!-- Kırpılmış Mobil Görsel -->
                                        <div class="col-md-2 text-center">
                                            <div class="border rounded-3 p-3 shadow-sm h-100">
                                                <p class="fw-semibold text-secondary mb-2">Kırpılmış Mobil Görsel</p>
                                                <img id="croppedMobileLogoResult" class="img-fluid rounded border border-primary shadow"
                                                     style="max-height: 150px;" alt="Kırpılmış Mobil Logo"
                                                     src="@(Model.MobileImageFile ?? "/images/onizleme.jpg")" />
                                                <input type="hidden" name="ThumbnailMobilBase64" id="ThumbnailMobilBase64" value="@Model.MobileImageFile" />
                                            </div>
                                        </div>

                                    </div>
                                </section>



                                @for (int i = 0; i < Model.Translations.Count; i++)
                                {
                                    var t = Model.Translations[i];
                                    var isActive = i == 0 ? "show active" : "";
                                    <div class="tab-pane fade @isActive" id="lang-tab-pane-@i" role="tabpanel" aria-labelledby="lang-tab-@i">
                                        <input type="hidden" name="Translations[@i].Id" value="@t.Id" />
                                        <input type="hidden" name="Translations[@i].AppLanguageId" value="@t.AppLanguageId" />
                                        <input type="hidden" name="Translations[@i].LanguageName" value="@t.LanguageName" />
                                        <input type="hidden" name="Translations[@i].LanguageIcon" value="@t.LanguageIcon" />
                                        <input type="hidden" name="Translations[@i].AppSlideId" value="@t.AppSlideId" />


                                        <div class="form-group mb-3">
                                            <label>Başlık</label>
                                            <input class="form-control" name="Translations[@i].Title" value="@t.Title" />
                                            <span asp-validation-for="Translations[@i].Title" class="text-danger"></span>
                                        </div>

                                        <div class="form-group mb-3">
                                            <label>İçerik</label>
                                            <textarea class="form-control" name="Translations[@i].Content">@t.Content</textarea>
                                            <span asp-validation-for="Translations[@i].Content" class="text-danger"></span>

                                        </div>

                                        <div class="form-group mb-3">
                                            <label>Buton Metni</label>
                                            <input class="form-control" name="Translations[@i].ButtonText" value="@t.ButtonText" />
                                            <span asp-validation-for="Translations[@i].ButtonText" class="text-danger"></span>
                                        </div>

                                        <div class="form-group mb-3">
                                            <label>Buton URL</label>
                                            <input class="form-control" name="Translations[@i].ButtonUrl" value="@t.ButtonUrl" />
                                            <span asp-validation-for="Translations[@i].ButtonUrl" class="text-danger"></span>
                                        </div>

                                        <div class="form-group mb-3">
                                            <label>Buton İkon</label>
                                            <input class="form-control" name="Translations[@i].ButtonIcon" value="@t.ButtonIcon" />
                                            <span asp-validation-for="Translations[@i].ButtonIcon" class="text-danger"></span>
                                        </div>

                                        <div class="form-check form-switch mb-3">
                                            <input class="form-check-input" type="checkbox" name="Translations[@i].IsExternal" value="true" @(t.IsExternal ? "checked" : "") />
                                            <label class="form-check-label">Harici Bağlantı mı?</label>
                                        </div>


                                    </div>
                                }

                                <div class="form-group mb-3">
                                    <label asp-for="Sequence" class="control-label"></label>
                                    <input asp-for="Sequence" class="form-control" />
                                    <span asp-validation-for="Sequence" class="text-danger"></span>
                                </div>

                            </div>

                            <hr />
                            <div class="mt-3 text-end">
                                <button type="submit" class="btn btn-success">Kaydet</button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <!-- ✅ Cropper.js JavaScript -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>

    <script>
        let cropperLogo,cropperMobile;
        
        // , cropperMobile, cropperFavicon;

        function handleCropper(inputId, imgId, cropperRef, width, height) {
            const input = document.getElementById(inputId);
            const image = document.getElementById(imgId);
            input.addEventListener('change', function () {
                const file = input.files[0];
                if (!file) return;
                const reader = new FileReader();
                reader.onload = function (e) {
                    image.src = e.target.result;

                    // Cropper varsa temizle
                    if (cropperRef.obj) cropperRef.obj.destroy();

                    // Yeni cropper oluştur, kırpma kutusu sabit
                    cropperRef.obj = new Cropper(image, {
                        aspectRatio: width / height,
                        viewMode: 1,
                        dragMode: 'move',
                        cropBoxResizable: false,
                        cropBoxMovable: false,
                        toggleDragModeOnDblclick: false
                    });
                };
                reader.readAsDataURL(file);
            });
        }

        function cropAndSet(cropper, targetImgId, hiddenInputId, width, height) {
            if (!cropper) return alert('Cropper henüz hazır değil!');
            const canvas = cropper.getCroppedCanvas({ width, height });
            const base64 = canvas.toDataURL("image/png");
            document.getElementById(targetImgId).src = base64;
            document.getElementById(hiddenInputId).value = base64;
        }

        // Initialize croppers
        cropperLogo = { obj: null };
        cropperMobile = { obj: null };

        handleCropper('logoInput', 'logoPreview', cropperLogo, 300, 300);
        handleCropper('mobileLogoInput', 'mobileLogoPreview', cropperMobile, 200, 100);

        // Crop buttons
        document.getElementById('cropLogoBtn').addEventListener('click', () =>
            cropAndSet(cropperLogo.obj, 'croppedLogoResult', 'ThumbnailBase64', 300, 300));

        document.getElementById('cropMobileLogoBtn').addEventListener('click', () =>
            cropAndSet(cropperMobile.obj, 'croppedMobileLogoResult', 'ThumbnailMobilBase64', 200, 100));

     
    </script>

}

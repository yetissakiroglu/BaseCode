@model List<string>
@{
    var namePrefix = (ViewData["NamePrefix"] as string) ?? "ImageUrls";
    var formId = (ViewData["FormId"] as string) ?? "mainForm";
    var pickerUrl = (ViewData["PickerUrl"] as string) ?? "/Tenant/ImageManager/Picker";
    var containerId = "imglist_" + Guid.NewGuid().ToString("N");
}

<div id="@containerId"
     class="imgpick mt-3"
     data-name-prefix="@namePrefix">
    <label class="form-label fw-semibold mb-2">Görsel Listesi</label>

    <div class="row g-3" id="rows-@containerId">
        @for (int i = 0; i < (Model?.Count ?? 0); i++)
        {
            var url = Model[i] ?? "";
            <div class="col-12 col-md-6 col-xl-4 gal-row">
                <div class="card shadow-sm border-0">
                    <div class="card-body p-2">
                        <div class="position-relative rounded-3 overflow-hidden border bg-light mb-2 preview-wrap">
                            <div class="checkerboard"></div>
                            <div class="ratio ratio-16x9">
                                <img src="@url"
                                     alt="Görsel önizleme"
                                     class="img-fluid w-100 h-100 object-fit-cover preview-img @(string.IsNullOrWhiteSpace(url) ? "d-none" : null)">
                                <div class="d-flex flex-column align-items-center justify-content-center text-muted gap-1 placeholder-wrap @(string.IsNullOrWhiteSpace(url) ? null : "d-none")">
                                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
                                        <path d="M4 5h16v14H4z" stroke="currentColor" stroke-width="1.25" />
                                        <path d="M4 15l4-4 4 4 4-5 4 5" stroke="currentColor" stroke-width="1.25" />
                                        <circle cx="9" cy="8" r="1" fill="currentColor" />
                                    </svg>
                                    <small>Seçilmedi</small>
                                </div>
                            </div>
                            <div class="overlay-actions d-flex gap-2">
                                <button type="button" class="btn btn-dark btn-xs pick-btn">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" class="me-1">
                                        <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.8" />
                                    </svg> Değiştir
                                </button>
                                <a href="@url" target="_blank" class="btn btn-outline-light btn-xs open-btn">Aç</a>
                            </div>
                        </div>

                        <div class="input-group input-group-sm">
                            <input class="form-control url-input"
                                   name="@($"{namePrefix}[{i}]")"
                                   value="@url"
                                   placeholder="https://...">
                            <button class="btn btn-outline-danger btn-sm remove-row" type="button">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" class="me-1">
                                    <path d="M19 6L5 20M5 6l14 14" stroke="currentColor" stroke-width="1.7" />
                                </svg> Sil
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="mt-3 text-center">
        <button type="button" class="btn btn-sm btn-outline-primary btn-add">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" class="me-1">
                <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.8" />
            </svg> Yeni Görsel Ekle
        </button>
        <button type="button" class="btn btn-sm btn-secondary btn-pick-gallery" data-editor="@containerId">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" class="me-1">
                <path d="M4 5h16v14H4z" stroke="currentColor" stroke-width="1.5" />
                <path d="M4 15l4-4 4 4 4-5 4 5" stroke="currentColor" stroke-width="1.5" />
            </svg> Dosya Seç
        </button>
    </div>
</div>

<style>
    .imgpick .object-fit-cover {
        object-fit: cover
    }

    .ratio-16x9 {
        aspect-ratio: 16/9
    }

    .imgpick .preview-wrap {
        transition: box-shadow .2s ease
    }

        .imgpick .preview-wrap:hover {
            box-shadow: 0 .125rem .5rem rgba(0,0,0,.12)
        }

    .imgpick .checkerboard {
        position: absolute;
        inset: 0;
        background: conic-gradient(#eee 25%, #fff 0 50%, #eee 0 75%, #fff 0) 0/16px 16px;
        opacity: .6;
    }

    .imgpick .overlay-actions {
        position: absolute;
        inset: auto 0 0 0;
        display: flex;
        justify-content: center;
        padding: .4rem;
        background: linear-gradient(180deg, rgba(0,0,0,0) 0%, rgba(0,0,0,.45) 100%);
        opacity: 0;
        transition: opacity .2s ease;
    }

    .imgpick .preview-wrap:hover .overlay-actions {
        opacity: 1
    }

    .btn-xs {
        padding: .15rem .4rem;
        font-size: .75rem;
        line-height: 1.1;
        border-radius: .25rem
    }
</style>

<script>
    (function () {
        const id        = "@containerId";
        const pickerUrl = "@pickerUrl";
        const formId    = "@formId";

        const root = document.getElementById(id);
        if (!root) return;

        const rowsEl         = root.querySelector("#rows-" + id);
        const addBtn         = root.querySelector(".btn-add");
        const pickGalleryBtn = root.querySelector(".btn-pick-gallery");

        // Her partial kendi namePrefix'ini DOM'dan alıyor
        function getNamePrefix() {
            return root.getAttribute("data-name-prefix") || "@namePrefix";
        }

        // -------- Helpers --------
        function setUrl(input, img, ph, openA, val) {
            val = (val || "").trim();
            input.value = val;
            const has = !!val;
            if (img)   { img.src = val; img.classList.toggle("d-none", !has); }
            if (ph)    { ph.classList.toggle("d-none", has); }
            if (openA) { openA.href = has ? val : "#"; }
        }

        function bindRowEvents(row) {
            const input = row.querySelector(".url-input");
            const img   = row.querySelector(".preview-img");
            const ph    = row.querySelector(".placeholder-wrap");
            const openA = row.querySelector(".open-btn");
            const pick  = row.querySelector(".pick-btn");
            const del   = row.querySelector(".remove-row");

            if (input) {
                input.addEventListener("input", () => setUrl(input, img, ph, openA, input.value));
            }
            if (pick) pick.addEventListener("click", () => openPicker(row));
            if (del)  del.addEventListener("click", () => row.remove());
        }

        function createRow(url, idx) {
            const np = getNamePrefix();

            const col = document.createElement("div");
            col.className = "col-12 col-md-6 col-xl-4 gal-row";
            col.innerHTML = `
            <div class="card shadow-sm border-0">
              <div class="card-body p-2">
                <div class="position-relative rounded-3 overflow-hidden border bg-light mb-2 preview-wrap">
                  <div class="checkerboard"></div>
                  <div class="ratio ratio-16x9">
                    <img src="${url || ""}" class="img-fluid w-100 h-100 object-fit-cover preview-img ${url ? "" : "d-none"}">
                    <div class="d-flex flex-column align-items-center justify-content-center text-muted gap-1 placeholder-wrap ${url ? "d-none" : ""}">
                      <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
                        <path d="M4 5h16v14H4z" stroke="currentColor" stroke-width="1.25" />
                        <path d="M4 15l4-4 4 4 4-5 4 5" stroke="currentColor" stroke-width="1.25" />
                        <circle cx="9" cy="8" r="1" fill="currentColor" />
                      </svg>
                      <small>Seçilmedi</small>
                    </div>
                  </div>
                  <div class="overlay-actions d-flex gap-2">
                    <button type="button" class="btn btn-dark btn-xs pick-btn">
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" class="me-1">
                        <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.8" />
                      </svg> Değiştir
                    </button>
                    <a href="${url || "#"}" target="_blank" class="btn btn-outline-light btn-xs open-btn">Aç</a>
                  </div>
                </div>
                <div class="input-group input-group-sm">
                  <input class="form-control url-input"
                         name="${np}[${idx}]"
                         value="${url || ""}"
                         placeholder="https://...">
                  <button class="btn btn-outline-danger btn-sm remove-row" type="button">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" class="me-1">
                      <path d="M19 6L5 20M5 6l14 14" stroke="currentColor" stroke-width="1.7" />
                    </svg> Sil
                  </button>
                </div>
              </div>
            </div>`;
            bindRowEvents(col);
            return col;
        }

        // -------- Add empty row --------
        if (addBtn) {
            addBtn.addEventListener("click", () => {
                const idx = rowsEl.querySelectorAll(".url-input").length;
                rowsEl.appendChild(createRow("", idx));
            });
        }

        // -------- Picker (row mode / gallery mode) --------
        function openPicker(row) {
            const w = 1000, h = 700;
            const y = window.top.outerHeight / 2 + window.top.screenY - (h / 2);
            const x = window.top.outerWidth / 2 + window.top.screenX - (w / 2);
            window.__activeImgEditor = id;   // bu partial
            window.__activeRow       = row;  // null ise galeri modu
            window.open(pickerUrl, 'picker', `popup=yes,width=${w},height=${h},left=${x},top=${y}`);
        }

        if (pickGalleryBtn) {
            pickGalleryBtn.addEventListener("click", () => openPicker(null));
        }

        // -------- Message listener (HER partial kendi handler'ına sahip) --------
        window.addEventListener("message", ev => {
            const data = ev.data || {};
            const isValid = data.type === "image-picked" || data.type === "images-picked";
            if (!isValid) return;

            // Bu event bu editor için mi?
            if (window.__activeImgEditor !== id) return;

            const urls = Array.isArray(data.urls)
                ? data.urls.filter(Boolean)
                : (data.url ? [data.url] : []);

            if (!urls.length) return;

            const activeRow = window.__activeRow;
            if (activeRow && rowsEl.contains(activeRow)) {
                // 1) İlk URL: aktif satırı değiştir
                const first = urls[0];
                const input = activeRow.querySelector(".url-input");
                const img   = activeRow.querySelector(".preview-img");
                const ph    = activeRow.querySelector(".placeholder-wrap");
                const openA = activeRow.querySelector(".open-btn");
                setUrl(input, img, ph, openA, first);

                // 2) Kalan URL'ler: yeni satır olarak ekle
                if (urls.length > 1) {
                    urls.slice(1).forEach(u => {
                        const idx = rowsEl.querySelectorAll(".url-input").length;
                        rowsEl.appendChild(createRow(u, idx));
                    });
                }

                window.__activeRow = null;
                return;
            }

            // ➕ Galeri ekleme modu: tüm URL'ler yeni satır
            urls.forEach(u => {
                const idx = rowsEl.querySelectorAll(".url-input").length;
                rowsEl.appendChild(createRow(u, idx));
            });
        });

        // -------- Initial bind for existing rows --------
        rowsEl.querySelectorAll(".gal-row").forEach(bindRowEvents);

        // -------- Reindex on submit --------
        let form = formId ? document.getElementById(formId) : null;
        if (!form) form = root.closest("form");
        if (form) {
            form.addEventListener("submit", () => {
                const np = getNamePrefix();
                const inputs = rowsEl.querySelectorAll(".url-input");
                inputs.forEach((inp, i) => {
                    inp.name = `${np}[${i}]`;
                });
            });
        }
    })();
</script>

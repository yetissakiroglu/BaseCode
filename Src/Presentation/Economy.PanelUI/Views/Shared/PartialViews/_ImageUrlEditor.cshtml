@model string
@{
    var namePrefix = (ViewData["NamePrefix"] as string) ?? "ImageUrl";
    var formId = (ViewData["FormId"] as string) ?? "mainForm";
    var pickerUrl = (ViewData["PickerUrl"] as string) ?? "/Tenant/ImageManager/Picker";
    var containerId = "imgsingle_" + Guid.NewGuid().ToString("N");
    var url = Model ?? "";
}

<div id="@containerId"
     class="imgpick"
     data-editor-type="single"
     data-name-prefix="@namePrefix">
    <div class="card shadow-sm border-0">
        <div class="card-body p-2">
            <div class="position-relative rounded-3 overflow-hidden border bg-light mb-2 preview-wrap">
                <div class="checkerboard"></div>
                <div class="ratio ratio-16x9">
                    <img src="@(string.IsNullOrWhiteSpace(url) ? "" : url)"
                         alt="Görsel önizleme"
                         class="img-fluid w-100 h-100 object-fit-cover preview-img @(string.IsNullOrWhiteSpace(url) ? "d-none" : null)">
                    <div class="d-flex flex-column align-items-center justify-content-center text-muted gap-1 placeholder-wrap @(string.IsNullOrWhiteSpace(url) ? null : "d-none")">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
                            <path d="M4 5h16v14H4z" stroke="currentColor" stroke-width="1.25" />
                            <path d="M4 15l4-4 4 4 4-5 4 5" stroke="currentColor" stroke-width="1.25" />
                            <circle cx="9" cy="8" r="1" fill="currentColor" />
                        </svg>
                        <small>Seçilmedi</small>
                    </div>
                </div>
                <div class="overlay-actions d-flex gap-2">
                    <button type="button" class="btn btn-dark btn-xs pick-btn">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" class="me-1">
                            <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.8" />
                        </svg> Değiştir
                    </button>
                    <a href="@url" target="_blank" class="btn btn-outline-light btn-xs open-btn">Aç</a>
                </div>
            </div>

            <div class="input-group input-group-sm">
                <input class="form-control url-input"
                       name="@namePrefix"
                       value="@url"
                       placeholder="https://...">
                <button class="btn btn-outline-danger btn-sm clear-btn" type="button">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" class="me-1">
                        <path d="M19 6L5 20M5 6l14 14" stroke="currentColor" stroke-width="1.7" />
                    </svg> Temizle
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .imgpick .object-fit-cover {
        object-fit: cover
    }

    .ratio-16x9 {
        aspect-ratio: 16/9
    }

    .imgpick .preview-wrap {
        transition: box-shadow .2s ease
    }

        .imgpick .preview-wrap:hover {
            box-shadow: 0 .125rem .5rem rgba(0,0,0,.12)
        }

    .imgpick .checkerboard {
        position: absolute;
        inset: 0;
        background: conic-gradient(#eee 25%, #fff 0 50%, #eee 0 75%, #fff 0) 0/16px 16px;
        opacity: .6;
    }

    .imgpick .overlay-actions {
        position: absolute;
        inset: auto 0 0 0;
        display: flex;
        justify-content: center;
        padding: .4rem;
        background: linear-gradient(180deg, rgba(0,0,0,0) 0%, rgba(0,0,0,.45) 100%);
        opacity: 0;
        transition: opacity .2s ease;
    }

    .imgpick .preview-wrap:hover .overlay-actions {
        opacity: 1
    }

    .btn-xs {
        padding: .15rem .4rem;
        font-size: .75rem;
        line-height: 1.1;
        border-radius: .25rem
    }
</style>

<script>
    (function () {
        const id        = "@containerId";
        const pickerUrl = "@pickerUrl";

        const root = document.getElementById(id);
        if (!root) return;

        const input = root.querySelector(".url-input");
        const img   = root.querySelector(".preview-img");
        const ph    = root.querySelector(".placeholder-wrap");
        const openA = root.querySelector(".open-btn");
        const pick  = root.querySelector(".pick-btn");
        const clear = root.querySelector(".clear-btn");

        function setUrl(val) {
            val = (val || "").trim();
            input.value = val;
            const has = !!val;
            if (img)   { img.src = val; img.classList.toggle("d-none", !has); }
            if (ph)    { ph.classList.toggle("d-none", has); }
            if (openA) { openA.href = has ? val : "#"; }
        }

        if (input) {
            input.addEventListener("input", () => setUrl(input.value));
        }

        if (pick) {
            pick.addEventListener("click", () => {
                const w = 1000, h = 700;
                const y = window.top.outerHeight / 2 + window.top.screenY - (h / 2);
                const x = window.top.outerWidth / 2 + window.top.screenX - (w / 2);

                // Global picker state
                window.__imgPickerState = {
                    editorId: id,
                    mode: "single"
                };

                window.open(
                    pickerUrl,
                    "picker",
                    `popup=yes,width=${w},height=${h},left=${x},top=${y}`
                );
            });
        }

        if (clear) {
            clear.addEventListener("click", () => setUrl(""));
        }

        // Bu editor’ü global kayda al
        window.__imgEditors = window.__imgEditors || {};
        window.__imgEditors[id] = {
            type: "single",
            apply: function (payload) {
                const urls = payload.urls || [];
                if (!urls.length) return;
                setUrl(urls[0]); // tekli editor: sadece ilkini al
            }
        };

        // Ortak message handler sadece 1 kere eklenir
        if (!window.__imgPickerMessageBound) {
            window.__imgPickerMessageBound = true;

            window.addEventListener("message", function (ev) {
                const data = ev.data || {};
                if (data.type !== "image-picked" && data.type !== "images-picked") return;

                const state = window.__imgPickerState || {};
                if (!state.editorId) return;

                const editorMap = window.__imgEditors || {};
                const editor = editorMap[state.editorId];
                if (!editor || typeof editor.apply !== "function") return;

                const urls = Array.isArray(data.urls)
                    ? data.urls.filter(Boolean)
                    : (data.url ? [data.url] : []);

                if (!urls.length) return;

                editor.apply({
                    urls,
                    state
                });
            });
        }
    })();
</script>

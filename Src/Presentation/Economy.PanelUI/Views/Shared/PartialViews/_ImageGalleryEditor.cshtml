@using Economy.Core.Dtos.Custom
@model List<MediaItem>

@{
    var namePrefix = (ViewData["NamePrefix"] as string) ?? "Items";
    var formId = (ViewData["FormId"] as string) ?? "mainForm";
    var pickerUrl = (ViewData["PickerUrl"] as string) ?? "/Tenant/ImageManager/Picker";
    var containerId = "imglist_" + Guid.NewGuid().ToString("N");
}

<div id="@containerId"
     class="imgpick mt-3"
     data-editor-type="multi"
     data-name-prefix="@namePrefix">

    <div class="row g-3" id="rows-@containerId">
        @for (int i = 0; i < (Model?.Count ?? 0); i++)
        {
            var item = Model[i];
            var url = item?.MediaUrl ?? "";
            var id = item?.Id;
            var sort = item?.SortOrder ?? i;
            var IsCover = item?.IsCover ?? false;

            <div class="col-12 col-md-6 col-xl-4 gal-row">
                <div class="card shadow-sm border-0">
                    <div class="card-body p-2">
                        <div class="position-relative rounded-3 overflow-hidden border bg-light mb-2 preview-wrap">

                            <div class="ratio ratio-16x9">
                                <img src="@url"
                                     alt="Görsel önizleme"
                                     class="img-fluid w-100 h-100 object-fit-cover preview-img @(string.IsNullOrWhiteSpace(url) ? "d-none" : null)">
                                <div class="d-flex flex-column align-items-center justify-content-center text-muted gap-1 placeholder-wrap @(string.IsNullOrWhiteSpace(url) ? null : "d-none")">
                                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
                                        <path d="M4 5h16v14H4z" stroke="currentColor" stroke-width="1.25" />
                                        <path d="M4 15l4-4 4 4 4-5 4 5" stroke="currentColor" stroke-width="1.25" />
                                        <circle cx="9" cy="8" r="1" fill="currentColor" />
                                    </svg>
                                    <small>Seçilmedi</small>
                                </div>
                            </div>
                            <div class="overlay-actions d-flex gap-2">
                                <button type="button" class="btn btn-dark btn-xs pick-btn">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" class="me-1">
                                        <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.8" />
                                    </svg> Değiştir
                                </button>
                                <a href="@url" target="_blank" class="btn btn-outline-light btn-xs open-btn">Aç</a>
                            </div>
                        </div>

                        <!-- MediaItem alanları -->
                        <input type="hidden"
                               name="@($"{namePrefix}[{i}].Id")"
                               value="@(id?.ToString() ?? "")" />

                        <input type="hidden"
                               name="@($"{namePrefix}[{i}].SortOrder")"
                               value="@sort" />

                        <div class="input-group input-group-sm">
                            <input class="form-control url-input"
                                   name="@($"{namePrefix}[{i}].MediaUrl")"
                                   value="@url"
                                   placeholder="https://...">
                            <button class="btn btn-outline-danger btn-sm remove-row" type="button">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" class="me-1">
                                    <path d="M19 6L5 20M5 6l14 14" stroke="currentColor" stroke-width="1.7" />
                                </svg> Sil
                            </button>
                        </div>

                        @* Var olan Translations’ları kaybetmemek için hidden olarak gönderiyoruz *@
                        @if (item?.Translations != null && item.Translations.Count > 0)
                        {
                            for (int t = 0; t < item.Translations.Count; t++)
                            {
                                var tr = item.Translations[t];

                                <small class="text-muted">
                                    <i class="@tr.AppLanguageIcon"></i> @tr.AppLanguageCode.ToUpper()
                                </small>

                                <input type="hidden"
                                       name="@($"{namePrefix}[{i}].Translations[{t}].Id")"
                                       value="@(tr.Id?.ToString() ?? "")" />

                                <input type="hidden"
                                       name="@($"{namePrefix}[{i}].Translations[{t}].AppLanguageId")"
                                       value="@tr.AppLanguageId" />

                                <input type="hidden"
                                       name="@($"{namePrefix}[{i}].Translations[{t}].AppLanguageCode")"
                                       value="@tr.AppLanguageCode" />

                                <input type="hidden"
                                       name="@($"{namePrefix}[{i}].Translations[{t}].AppLanguageIcon")"
                                       value="@tr.AppLanguageIcon" />

                                <input class="form-control form-control-sm mt-1"
                                       name="@($"{namePrefix}[{i}].Translations[{t}].Alt")"
                                       value="@tr.Alt" placeholder="Caption (@tr.Alt)" />

                                <input class="form-control form-control-sm mt-1"
                                       name="@($"{namePrefix}[{i}].Translations[{t}].Caption")"
                                       value="@tr.Caption" placeholder="Caption (@tr.Caption)" />
                            }
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="mt-3 text-center">
        <button type="button" class="btn btn-sm btn-outline-primary btn-add">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" class="me-1">
                <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.8" />
            </svg> Yeni Görsel Ekle
        </button>
        <button type="button" class="btn btn-sm btn-secondary btn-pick-gallery">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" class="me-1">
                <path d="M4 5h16v14H4z" stroke="currentColor" stroke-width="1.5" />
                <path d="M4 15l4-4 4 4 4-5 4 5" stroke="currentColor" stroke-width="1.5" />
            </svg> Dosya Seç
        </button>
    </div>
</div>

<style>
    .imgpick .object-fit-cover {
        object-fit: cover
    }

    .ratio-16x9 {
        aspect-ratio: 16/9
    }

    .imgpick .preview-wrap {
        transition: box-shadow .2s ease
    }

        .imgpick .preview-wrap:hover {
            box-shadow: 0 .125rem .5rem rgba(0,0,0,.12)
        }

    .imgpick .checkerboard {
        position: absolute;
        inset: 0;
        background: conic-gradient(#eee 25%, #fff 0 50%, #eee 0 75%, #fff 0) 0/16px 16px;
        opacity: .6;
    }

    .imgpick .overlay-actions {
        position: absolute;
        inset: auto 0 0 0;
        display: flex;
        justify-content: center;
        padding: .4rem;
        background: linear-gradient(180deg, rgba(0,0,0,0) 0%, rgba(0,0,0,.45) 100%);
        opacity: 0;
        transition: opacity .2s ease;
    }

    .imgpick .preview-wrap:hover .overlay-actions {
        opacity: 1
    }

    .btn-xs {
        padding: .15rem .4rem;
        font-size: .75rem;
        line-height: 1.1;
        border-radius: .25rem
    }
</style>

<script>
    (function () {
        const id        = "@containerId";
        const pickerUrl = "@pickerUrl";
        const formId    = "@formId";

        const root = document.getElementById(id);
        if (!root) return;

        const rowsEl         = root.querySelector("#rows-" + id);
        const addBtn         = root.querySelector(".btn-add");
        const pickGalleryBtn = root.querySelector(".btn-pick-gallery");

        function getNamePrefix() {
            return root.getAttribute("data-name-prefix") || "@namePrefix";
        }

        function setUrl(input, img, ph, openA, val) {
            val = (val || "").trim();
            if (input) input.value = val;
            const has = !!val;
            if (img)   { img.src = val; img.classList.toggle("d-none", !has); }
            if (ph)    { ph.classList.toggle("d-none", has); }
            if (openA) { openA.href = has ? val : "#"; }
        }

        function bindRowEvents(row) {
            const input = row.querySelector(".url-input");
            const img   = row.querySelector(".preview-img");
            const ph    = row.querySelector(".placeholder-wrap");
            const openA = row.querySelector(".open-btn");
            const pick  = row.querySelector(".pick-btn");
            const del   = row.querySelector(".remove-row");

            if (input) {
                input.addEventListener("input", () => setUrl(input, img, ph, openA, input.value));
            }
            if (pick) {
                pick.addEventListener("click", () => {
                    const w = 1000, h = 700;
                    const y = window.top.outerHeight / 2 + window.top.screenY - (h / 2);
                    const x = window.top.outerWidth / 2 + window.top.screenX - (w / 2);

                    window.__imgPickerState = {
                        editorId: id,
                        mode: "row",
                        row: row
                    };

                    window.open(
                        pickerUrl,
                        "picker",
                        `popup=yes,width=${w},height=${h},left=${x},top=${y}`
                    );
                });
            }
            if (del) {
                del.addEventListener("click", () => row.remove());
            }
        }

        function createRow(url, idx) {
            const np = getNamePrefix();
            const col = document.createElement("div");
            col.className = "col-12 col-md-6 col-xl-4 gal-row";
            col.innerHTML = `
            <div class="card shadow-sm border-0">
              <div class="card-body p-2">
                <div class="position-relative rounded-3 overflow-hidden border bg-light mb-2 preview-wrap">
                  <div class="checkerboard"></div>
                  <div class="ratio ratio-16x9">
                    <img src="${url || ""}" class="img-fluid w-100 h-100 object-fit-cover preview-img ${url ? "" : "d-none"}">
                    <div class="d-flex flex-column align-items-center justify-content-center text-muted gap-1 placeholder-wrap ${url ? "d-none" : ""}">
                      <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
                        <path d="M4 5h16v14H4z" stroke="currentColor" stroke-width="1.25" />
                        <path d="M4 15l4-4 4 4 4-5 4 5" stroke="currentColor" stroke-width="1.25" />
                        <circle cx="9" cy="8" r="1" fill="currentColor" />
                      </svg>
                      <small>Seçilmedi</small>
                    </div>
                  </div>
                  <div class="overlay-actions d-flex gap-2">
                    <button type="button" class="btn btn-dark btn-xs pick-btn">
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" class="me-1">
                        <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.8" />
                      </svg> Değiştir
                    </button>
                    <a href="${url || "#"}" target="_blank" class="btn btn-outline-light btn-xs open-btn">Aç</a>
                  </div>
                </div>

                <input type="hidden"
                       name="${np}[${idx}].Id"
                       value="" />

                <input type="hidden"
                       name="${np}[${idx}].SortOrder"
                       value="${idx}" />

                <div class="input-group input-group-sm">
                  <input class="form-control url-input"
                         name="${np}[${idx}].MediaUrl"
                         value="${url || ""}"
                         placeholder="https://...">
                  <button class="btn btn-outline-danger btn-sm remove-row" type="button">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" class="me-1">
                      <path d="M19 6L5 20M5 6l14 14" stroke="currentColor" stroke-width="1.7" />
                    </svg> Sil
                  </button>
                </div>
              </div>
            </div>`;
            bindRowEvents(col);
            return col;
        }

        if (addBtn) {
            addBtn.addEventListener("click", () => {
                const idx = rowsEl.querySelectorAll(".gal-row").length;
                rowsEl.appendChild(createRow("", idx));
            });
        }

        if (pickGalleryBtn) {
            pickGalleryBtn.addEventListener("click", () => {
                const w = 1000, h = 700;
                const y = window.top.outerHeight / 2 + window.top.screenY - (h / 2);
                const x = window.top.outerWidth / 2 + window.top.screenX - (w / 2);

                window.__imgPickerState = {
                    editorId: id,
                    mode: "multi"
                };

                window.open(
                    pickerUrl,
                    "picker",
                    `popup=yes,width=${w},height=${h},left=${x},top=${y}`
                );
            });
        }

        // Bu editor’ü global kayda al
        window.__imgEditors = window.__imgEditors || {};
        window.__imgEditors[id] = {
            type: "multi",
            apply: function (payload) {
                const urls = payload.urls || [];
                const state = payload.state || {};
                if (!urls.length) return;

                if (state.mode === "row" && state.row && rowsEl.contains(state.row)) {
                    // 1) İlk URL: aktif satırı DEĞİŞTİR
                    const first = urls[0];
                    const input = state.row.querySelector(".url-input");
                    const img   = state.row.querySelector(".preview-img");
                    const ph    = state.row.querySelector(".placeholder-wrap");
                    const openA = state.row.querySelector(".open-btn");
                    setUrl(input, img, ph, openA, first);

                    // 2) Kalan URL'ler: yeni satır olarak EKLE
                    if (urls.length > 1) {
                        urls.slice(1).forEach(u => {
                            const idx = rowsEl.querySelectorAll(".gal-row").length;
                            rowsEl.appendChild(createRow(u, idx));
                        });
                    }
                } else {
                    // Galeri modu: tüm URL'ler yeni satır
                    urls.forEach(u => {
                        const idx = rowsEl.querySelectorAll(".gal-row").length;
                        rowsEl.appendChild(createRow(u, idx));
                    });
                }

                // Row modu bittiyse temizle
                if (state.mode === "row") {
                    state.row = null;
                }
            }
        };

        // Global message handler
        if (!window.__imgPickerMessageBound) {
            window.__imgPickerMessageBound = true;

            window.addEventListener("message", function (ev) {
                const data = ev.data || {};
                if (data.type !== "image-picked" && data.type !== "images-picked") return;

                const state = window.__imgPickerState || {};
                if (!state.editorId) return;

                const editorMap = window.__imgEditors || {};
                const editor = editorMap[state.editorId];
                if (!editor || typeof editor.apply !== "function") return;

                const urls = Array.isArray(data.urls)
                    ? data.urls.filter(Boolean)
                    : (data.url ? [data.url] : []);

                if (!urls.length) return;

                editor.apply({
                    urls,
                    state
                });
            });
        }

        // Var olan satırlar için ilk bind
        rowsEl.querySelectorAll(".gal-row").forEach(bindRowEvents);

        // Submit öncesi reindex – tüm input/select/textarea name'lerinde prefix index'ini güncelle
        let form = formId ? document.getElementById(formId) : null;
        if (!form) form = root.closest("form");
        if (form) {
            form.addEventListener("submit", () => {
                const np = getNamePrefix();
                const rows = rowsEl.querySelectorAll(".gal-row");
                const prefix = np + "[";
                const prefixLen = prefix.length;

                rows.forEach((row, rowIndex) => {
                    const fields = row.querySelectorAll("input[name], select[name], textarea[name]");
                    fields.forEach(inp => {
                        const oldName = inp.name;
                        const pos = oldName.indexOf(prefix);
                        if (pos === -1) return;

                        const start = pos + prefixLen;
                        const end = oldName.indexOf("]", start);
                        if (end === -1) return;

                        const newName = oldName.substring(0, pos)
                            + prefix
                            + rowIndex
                            + "]"
                            + oldName.substring(end + 1);

                        inp.name = newName;
                    });
                });
            });
        }
    })();
</script>

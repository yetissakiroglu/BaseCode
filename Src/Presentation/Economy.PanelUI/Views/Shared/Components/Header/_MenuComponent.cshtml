@inherits Economy.Panel.UI.Helpers.MyBaseViewPage<dynamic>
<nav>
    <div class="app-logo">
        <a class="logo d-inline-block" href="/">
            @{
                var logo = ViewData["LogoUrl"]?.ToString();
                var site = ViewData["SiteName"]?.ToString() ?? "Uygulama";
            }
            @if (!string.IsNullOrWhiteSpace(logo))
            {
                <img src="@logo" alt="@site" />
            }
        </a>

        <span class="bg-light-primary toggle-semi-nav">
            <i class="ti ti-chevrons-right f-s-20"></i>
        </span>
    </div>
    <div class="app-nav" id="app-simple-bar">
        <ul class="main-nav p-0 mt-2">
            @if (IsSuperAdmin())
            {
                <!-- Kullanıcı Yönetimi -->
                <li class="menu-title"><span>Kullanıcı Yönetimi</span></li>
                <li>
                    <a data-bs-toggle="collapse" href="#superadmin-users" aria-expanded="false">
                        <i class="iconoir-user"></i> Kullanıcılar
                    </a>
                    <ul class="collapse" id="superadmin-users">
                        <li><a href="/Admin/SuperAdmin/List">Kullanıcı Listesi</a></li>
                        <li><a href="/Admin/SuperAdmin/Create">Yeni Kullanıcı Ekle</a></li>
                        <li><a href="/Admin/SuperAdmin/Roles">Rol & Yetki Yönetimi</a></li>
                        <li><a href="/Admin/UserLog/LoginLogs">Giriş Kayıtları</a></li>
                    </ul>
                </li>

                <li class="menu-title"><span>Uygulama Bazlı Yönetim</span></li>
                <li>
                    <a data-bs-toggle="collapse" href="#uygulamalar" aria-expanded="false">
                        <i class="iconoir-home-alt"></i> Uygulama Yönetimi
                    </a>
                    <ul class="collapse" id="uygulamalar">
                        <li><a href="/App/CreateApp">Uygulama Oluştur</a></li>
                        <li><a href="/App/AppList">Uygulama Listesi</a></li>
                        <li><a href="/App/SelectForManagerAssign">Yönetici Ata</a></li>
                    </ul>
                </li>

                <!-- Sistem Ayarları -->
                <li class="menu-title"><span>Sistem Ayarları</span></li>
                <li><a href="/Settings/General"><i class="iconoir-settings"></i> Genel Ayarlar</a></li>
                <li><a href="/Settings/Security"><i class="iconoir-shield"></i> Güvenlik Ayarları</a></li>

                <!-- Log Yönetimi -->
                <li class="menu-title"><span>Log Yönetimi</span></li>
                <li><a href="/Logs/Audit"><i class="iconoir-report-columns"></i> İşlem Logları</a></li>
                <li><a href="/Logs/Error"><i class="iconoir-warning-triangle"></i> Hata Logları</a></li>

                <!-- Veritabanı -->
                <li class="menu-title"><span>Veritabanı</span></li>
                <li><a href="/Database/Backup"><i class="iconoir-database"></i> Yedekleme / Geri Yükleme</a></li>

            }

            @if (IsTenantAdmin())
            {
                <li class="menu-title"><span>Site Yönetimi</span></li>
                <li class="no-sub">
                    <a class="" href="/TechnicalSetting">
                        <i class="iconoir-view-grid"></i>
                        Teknik Ayarlar
                    </a>
                </li>
                <li>
                    <a aria-expanded="false" class="" data-bs-toggle="collapse" href="#SiteYonetimi">
                        <i class="iconoir-keyframes-couple"></i> Site Ayarları
                    </a>
                    <ul class="collapse" id="SiteYonetimi">
                        <li><a href="/Setting">Genel Ayarlar</a></li>
                        <li><a href="/Logo">Logolar</a></li>
                        <li><a href="/ReservationNumber">Rezervasyon Telefonları</a></li>
                        <li><a href="/ReservationLink">Rezervasyon Linki</a></li>
                        <li><a href="/WhatsappLine">Whatsapp Hattı</a></li>
                    </ul>
                </li>
                <li>
                    <a aria-expanded="false" class="" data-bs-toggle="collapse" href="#MenuYonetimi">
                        <i class="iconoir-keyframes-couple"></i>Menü Yönetimi
                    </a>
                    <ul class="collapse" id="MenuYonetimi">
                        <li><a href="/Menu/TopMenu">Üst Menüler</a></li>
                        <li><a href="/Menu/SubMenu">Alt Menüler</a></li>
                    </ul>
                </li>
                <li class="no-sub">
                    <a class="" href="/Slide">
                        <i class="iconoir-view-grid"></i>
                        Slidelar
                    </a>
                </li>
                <li>
                    <a aria-expanded="false" class="" data-bs-toggle="collapse" href="#PageYonetimi">
                        <i class="iconoir-keyframes-couple"></i>Sayfa Yönetimi
                    </a>
                    <ul class="collapse" id="PageYonetimi">
                        <li><a href="/Page">Sayfalar</a></li>
                        <li><a href="/Category">Kategoriler</a></li>
                    </ul>
                </li>
                <li class="no-sub">
                    <a class="" href="/Room">
                        <i class="iconoir-view-grid"></i>
                        Odalar
                    </a>
                </li>
                <li>
                    <a aria-expanded="false" class="" data-bs-toggle="collapse" href="#DilYonetimi">
                        <i class="iconoir-keyframes-couple"></i> Dil Yönetimi
                    </a>
                    <ul class="collapse" id="DilYonetimi">
                        <li><a href="/Language">Diller</a></li>
                    </ul>
                </li>
                <li class="menu-title"><span>İçerik Yönetimi</span></li>
                <li>
                    <a data-bs-toggle="collapse" href="#icerik" aria-expanded="false">
                        <i class="iconoir-document"></i> Sayfa / İçerik
                    </a>
                    <ul class="collapse" id="icerik">
                        <li><a href="/Content/Pages">Sayfa Yönetimi</a></li>
                        <li><a href="/Content/Sliders">Slider / Banner</a></li>
                        <li><a href="/Content/Blog">Haber / Duyuru</a></li>
                        <li><a href="/Content/Seo">SEO Ayarları</a></li>
                    </ul>
                </li>
                <li>
                    <a href="/FileManager/Index">
                        <i class="iconoir-folder"></i> Dosya Yöneticisi
                    </a>
                </li>
            }
        </ul>
    </div>

    <div class="menu-navs">
        <span class="menu-previous"><i class="ti ti-chevron-left"></i></span>
        <span class="menu-next"><i class="ti ti-chevron-right"></i></span>
    </div>

</nav>
<!-- Menu Navigation ends -->
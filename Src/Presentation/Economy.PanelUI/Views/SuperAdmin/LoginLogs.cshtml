@using Economy.Application.Dtos.LoginLogPageQueryDto
@model LoginLogPageViewModel
@{
    ViewData["Title"] = "Login Logları";
    string Qs(object extra = null) {
        var q = new Dictionary<string, string?>
        {
            ["DateFrom"] = Model.Q.DateFrom?.ToString("yyyy-MM-dd"),
            ["DateTo"] = Model.Q.DateTo?.ToString("yyyy-MM-dd"),
            ["UserName"] = Model.Q.UserName,
            ["Succeeded"] = Model.Q.Succeeded.HasValue ? Model.Q.Succeeded.Value.ToString() : null,
            ["StatusCode"] = Model.Q.StatusCode?.ToString(),
            ["PageSize"] = Model.PageSize.ToString()
        };
        if (extra is Dictionary<string,string> e)
            foreach (var kv in e) q[kv.Key] = kv.Value;
        var qs = string.Join("&", q.Where(kv => !string.IsNullOrWhiteSpace(kv.Value))
                                   .Select(kv => $"{kv.Key}={Uri.EscapeDataString(kv.Value!)}"));
        return string.IsNullOrEmpty(qs) ? "" : "?" + qs;
    }
}

<h3 class="mb-3">Login Logları</h3>

@if (TempData["Error"] != null)
{
  <div class="alert alert-danger">@TempData["Error"]</div>
}

<form method="get" class="card card-body mb-3">
  <div class="row g-2 align-items-end">
    <div class="col-md-2">
      <label class="form-label">Tarih (Başlangıç)</label>
      <input type="date" name="DateFrom" class="form-control" value="@(Model.Q.DateFrom?.ToString("yyyy-MM-dd"))" />
    </div>
    <div class="col-md-2">
      <label class="form-label">Tarih (Bitiş)</label>
      <input type="date" name="DateTo" class="form-control" value="@(Model.Q.DateTo?.ToString("yyyy-MM-dd"))" />
    </div>
    <div class="col-md-2">
      <label class="form-label">Kullanıcı</label>
      <input type="text" name="UserName" class="form-control" value="@Model.Q.UserName" placeholder="kullanıcı adı" />
    </div>
    <div class="col-md-2">
      <label class="form-label">Durum</label>
      <select name="Succeeded" class="form-select">
        <option value="">Hepsi</option>
       @*  <option value="true"  @(Model.Q.Succeeded == true  ? "selected" : "")>Başarılı</option>
        <option value="false" @(Model.Q.Succeeded == false ? "selected" : "")>Başarısız</option> *@
      </select>
    </div>
    <div class="col-md-2">
      <label class="form-label">StatusCode</label>
      <input type="number" name="StatusCode" class="form-control" value="@(Model.Q.StatusCode?.ToString())" />
    </div>
    <div class="col-md-2">
      <label class="form-label">Sayfa Boyutu</label>
      <select name="PageSize" class="form-select">
      @*   <option value="25"  @(Model.PageSize==25 ? "selected":"")>25</option>
        <option value="50"  @(Model.PageSize==50 ? "selected":"")>50</option>
        <option value="100" @(Model.PageSize==100 ? "selected":"")>100</option> *@
      </select>
    </div>
  </div>
  <div class="mt-3 d-flex gap-2">
    <button class="btn btn-primary" type="submit">Filtrele</button>
    <a class="btn btn-outline-secondary" href="/SuperAdmin/LoginLogs">Temizle</a>
    <a class="btn btn-outline-success ms-auto" href="/SuperAdmin/LoginLogs/Export@Qs()">
      CSV İndir
    </a>
  </div>
</form>

<div class="table-responsive">
  <table class="table table-sm table-striped align-middle">
    <thead>
      <tr>
        <th>Tarih</th>
        <th>Kullanıcı</th>
        <th>IP</th>
        <th>Path</th>
        <th>Durum</th>
        <th>Status</th>
        <th>Mesaj</th>
        <th>CorrelationId</th>
      </tr>
    </thead>
    <tbody>
    @if (Model.Items?.Any() == true)
    {
        foreach (var r in Model.Items)
        {
            <tr>
              <td>@r.CreatedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
              <td>@r.UserName</td>
              <td>@r.IpAddress</td>
              <td>@r.RequestPath</td>
              <td>
                @if (r.Succeeded)
                { <span class="badge bg-success">OK</span> }
                else
                { <span class="badge bg-danger">FAIL</span> }
              </td>
              <td>@(r.StatusCode?.ToString() ?? "-")</td>
              <td title="@r.Message">
                @((r.Message?.Length ?? 0) > 60 ? r.Message!.Substring(0,60) + "..." : r.Message)
              </td>
              <td><small>@r.CorrelationId</small></td>
            </tr>
        }
    }
    else
    {
        <tr><td colspan="8" class="text-center text-muted">Kayıt bulunamadı</td></tr>
    }
    </tbody>
  </table>
</div>

@if (Model.TotalPages > 1)
{
  <nav class="mt-2">
    <ul class="pagination">
      @{
        int prev = Math.Max(1, Model.Page - 1);
        int next = Math.Min(Model.TotalPages, Model.Page + 1);
      }
      <li class="page-item @(Model.Page==1?"disabled":"")">
        <a class="page-link" href="/SuperAdmin/LoginLogs@Qs(new Dictionary<string,string>{{"Page", prev.ToString()}})">«</a>
      </li>
      <li class="page-item disabled">
        <span class="page-link">@Model.Page / @Model.TotalPages (Toplam @Model.TotalCount)</span>
      </li>
      <li class="page-item @(Model.Page==Model.TotalPages?"disabled":"")">
        <a class="page-link" href="/SuperAdmin/LoginLogs@Qs(new Dictionary<string,string>{{"Page", next.ToString()}})">»</a>
      </li>
    </ul>
  </nav>
}

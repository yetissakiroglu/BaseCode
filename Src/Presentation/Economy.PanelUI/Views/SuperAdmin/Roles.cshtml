@using Economy.Domain.Entites.Identities
@model IEnumerable<AppRole>
@{
    ViewData["Title"] = "Roller";
}

<h3 class="mb-3">Roller</h3>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div></div>
    <a class="btn btn-primary" href="/SuperAdmin/CreateRole">Yeni Rol Ekle</a>
</div>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th style="width: 30%;">Rol Adı</th>
            <th style="width: 40%;">Id</th>
            <th style="width: 30%;"></th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var r in Model)
            {
                <tr>
                    <td>@r.Name</td>
                    <td class="text-muted">@r.Id</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" href="/SuperAdmin/EditRole/@r.Id">Düzenle</a>
                        <form asp-action="DeleteRole" asp-controller="SuperAdmin" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@r.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger"
                                    onclick="return confirm('Bu rolü silmek istediğinize emin misiniz?');">
                                Sil
                            </button>
                            @Html.AntiForgeryToken()
                        </form>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr><td colspan="3" class="text-center text-muted">Kayıt bulunamadı.</td></tr>
        }
    </tbody>
</table>

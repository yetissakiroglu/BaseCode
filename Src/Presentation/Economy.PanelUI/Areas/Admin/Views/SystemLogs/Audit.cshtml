@using Economy.Panel.UI.Areas.Admin.Controllers
@using Economy.Panel.UI.Controllers
@model AuditPageViewModel
@{
    ViewData["Title"] = "Audit Logları";
    var q = Model.Query;
    var res = Model.Result;


    ViewBag.SortOptions = new List<SelectListItem>
{
    new() { Value = "-created", Text = "Tarih ↓" },
    new() { Value = "created",  Text = "Tarih ↑" },
    new() { Value = "-status",  Text = "Status ↓" },
    new() { Value = "status",   Text = "Status ↑" },
    new() { Value = "-duration",Text = "Süre ↓" },
    new() { Value = "duration", Text = "Süre ↑" }
};

ViewBag.SelectedSort = q.Sort;
}

<h3 class="mb-3">Audit Logları</h3>

@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
@if (TempData["Error"] != null)   { <div class="alert alert-danger">@TempData["Error"]</div> }


<main>
    <div class="container-fluid">
        <!-- Başlık ve Breadcrumb -->
        @await Html.PartialAsync("_breadcrumbs")
        <!-- Yeni Ekle Butonu -->
        <div class="row mb-3">
            <div class="col-12 d-flex justify-content-end">
            
<form method="get" class="card card-body mb-3">
  <div class="row g-3">
    <div class="col-md-3">
      <label class="form-label">Başlangıç</label>
      <input type="date" name="DateFrom" value="@(q.DateFrom?.ToString("yyyy-MM-dd"))" class="form-control" />
    </div>
    <div class="col-md-3">
      <label class="form-label">Bitiş</label>
      <input type="date" name="DateTo" value="@(q.DateTo?.ToString("yyyy-MM-dd"))" class="form-control" />
    </div>
    <div class="col-md-2">
      <label class="form-label">Kullanıcı Id</label>
      <input type="number" name="UserId" value="@(q.UserId?.ToString())" class="form-control" />
    </div>
    <div class="col-md-4">
      <label class="form-label">Kullanıcı Adı</label>
      <input type="text" name="UserName" value="@q.UserName" class="form-control" />
    </div>

    <div class="col-md-3">
      <label class="form-label">Aksiyon</label>
      <input type="text" name="Action" value="@q.Action" class="form-control" placeholder="Create, Update, Delete..." />
    </div>
    <div class="col-md-3">
      <label class="form-label">Entity</label>
      <input type="text" name="EntityName" value="@q.EntityName" class="form-control" placeholder="AppUser, Order..." />
    </div>
    <div class="col-md-2">
      <label class="form-label">StatusCode</label>
      <input type="number" name="StatusCode" value="@(q.StatusCode?.ToString())" class="form-control" />
    </div>
    <div class="col-md-2">
      <label class="form-label">Başarılı?</label>
      <select name="Succeeded" class="form-select">
        <option value="">Hepsi</option>
        <option value="true"  selected="@(q.Succeeded == true)">Evet</option>
        <option value="false" selected="@(q.Succeeded == false)">Hayır</option>
      </select>
    </div>
    <div class="col-md-2">
      <label class="form-label">Sırala</label>
<select name="Sort" class="form-select"
        asp-items="@(new SelectList(ViewBag.SortOptions, "Value", "Text", ViewBag.SelectedSort))">
</select>
    </div>

    <div class="col-md-10">
      <label class="form-label">Anahtar Kelime</label>
      <input type="text" name="Keyword" value="@q.Keyword" class="form-control" placeholder="Mesaj/JSON içinde ara..." />
    </div>
    <div class="col-md-2 d-flex align-items-end">
      <button class="btn btn-primary w-100" type="submit">Filtrele</button>
    </div>
  </div>
</form>

            </div>
        </div>
        <!-- Kullanıcı Tablosu -->
        <div class="row">
            <div class="col-xl-12">
                <div class="card">
                    <div class="card-header">
                        <h5>Kayıtlar</h5>
                        <p>Aşağıda kayıtlı bilgileri yer almaktadır.</p>
                    </div>
                    <div class="card-body">
                      <div class="table-responsive">
                            <table class="table table-bottom-border table-hover align-middle mb-0">
  <thead>
    <tr>
      <th>Tarih</th>
      <th>Kullanıcı</th>
      <th>Aksiyon</th>
      <th>Entity</th>
      <th>Path</th>
      <th>Status</th>
      <th>Sonuç</th>
      <th class="text-end">İşlem</th>
    </tr>
  </thead>
  <tbody>
  @if (res.Items?.Any() == true)
  {
      foreach (var x in res.Items)
      {
          <tr>
              <td>@(x.CreatedDate?.ToLocalTime().ToString("yyyy-MM-dd HH:mm"))</td>
              <td>@(x.UserName ?? ("#" + x.UserId))</td>
              <td>@x.Action</td>
              <td>@x.EntityName <small class="text-muted">@x.EntityId</small></td>
              <td><small>@x.HttpMethod</small> @x.RequestPath</td>
              <td>@(x.StatusCode?.ToString() ?? "-")</td>
              <td>
                @if (x.Succeeded) { <span class="badge bg-success">OK</span> }
                else { <span class="badge bg-danger">Fail</span> }
              </td>
              <td class="text-end">
                <button type="button" class="btn btn-sm btn-outline-secondary"
                        data-bs-toggle="modal" data-bs-target="#detailModal"
                        data-id="@x.Id">Detay</button>
              </td>
          </tr>
      }
  }
  else
  {
      <tr><td colspan="8" class="text-center text-muted">Kayıt bulunamadı.</td></tr>
  }
  </tbody>
</table>
</div>
                      @if (res.TotalPages > 1)
{
  <nav>
    <ul class="pagination">
      @{
          var curr = res.Page;
          var prev = Math.Max(1, curr - 1);
          var next = Math.Min(res.TotalPages, curr + 1);
      }
      <li class="page-item @(curr == 1 ? "disabled" : "")">
        <a class="page-link" href="@Url.Action("Audit", new {
            DateFrom = q.DateFrom?.ToString("yyyy-MM-dd"),
            DateTo = q.DateTo?.ToString("yyyy-MM-dd"),
            q.UserId, q.UserName, q.Action, q.EntityName, q.Succeeded, q.StatusCode, q.Keyword, q.Sort,
            Page = prev, PageSize = q.PageSize
        })">Önceki</a>
      </li>

      @for (int i = 1; i <= res.TotalPages; i++)
      {
          <li class="page-item @(i == curr ? "active" : "")">
            <a class="page-link" href="@Url.Action("Audit", new {
                DateFrom = q.DateFrom?.ToString("yyyy-MM-dd"),
                DateTo = q.DateTo?.ToString("yyyy-MM-dd"),
                q.UserId, q.UserName, q.Action, q.EntityName, q.Succeeded, q.StatusCode, q.Keyword, q.Sort,
                Page = i, PageSize = q.PageSize
            })">@i</a>
          </li>
      }

      <li class="page-item @(curr == res.TotalPages ? "disabled" : "")">
        <a class="page-link" href="@Url.Action("Audit", new {
            DateFrom = q.DateFrom?.ToString("yyyy-MM-dd"),
            DateTo = q.DateTo?.ToString("yyyy-MM-dd"),
            q.UserId, q.UserName, q.Action, q.EntityName, q.Succeeded, q.StatusCode, q.Keyword, q.Sort,
            Page = next, PageSize = q.PageSize
        })">Sonraki</a>
      </li>
    </ul>
  </nav>
}

                    </div>
                </div>
            </div>
        </div>
    </div>
</main>









<!-- Detay Modal -->
<div class="modal fade" id="detailModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Log Detayı</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div id="detailContent" class="small text-monospace">Yükleniyor...</div>
      </div>
    </div>
  </div>
</div>

@section Scripts{
  <script>
    const modal = document.getElementById('detailModal');
    modal.addEventListener('show.bs.modal', async ev => {
      const btn = ev.relatedTarget;
      const id = btn?.getAttribute('data-id');
      const box = document.getElementById('detailContent');
      box.textContent = "Yükleniyor...";
      try {
        const resp = await fetch(`/Logs/Audit/Detail/${id}`);
        const html = await resp.text();
        box.innerHTML = html; // Partial döndürüyoruz
      } catch(e) {
        box.textContent = "Detay alınamadı.";
      }
    });
  </script>
}

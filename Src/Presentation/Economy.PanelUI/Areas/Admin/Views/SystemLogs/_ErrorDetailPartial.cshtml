@using Economy.Application.Dtos.AppErrorLogDtos
@model ErrorLogDto
<div>
    <div><b>Tarih:</b> @Model.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</div>
    <div><b>Kullanıcı:</b> @(Model.UserName ?? ("#" + Model.UserId))</div>
    <div><b>Status:</b> @(Model.StatusCode?.ToString() ?? "-")</div>
    <div><b>CorrelationId:</b> @Model.CorrelationId</div>
    <hr />
    <div><b>İstek:</b> <code>@Model.HttpMethod</code> @Model.RequestPath</div>
    @if (!string.IsNullOrWhiteSpace(Model.QueryString))
    {
        <div><b>Query:</b> <code>@Model.QueryString</code></div>
    }
    <div><b>IP:</b> @Model.IpAddress</div>
    <div><b>UserAgent:</b> @Model.UserAgent</div>
    <hr />
    <div><b>Exception:</b> @Model.ExceptionType</div>
    @if (!string.IsNullOrWhiteSpace(Model.Message))
    {
        <div class="mt-2"><b>Mesaj:</b> @Model.Message</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Source))
    {
        <div class="mt-2"><b>Source:</b> @Model.Source</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.TargetSite))
    {
        <div class="mt-2"><b>TargetSite:</b> @Model.TargetSite</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.StackTrace))
    {
        <div class="mt-3">
            <b>StackTrace:</b>
            <pre class="bg-light p-2 rounded" style="white-space:pre-wrap">@Model.StackTrace</pre>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.HeadersJson))
    {
        <div class="mt-3">
            <b>Headers (JSON):</b>
            <pre class="bg-light p-2 rounded">@Model.HeadersJson</pre>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.RequestBodyTruncated))
    {
        <div class="mt-3">
            <b>Request Body (truncated):</b>
            <pre class="bg-light p-2 rounded">@Model.RequestBodyTruncated</pre>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.CustomDataJson))
    {
        <div class="mt-3">
            <b>Custom Data (JSON):</b>
            <pre class="bg-light p-2 rounded">@Model.CustomDataJson</pre>
        </div>
    }
</div>

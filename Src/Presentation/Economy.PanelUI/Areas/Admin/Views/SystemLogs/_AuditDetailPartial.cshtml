@using Economy.Application.Dtos.AppAuditLogDtos
@model AuditLogDto
<div>
    <div><b>Tarih:</b> @(Model.CreatedDate?.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss"))</div>
    <div><b>Kullanıcı:</b> @(Model.UserName ?? ("#" + Model.UserId))</div>
    <div><b>Aksiyon:</b> @Model.Action</div>
    <div><b>Entity:</b> @Model.EntityName <small class="text-muted">@Model.EntityId</small></div>
    <div><b>HTTP:</b> <code>@Model.HttpMethod</code> @Model.RequestPath</div>
    <div><b>Status:</b> @(Model.StatusCode?.ToString() ?? "-") — @(Model.Succeeded ? "Başarılı" : "Başarısız")</div>
    <div><b>IP:</b> @Model.IpAddress</div>
    <div><b>CorrelationId:</b> @Model.CorrelationId</div>
    @if (!string.IsNullOrWhiteSpace(Model.Message))
    {
        <div class="mt-2"><b>Mesaj:</b> @Model.Message</div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.AffectedColumnsJson))
    {
        <div class="mt-3">
            <b>Etkilenen Alanlar (JSON):</b>
            <pre class="bg-light p-2 rounded">@Model.AffectedColumnsJson</pre>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.OldValuesJson))
    {
        <div class="mt-3">
            <b>Eski Değerler (JSON):</b>
            <pre class="bg-light p-2 rounded">@Model.OldValuesJson</pre>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.NewValuesJson))
    {
        <div class="mt-3">
            <b>Yeni Değerler (JSON):</b>
            <pre class="bg-light p-2 rounded">@Model.NewValuesJson</pre>
        </div>
    }
</div>

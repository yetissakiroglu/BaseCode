@using Economy.Panel.UI.Areas.Admin.Models.SuperAdminViewModels
@model EditRoleViewModel
@{
    ViewData["Title"] = "Rol Düzenle";
}

<h3 class="mb-3">Rol Düzenle</h3>

<form asp-action="EditRole" asp-route-id="@Model.Id" method="post" class="card card-body">
    <input type="hidden" asp-for="Id" />
    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Güncelle</button>
        <a href="/SuperAdmin/Roles" class="btn btn-outline-secondary">Geri</a>
    </div>
    @Html.AntiForgeryToken()
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

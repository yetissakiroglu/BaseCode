@using Economy.Panel.UI.Areas.Admin.Models.GeneralSettingsPageViewModels
@model GeneralSettingsPageViewModel
@{
    ViewData["Title"] = "Genel Ayarlar";
}

<main>
    <div class="container-fluid">
        <!-- Breadcrumb start -->
        @await Html.PartialAsync("_breadcrumbs")
        <!-- Breadcrumb end -->

        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                            </div>
                            <div>
                                <div class="app-btn-list">
                                  
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Hoverable Table start -->
            <div class="col-xl-12">
                <div class="card">
                    <div class="card-header">
                        <h5> Kayıtlar </h5>
                        <p>
                            Aşağıda kayıtlı bilgiler bulunmaktadır.
                        </p>
                    </div>
                    <div class="card-body">
                        <div class="row p-2">
                            <div class="col-md-10 offset-md-1">
                                <form asp-action="General" asp-controller="SystemSettings" method="post" enctype="multipart/form-data">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" asp-for="Id" />
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <label asp-for="SiteName" class="form-label"></label>
                                            <input asp-for="SiteName" class="form-control" />
                                            <span asp-validation-for="SiteName" class="text-danger"></span>
                                        </div>

                                        <div class="col-md-6">
                                            <label asp-for="Domain" class="form-label"></label>
                                            <input asp-for="Domain" class="form-control" placeholder="ornek.com" />
                                            <span asp-validation-for="Domain" class="text-danger"></span>
                                        </div>

                                        <div class="col-md-4">
                                            <label asp-for="Theme" class="form-label"></label>
                                            <select asp-for="Theme" class="form-select">
                                                <option value="light" selected="@("light".Equals(Model?.Theme, StringComparison.OrdinalIgnoreCase))">Light</option>
                                                <option value="dark" selected="@("dark".Equals(Model?.Theme, StringComparison.OrdinalIgnoreCase))">Dark</option>
                                            </select>
                                            <span asp-validation-for="Theme" class="text-danger"></span>
                                        </div>

                                        <div class="col-md-8">
                                            <label asp-for="LogoUrl" class="form-label"></label>
                                            <div class="input-group">
                                                <span class="input-group-text">URL</span>
                                                <input asp-for="LogoUrl" class="form-control" placeholder="/uploads/logos/logo.png" />
                                            </div>
                                            <span class="form-text">Alternatif olarak aşağıdan dosya yükleyebilirsiniz.</span>
                                            <span asp-validation-for="LogoUrl" class="text-danger"></span>
                                        </div>

                                        <div class="col-md-6">
                                            <label asp-for="LogoFile" class="form-label"></label>
                                            <input asp-for="LogoFile" type="file" class="form-control" accept=".png,.jpg,.jpeg,.webp,.svg" />
                                            <span asp-validation-for="LogoFile" class="text-danger"></span>
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(Model?.LogoUrl))
                                        {
                                            <div class="col-12">
                                                <label class="form-label d-block">Önizleme</label>
                                                <img src="@Model.LogoUrl" alt="Logo" style="max-height:70px" />
                                            </div>
                                        }

                                        <div class="col-md-6">
                                            <label asp-for="MetaTitleSuffix" class="form-label"></label>
                                            <input asp-for="MetaTitleSuffix" class="form-control" placeholder=" | Marka Adı" />
                                            <span asp-validation-for="MetaTitleSuffix" class="text-danger"></span>
                                        </div>


                                        <div class="col-12">
                                            <label asp-for="DefaultMetaDescription" class="form-label"></label>
                                            <textarea asp-for="DefaultMetaDescription" class="form-control" rows="3" placeholder="Sitenizin genel açıklaması..."></textarea>
                                            <span asp-validation-for="DefaultMetaDescription" class="text-danger"></span>
                                        </div>
                                    </div>

                                    <div class="d-flex gap-2 mt-4">
                                        <button type="submit" class="btn btn-primary">Kaydet</button>
                                        <a href="/" class="btn btn-outline-secondary">İptal</a>
                                    </div>
                                </form>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>




@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

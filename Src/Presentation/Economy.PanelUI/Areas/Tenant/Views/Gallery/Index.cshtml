@using Economy.Panel.UI.Areas.Tenant.Models
@model List<MediaListItemVm>
@{
    ViewBag.Title = "Galeri";
    var pageId = (int)ViewBag.PageId;
}
<main>
    <div class="container-fluid">
@await Html.PartialAsync("_breadcrumbs")
        <div class="row m-1">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                            </div>
                            <div>
                                <div class="app-btn-list">
                                    <a class="btn btn-primary" asp-action="Index">Tüm Kayıtlar</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-12">
<div class="d-flex align-items-center justify-content-between mb-3">
    <h3>Galeri (Sayfa #@pageId)</h3>
    <a class="btn btn-primary" href="/tenant/gallery/create?pageId=@pageId">Yeni Medya</a>
</div>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>#</th>
            <th>Önizleme</th>
            <th>URL</th>
            <th>Alt</th>
            <th>Caption</th>
            <th>Sıra</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td>@r.Id</td>
                <td style="width:120px">
                    <img src="@r.Url" style="max-width:110px;max-height:70px;object-fit:cover;border-radius:4px" />
                </td>
                <td>@r.Url</td>
                <td>@r.Alt</td>
                <td>@r.Caption</td>
                <td>@r.SortOrder</td>
                <td class="text-end">
                    <form method="post" action="/tenant/gallery/delete/@r.Id?pageId=@pageId" onsubmit="return confirm('Silinsin mi?');">
                        @Html.AntiForgeryToken()
                        <button class="btn btn-sm btn-outline-danger">Sil</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<p>
    <a class="btn btn-light" href="/tenant/pages/edit/@pageId"> « Sayfaya Dön</a>
</p>
</div></div></div></main>
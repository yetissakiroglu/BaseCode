@model Economy.Panel.UI.Models.ReservationLinkViewModels.AppSettingReservationLinkEditViewModel

@{
    ViewData["Title"] = "Rezervasyon Linki Güncelle";
}

<main>
    <div class="container-fluid">
        @await Html.PartialAsync("_breadcrumbs")
        <!-- tables start  -->
        <div class="row">

            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                            </div>
                            <div>
                                <div class="app-btn-list">
                                    <a class="btn btn-primary" asp-action="Index">Tüm Kayıtlar</a>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
            <!-- Hoverable Table start -->
            <div class="col-xl-12">
                <div class="card">
                    <div class="card-header">
                        <h5> Kayıtlar </h5>
                        <p>
                            Aşağıda kayıtlı bilgiler bulunmaktadır.
                        </p>
                    </div>
                    <div class="card-body">

                        <div class="row p-2">
                            <div class="col-md-6 offset-md-3">
                                <form asp-action="Edit">
                                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                                    <input asp-for="Id" type="hidden" />

                                    <div class="form-group">
                                        <label asp-for="Url" class="control-label"></label>
                                        <input asp-for="Url" class="form-control" />
                                        <span asp-validation-for="Url" class="text-danger"></span>
                                    </div>
                                    <div class="form-group">
                                        <input type="submit" value="Save" class="btn btn-primary" />
                                    </div>
                                </form>

                            </div>
                        </div>




                    </div>
                </div>
            </div>
            <!-- Hoverable Table end -->


        </div>
        <!-- tables-end  -->
    </div>
</main>



@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

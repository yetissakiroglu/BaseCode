@using Economy.Application.Dtos.AppTechnicalSettingDtos
@model AppTechnicalSettingCreateEditDto
@{
    ViewData["Title"] = "Teknik Ayarlar";
    // Flags: None=0, Header=1, Footer=2  -> enum adları: Header, Footer
    bool hasHeader = (((int)Model.AllowedCustomScriptPlacements & 1) == 1);
    bool hasFooter = (((int)Model.AllowedCustomScriptPlacements & 2) == 2);
}



<main>
    <div class="container-fluid">
        <!-- Breadcrumb start -->
        @await Html.PartialAsync("_breadcrumbs")
        <!-- Breadcrumb end -->

        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                            </div>
                            <div>
                                <div class="app-btn-list">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Hoverable Table start -->
            <div class="col-xl-12">
                <div class="card">
                    <div class="card-header">
                        <h5> Kayıtlar </h5>
                        <p>
                            Aşağıda kayıtlı bilgiler bulunmaktadır.
                        </p>
                    </div>
                    <div class="card-body">
                        <div class="row p-2">
                            <div class="col-md-10 offset-md-1">

                                <div class="card">
                                    <div class="card-header d-flex justify-content-between align-items-center">
                                        <h5 class="mb-0">Teknik Ayarlar</h5>
                                        <a class="btn btn-sm btn-secondary" href="/">Siteyi Gör</a>
                                    </div>
                                    <div class="card-body">
                                        @if (TempData["Success"] != null)
                                        {
                                            <div class="alert alert-success">@TempData["Success"]</div>
                                        }
                                        @if (TempData["Error"] != null)
                                        {
                                            <div class="alert alert-danger">@TempData["Error"]</div>
                                        }

                                        <form asp-action="TechnicalSettings" method="post">
                                            @Html.AntiForgeryToken()

                                            <div class="row g-3">
                                                <div class="col-md-4">
                                                    <label class="form-label">Site yayında mı?</label>
                                                    <input class="form-check-input" type="checkbox" asp-for="IsSiteLive" />
                                                </div>
                                                <div class="col-md-4">
                                                    <label class="form-label">HTTPS Zorla (ForceSSL)</label>
                                                    <input class="form-check-input" type="checkbox" asp-for="ForceSSL" />
                                                </div>
                                                <div class="col-md-4">
                                                    <label class="form-label">CDN Aktif</label>
                                                    <input class="form-check-input" type="checkbox" asp-for="EnableCDN" />
                                                </div>

                                                <div class="col-md-6">
                                                    <label class="form-label">Domain</label>
                                                    <input class="form-control" asp-for="DomainName" placeholder="www.otelsitem.com">
                                                    <span class="text-danger" asp-validation-for="DomainName"></span>
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label">StaticFileUrl (CDN)</label>
                                                    <input class="form-control" asp-for="StaticFileUrl" placeholder="https://cdn.otelsitem.com">
                                                    <span class="text-danger" asp-validation-for="StaticFileUrl"></span>
                                                </div>

                                                <div class="col-md-4">
                                                    <label class="form-label">Debug Mod</label>
                                                    <input class="form-check-input" type="checkbox" asp-for="EnableDebugMode" />
                                                </div>
                                                <div class="col-md-4">
                                                    <label class="form-label">Cache Aktif</label>
                                                    <input class="form-check-input" type="checkbox" asp-for="EnableCache" />
                                                </div>
                                                <div class="col-md-4">
                                                    <label class="form-label">Bakımda IP Whitelist</label>
                                                    <input class="form-check-input" type="checkbox" asp-for="EnableMaintenanceIpWhitelist" />
                                                </div>

                                                <div class="col-12">
                                                    <label class="form-label">İzinli IP’ler (virgülle)</label>
                                                    <input class="form-control" asp-for="AllowedIpAddresses" placeholder="127.0.0.1,192.168.1.5">
                                                </div>

                                                <div class="col-12">
                                                    <label class="form-label">Bakım Mesajı (HTML destekli)</label>
                                                    <textarea class="form-control" asp-for="MaintenanceMessage" rows="3"></textarea>
                                                </div>

                                                <div class="col-12">
                                                    <label class="form-label">Custom CSS</label>
                                                    <textarea class="form-control font-monospace" asp-for="CustomCss" rows="4" placeholder="/* ek stiller */"></textarea>
                                                </div>

                                                <div class="col-12">
                                                    <label class="form-label">Custom JS</label>
                                                    <textarea class="form-control font-monospace" asp-for="CustomJs" rows="4" placeholder="// footer'da çalışır"></textarea>
                                                </div>

                                                <div class="col-md-6">
                                                    <label class="form-label">Google Analytics</label>
                                                    <input class="form-control" asp-for="GoogleAnalyticsCode" placeholder="G-XXXXXXX">
                                                    <span class="text-danger" asp-validation-for="GoogleAnalyticsCode"></span>
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label">Facebook Pixel</label>
                                                    <input class="form-control" asp-for="FacebookPixelCode" placeholder="FB-PIXEL">
                                                    <span class="text-danger" asp-validation-for="FacebookPixelCode"></span>
                                                </div>

                                                <!-- YENİ: Flags (Header/Footer) -->
                                                <div class="col-12">
                                                    <label class="form-label d-block mb-1">Özel Script İzinleri (Flags)</label>
                                                    <div class="form-check form-check-inline">
                                                        <input type="checkbox"
                                                               class="form-check-input script-flag"
                                                               id="flagHeader"
                                                               name="AllowedCustomScriptPlacements"
                                                               value="Header"
                                                               @(hasHeader ? "checked" : "") />
                                                        <label class="form-check-label" for="flagHeader">&lt;head&gt; (Header)</label>
                                                    </div>
                                                    <div class="form-check form-check-inline">
                                                        <input type="checkbox"
                                                               class="form-check-input script-flag"
                                                               id="flagFooter"
                                                               name="AllowedCustomScriptPlacements"
                                                               value="Footer"
                                                               @(hasFooter ? "checked" : "") />
                                                        <label class="form-check-label" for="flagFooter">&lt;/body&gt; öncesi (Footer)</label>
                                                    </div>
                                                    <small class="text-muted d-block mt-1">
                                                        Birden fazla seçebilirsiniz. Seçilmezse None (0) kabul edilir.
                                                    </small>
                                                </div>

                                                <div class="col-12">
                                                    <label class="form-label">Header Script (HTML/snippet)</label>
                                                    <textarea class="form-control font-monospace"
                                                              asp-for="CustomHeaderScripts"
                                                              id="CustomHeaderScripts"
                                                              rows="4"
                                                              placeholder="Örnek: meta verification, GA snippet vb."></textarea>
                                                    <span class="text-danger" asp-validation-for="CustomHeaderScripts"></span>
                                                </div>

                                                <div class="col-12">
                                                    <label class="form-label">Footer Script (HTML/snippet)</label>
                                                    <textarea class="form-control font-monospace"
                                                              asp-for="CustomFooterScripts"
                                                              id="CustomFooterScripts"
                                                              rows="4"
                                                              placeholder="Örnek: 3rd party widget init, izleme kodları vb."></textarea>
                                                    <span class="text-danger" asp-validation-for="CustomFooterScripts"></span>
                                                </div>
                                            </div>

                                            <div class="mt-4 d-flex gap-2">
                                                <button class="btn btn-primary" type="submit">Kaydet</button>
                                                <a class="btn btn-outline-secondary" asp-action="TechnicalSettings">Yenile</a>
                                            </div>
                                        </form>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- tables-end  -->
    </div>
</main>



@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            const chkHeader = document.getElementById('flagHeader');
            const chkFooter = document.getElementById('flagFooter');
            const txtHeader = document.getElementById('CustomHeaderScripts');
            const txtFooter = document.getElementById('CustomFooterScripts');

            function toggleInputs() {
                if (txtHeader) txtHeader.disabled = !chkHeader.checked;
                if (txtFooter) txtFooter.disabled = !chkFooter.checked;
            }

            if (chkHeader && chkFooter) {
                chkHeader.addEventListener('change', toggleInputs);
                chkFooter.addEventListener('change', toggleInputs);
                toggleInputs(); // ilk yüklemede uygula
            }
        })();
    </script>
}

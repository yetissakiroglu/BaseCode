@using Economy.Application.TenantUI.AppTechnicalSettingDtos

@model AppTechnicalSettingCreateEditDto
@{
    ViewData["Title"] = "Teknik Ayarlar";
}

<main>
    <div class="container-fluid">
        <!-- Breadcrumb start -->
        @await Html.PartialAsync("_breadcrumbs")
        <!-- Breadcrumb end -->

        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                            </div>
                            <div>
                                <div class="app-btn-list">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Hoverable Table start -->
            <div class="col-xl-12">
                <div class="card">
                    <div class="card-header">
                        <h5> Kayıtlar </h5>
                        <p>
                            Aşağıda kayıtlı bilgiler bulunmaktadır.
                        </p>
                    </div>
                    <div class="card-body">
                        <div class="row p-2">
                            <div class="col-md-8 offset-md-2">
                                <form asp-action="TechnicalSettings" method="post">
                                    @Html.AntiForgeryToken()
                                    @* Id gizli tutulabilir, Create için genelde gerekmez *@
                                    <input asp-for="Id" type="hidden" />

                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <label asp-for="DomainName" class="form-label"></label>
                                            <input asp-for="DomainName" class="form-control" placeholder="ornek.com" />
                                            <span asp-validation-for="DomainName" class="text-danger"></span>
                                        </div>

                                        <div class="col-md-6 d-flex align-items-center pt-4">
                                            <div class="form-check">
                                                <input asp-for="ForceSSL" class="form-check-input" />
                                                <label asp-for="ForceSSL" class="form-check-label"></label>
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <label asp-for="CdnBaseUrl" class="form-label"></label>
                                            <input asp-for="CdnBaseUrl" class="form-control" placeholder="https://cdn.ornek.com" />
                                            <span class="form-text">Boş bırakılırsa CDN kullanılmaz.</span>
                                            <span asp-validation-for="CdnBaseUrl" class="text-danger"></span>
                                        </div>

                                        <div class="col-md-6 d-flex align-items-center pt-4">
                                            <div class="form-check">
                                                <input asp-for="CdnEnabled" class="form-check-input" />
                                                <label asp-for="CdnEnabled" class="form-check-label"></label>
                                            </div>
                                        </div>

                                        <div class="col-md-6 d-flex align-items-center">
                                            <div class="form-check">
                                                <input asp-for="EnableDebugMode" class="form-check-input" />
                                                <label asp-for="EnableDebugMode" class="form-check-label"></label>
                                            </div>
                                        </div>

                                        <div class="col-md-6 d-flex align-items-center">
                                            <div class="form-check">
                                                <input asp-for="CookieBannerEnabled" class="form-check-input" />
                                                <label asp-for="CookieBannerEnabled" class="form-check-label"></label>
                                            </div>
                                        </div>

                                        <div class="col-12 d-flex align-items-center">
                                            <div class="form-check">
                                                <input asp-for="MaintenanceModeEnabled" class="form-check-input" id="chkMaintenance" />
                                                <label asp-for="MaintenanceModeEnabled" class="form-check-label"></label>
                                            </div>
                                        </div>

                                        <div class="col-md-12" id="maintenanceMessageWrap" style="display:none;">
                                            <label asp-for="MaintenanceMessage" class="form-label"></label>
                                            <textarea asp-for="MaintenanceMessage" class="form-control" rows="2" placeholder="Kısa bakım mesajı..."></textarea>
                                            <span asp-validation-for="MaintenanceMessage" class="text-danger"></span>
                                        </div>

                                        <div class="col-md-12" id="maintenanceIpWrap" style="display:none;">
                                            <label asp-for="MaintenanceAllowedIpListRaw" class="form-label"></label>
                                            <textarea asp-for="MaintenanceAllowedIpListRaw" class="form-control" rows="4"
                                                      placeholder="Her satıra bir IP (örn: 1.2.3.4)"></textarea>
                                            <span class="form-text">Bakım modunda sadece bu IP’ler siteyi görebilir.</span>
                                        </div>

                                        <div class="col-md-6">
                                            <label asp-for="EnableOutputCache" class="form-label d-block"></label>
                                            <div class="form-check form-switch">
                                                <input asp-for="EnableOutputCache" class="form-check-input" />
                                                <label class="form-check-label" for="EnableOutputCache">Aktif/Pasif</label>
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <label asp-for="OutputCacheTtlSeconds" class="form-label"></label>
                                            <input asp-for="OutputCacheTtlSeconds" type="number" min="0" class="form-control" />
                                            <span class="form-text">Saniye cinsinden (örn: 300 = 5 dk).</span>
                                            <span asp-validation-for="OutputCacheTtlSeconds" class="text-danger"></span>
                                        </div>
                                    </div>

                                    <hr class="my-4" />

                                    <div class="mt-4 text-end">
                                        <button class="btn btn-primary" type="submit">Kaydet</button>
                                        <a class="btn btn-outline-secondary" asp-action="TechnicalSettings">Yenile</a>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- tables-end  -->
    </div>
</main>



@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const chk = document.getElementById('chkMaintenance');
            const msg = document.getElementById('maintenanceMessageWrap');
            const ipw = document.getElementById('maintenanceIpWrap');

            function toggle() {
                const show = chk.checked;
                msg.style.display = show ? '' : 'none';
                ipw.style.display = show ? '' : 'none';
            }
            chk.addEventListener('change', toggle);
            toggle(); // sayfa yüklenince ilk durum
        })();
    </script>
}

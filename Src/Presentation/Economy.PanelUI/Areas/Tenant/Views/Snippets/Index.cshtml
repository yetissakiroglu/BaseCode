@model List<Economy.Panel.UI.Areas.Tenant.Models.SnippetListItemVm>
@{
    ViewBag.Title = "Snippets";
}
<main>
    <div class="container-fluid">
@await Html.PartialAsync("_breadcrumbs")
        <div class="row m-1">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                            </div>
                            <div>
                                <div class="app-btn-list">
                                    <a class="btn btn-primary" asp-action="Index">Tüm Kayıtlar</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-12">
<div class="d-flex align-items-center justify-content-between mb-3">
    <h3>Snippets</h3>
    <a class="btn btn-primary" href="/tenant/snippets/create">Yeni Snippet</a>
</div>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>#</th>
            <th>Code</th>
            <th>Aktif</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td>@r.Id</td>
                <td>@r.Code</td>
                <td>@(r.IsActive ? "Evet" : "Hayır")</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-secondary" href="/tenant/snippets/edit/@r.Id">Düzenle</a>
                </td>
            </tr>
        }
    </tbody>
</table>
</div></div></div></main>
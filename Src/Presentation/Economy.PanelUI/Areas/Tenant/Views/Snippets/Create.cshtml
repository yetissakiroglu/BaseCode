@model Economy.Panel.UI.Areas.Tenant.Models.SnippetEditVm
@{
    ViewBag.Title = "Yeni Snippet";
}
<main>
    <div class="container-fluid">
@await Html.PartialAsync("_breadcrumbs")
        <div class="row m-1">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                            </div>
                            <div>
                                <div class="app-btn-list">
                                    <a class="btn btn-primary" asp-action="Index">Tüm Kayıtlar</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-12">
<h3 class="mb-3">Yeni Snippet</h3>

<form method="post">
    @Html.AntiForgeryToken()

    <div class="card mb-3">
        <div class="card-header">Genel</div>
        <div class="card-body row g-3">
            <div class="col-md-6">
                <label class="form-label">Code</label>
                <input class="form-control" asp-for="Code" placeholder="PET_POLICY_NOTE" />
                <div class="form-text">Benzersiz olmalı. Örn: PET_POLICY_NOTE, MINI_BAR_NOTE</div>
            </div>
            <div class="col-md-3 d-flex align-items-center">
                <div class="form-check mt-4">
                    <input class="form-check-input" type="checkbox" asp-for="IsActive" />
                    <label class="form-check-label">Aktif</label>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">Çeviriler</div>
        <div class="card-body">
            <ul class="nav nav-tabs" role="tablist">
                @for (int i = 0; i < Model.Translations.Count; i++)
                {
                    var t = Model.Translations[i];
                    <li class="nav-item">
                        <button class="nav-link @(i == 0 ? "active" : null)" data-bs-toggle="tab" data-bs-target="#pane-@t.LanguageCode">@t.LanguageCode.ToUpper()</button>
                    </li>
                }
            </ul>
            <div class="tab-content border border-top-0 p-3">
                @for (int i = 0; i < Model.Translations.Count; i++)
                {
                    var t = Model.Translations[i];
                    <div class="tab-pane fade show @(i == 0 ? "active" : null)" id="pane-@t.LanguageCode">
                        <input type="hidden" name="Translations[@i].LanguageId" value="@t.LanguageId" />
                        <input type="hidden" name="Translations[@i].LanguageCode" value="@t.LanguageCode" />

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Başlık (opsiyonel)</label>
                                <input class="form-control" name="Translations[@i].Title" value="@t.Title" />
                            </div>
                            <div class="col-md-12">
                                <label class="form-label">Metin</label>
                                <textarea class="form-control" name="Translations[@i].Body" rows="4">@t.Body</textarea>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="d-flex gap-2">
        <button class="btn btn-primary" type="submit">Kaydet</button>
        <a class="btn btn-light" href="/tenant/snippets">Vazgeç</a>
    </div>
</form>
</div></div></div></main>
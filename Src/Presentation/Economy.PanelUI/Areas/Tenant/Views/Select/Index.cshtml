@using static Economy.Panel.UI.Areas.Tenant.Controllers.SelectController
@model IEnumerable<Vm>
@{
    ViewData["Title"] = "Otel Seç";
}
<h3>Yönetmek istediğiniz oteli seçin</h3>

<form method="post" class="mt-3">
    <div class="list-group">
        @foreach (var t in Model)
        {
            <label class="list-group-item d-flex align-items-center">
                <input type="radio" name="appId" value="@t.AppId" class="form-check-input me-2" />
                <span>
                    <strong>@t.Name</strong>
                    @if (!string.IsNullOrWhiteSpace(t.Domain))
                    {
                        <span class="text-muted"> (@t.Domain) </span>
                    }
                </span>
            </label>
        }
    </div>
    <button type="submit" class="btn btn-primary mt-3">Devam Et</button>
</form>

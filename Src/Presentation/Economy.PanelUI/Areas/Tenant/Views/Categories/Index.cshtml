@using Economy.Panel.UI.Models.CategoryViewModels
@model IEnumerable<AppCategoryListViewModel>

@{
    ViewData["Title"] = "Slide Listesi";
}

<main>
    <div class="container-fluid">
        @await Html.PartialAsync("_breadcrumbs")
        <!-- tables start  -->
        <div class="row table-section">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                            </div>
                            <div>
                                <div class="app-btn-list">
                                    <a class="btn btn-primary" asp-action="Create">Yeni Ekle</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Hoverable Table start -->
            <div class="col-xl-12">
                <div class="card">
                    <div class="card-header">
                        <h5> Kayıtlar </h5>
                        <p>
                            Aşağıda kayıtlı bilgiler bulunmaktadır.
                        </p>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-bottom-border table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>
                                            @Html.DisplayNameFor(model => model.Id)
                                        </th>
                                        <th>
                                            @Html.DisplayNameFor(model => model.Translations.FirstOrDefault(w => w.LanguageIsDefault).Title)
                                        </th>
                 
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.Id)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.Translations.FirstOrDefault(w => w.LanguageIsDefault).Title)
                                            </td>
                                            
                                            <td>
                                                @Html.ActionLink("Güncelle", "Edit", new { id = item.Id }) |
                                                @Html.ActionLink("İncele", "Details", new { id = item.Id })
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Hoverable Table end -->
        </div>
        <!-- tables-end  -->
    </div>
</main>





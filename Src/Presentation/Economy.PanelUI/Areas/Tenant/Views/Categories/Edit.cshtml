@model Economy.Panel.UI.Models.CategoryViewModels.AppCategoryCreateEditViewModel

@{
    ViewData["Title"] = "Kategori Güncelleme";
}


<main>
    <div class="container-fluid">
        @await Html.PartialAsync("_breadcrumbs")
        <div class="row m-1">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                            </div>
                            <div>
                                <div class="app-btn-list">
                                    <a class="btn btn-primary" asp-action="Index">Tüm Kayıtlar</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-12">
                <form asp-action="Edit" method="post" class="app-form rounded-control needs-validation" novalidate>
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="ContentType" />
                    <input type="hidden" asp-for="ParentCategoryId" />

                    <div class="card equal-card">
                        <div class="card-header">
                            <h5>Slider Çevirileri</h5>
                            <p>Her dil için çevirileri aşağıdan düzenleyebilirsiniz.</p>
                        </div>
                        <div class="card-body">
                            <ul class="nav nav-tabs tab-light-secondary" role="tablist">
                                @for (int i = 0; i < Model.Translations.Count; i++)
                                {
                                    var t = Model.Translations[i];
                                    var isActive = i == 0 ? "active" : "";
                                    <li class="nav-item" role="presentation">
                                        <button class="nav-link gap-2 @isActive"
                                                id="lang-tab-@i"
                                                data-bs-toggle="tab"
                                                data-bs-target="#lang-tab-pane-@i"
                                                type="button"
                                                role="tab"
                                                aria-selected="@(i == 0 ? "true" : "false")">
                                            <i class="@t.LanguageIcon?.ToLower()"></i> @t.LanguageName
                                        </button>
                                    </li>
                                }
                            </ul>

                            <div class="tab-content">

                                @for (int i = 0; i < Model.Translations.Count; i++)
                                {
                                    var t = Model.Translations[i];
                                    var isActive = i == 0 ? "show active" : "";
                                    <div class="tab-pane fade @isActive" id="lang-tab-pane-@i" role="tabpanel" aria-labelledby="lang-tab-@i">
                                        <input type="hidden" name="Translations[@i].Id" value="@t.Id" />
                                        <input type="hidden" name="Translations[@i].AppLanguageId" value="@t.AppLanguageId" />
                                        <input type="hidden" name="Translations[@i].LanguageName" value="@t.LanguageName" />
                                        <input type="hidden" name="Translations[@i].LanguageIcon" value="@t.LanguageIcon" />
                                        <input type="hidden" name="Translations[@i].AppCategoryId" value="@t.AppCategoryId" />


                                        <div class="form-group mb-3">
                                            <label>Başlık</label>
                                            <input class="form-control" name="Translations[@i].Title" value="@t.Title" />
                                            <span asp-validation-for="Translations[@i].Title" class="text-danger"></span>
                                        </div>


                                        <div class="form-group">
                                            <label asp-for="Translations[@i].Title" class="control-label"></label>
                                            <input asp-for="Translations[@i].Url" class="form-control" />
                                            <span asp-validation-for="Translations[@i].Url" class="text-danger"></span>
                                        </div>
                                        <div class="form-group">
                                            <label asp-for="Translations[@i].ShortDescription" class="control-label"></label>
                                            <input asp-for="Translations[@i].ShortDescription" class="form-control" />
                                            <span asp-validation-for="Translations[@i].ShortDescription" class="text-danger"></span>
                                        </div>
                                        <div class="form-group">
                                            <label asp-for="Translations[@i].Content" class="control-label"></label>
                                            <input asp-for="Translations[@i].Content" class="form-control" />
                                            <span asp-validation-for="Translations[@i].Content" class="text-danger"></span>
                                        </div>
                                        <div class="form-group">
                                            <label asp-for="Translations[@i].MetaTitle" class="control-label"></label>
                                            <input asp-for="Translations[@i].MetaTitle" class="form-control" />
                                            <span asp-validation-for="Translations[@i].MetaTitle" class="text-danger"></span>
                                        </div>
                                        <div class="form-group">
                                            <label asp-for="Translations[@i].MetaDescription" class="control-label"></label>
                                            <input asp-for="Translations[@i].MetaDescription" class="form-control" />
                                            <span asp-validation-for="Translations[@i].MetaDescription" class="text-danger"></span>
                                        </div>




                                    </div>
                                }



                            </div>

                            <hr />
                            <div class="mt-3 text-end">
                                <button type="submit" class="btn btn-success">Güncelle</button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }  


}

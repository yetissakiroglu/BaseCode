@using Economy.Core.Core
@model IReadOnlyList<ImageItemDto>
@{
    ViewData["Title"] = "Resim Yönetimi";
    var dir = (string)(ViewBag.CurrentDir ?? "");
    var publicBase = (string)(ViewBag.PublicBase ?? "/uploads/images");
}
<main>
    <div class="container-fluid">
        @await Html.PartialAsync("_breadcrumbs")
        <!-- Breadcrumb -->
       @*  <nav aria-label="breadcrumb" class="mb-2">
            <ol class="breadcrumb">
                @foreach (var c in (List<(string label, string? path)>)ViewBag.Breadcrumb)
                {
                    if (c.path == (string)ViewBag.CurrentDir)
                    {
                        <li class="breadcrumb-item active" aria-current="page">@c.label</li>
                    }
                    else
                    {
                        <li class="breadcrumb-item"><a asp-action="Index" asp-route-dir="@c.path">@c.label</a></li>
                    }
                }
            </ol>
        </nav>
 *@
        <!-- Arama -->
        <form method="get" class="row g-2 align-items-center mb-3">
            <input type="hidden" name="dir" value="@dir" />
            <div class="col-auto">
                <input type="text" class="form-control" name="q" value="@((string)ViewBag.Query)" placeholder="Dosya adı ara..." />
            </div>
            <div class="col-auto">
                <button class="btn btn-outline-secondary" type="submit">Ara</button>
            </div>
        </form>

        <div class="row">
            <aside class="col-md-3">
                <div class="list-group mb-3">
                    <a class="list-group-item list-group-item-action @(string.IsNullOrEmpty(dir) ? "active" : "")"
                       asp-action="Index" asp-route-dir="">/ (Root)</a>

                    @foreach (var folder in (IReadOnlyList<string>)ViewBag.Dirs)
                    {
                        var next = string.IsNullOrEmpty(dir) ? folder : $"{dir}/{folder}";
                        <a class="list-group-item list-group-item-action"
                           asp-action="Index" asp-route-dir="@next">@folder</a>
                    }
                </div>
                <div class="small text-muted">Not: Yüklemeler varsayılan olarak <code>yyyy/MM</code> dizinine düşer.</div>
            </aside>

            <section class="col-md-9">
                <form id="uploadForm" method="post" enctype="multipart/form-data" class="border rounded p-3 my-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="dir" value="@dir" />

                    <div class="d-flex align-items-center gap-2 mb-2">
                        <label class="form-label m-0">Kırpma oranı:</label>
                        <select id="aspectSelect" class="form-select form-select-sm" style="width:auto">
                            <option value="">Serbest</option>
                            <option value="1:1">1:1</option>
                            <option value="4:3">4:3</option>
                            <option value="16:9" selected>16:9</option>
                        </select>
                    </div>

                    <!-- Drop alanı (Bootstrap 5 görünüm) -->
                    <div id="dropArea" class="border border-2 border-secondary rounded p-4 text-center bg-light mb-3" style="cursor:pointer;">
                        <p class="mb-0">📂 Resimleri buraya sürükleyip bırak <b>veya</b> tıklayarak seç</p>
                        <input type="file" id="fileInput" name="files" multiple accept=".jpg,.jpeg,.png,.webp,.gif" hidden />
                    </div>

                    <!-- Sayfa içi küçük durum kutusu (isteğe bağlı) -->
                    <div id="uploadStatus" class="mt-3" style="display:none;">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                            <span>Yükleniyor...</span>
                        </div>
                        <div class="progress w-100">
                            <div id="uploadProgress" class="progress-bar progress-bar-striped progress-bar-animated bg-primary" role="progressbar" style="width:0%">0%</div>
                        </div>
                    </div>

                    <!-- Tam ekran overlay (arkada koyu siyah, ortada spinner+progress) -->
                    <div id="loadingOverlay" style="
  position:fixed; inset:0; display:none; z-index:2000;
  background:rgba(0,0,0,.6); backdrop-filter: blur(1px);
  align-items:center; justify-content:center; flex-direction:column;">
                        <div class="spinner-border text-light mb-3" role="status" style="width:3rem; height:3rem;">
                            <span class="visually-hidden">Yükleniyor...</span>
                        </div>
                        <div class="progress w-50">
                            <div id="overlayProgress" class="progress-bar progress-bar-striped progress-bar-animated bg-info" role="progressbar" style="width:0%">0%</div>
                        </div>
                    </div>

                  @*   <div id="dropArea" class="border border-2 border-secondary rounded p-4 text-center bg-light mb-3" style="cursor:pointer;">
                        <p class="mb-0">📂 Resimleri buraya sürükleyip bırak veya tıklayarak seç</p>
                        <input type="file" id="fileInput" name="files" multiple accept=".jpg,.jpeg,.png,.webp,.gif" hidden />
                    </div> *@

             @*        <div id="dropZone" class="p-5 text-center" style="border:2px dashed #ccc; border-radius:8px;">
                        <p class="m-0">Resimleri buraya <b>sürükleyip bırak</b> veya</p>
                        <div class="mt-2">
                            <input type="file" name="files" id="fileInput" multiple accept=".jpg,.jpeg,.png,.webp,.gif" class="form-control" />
                        </div>
                    </div> *@
                </form>

                <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 g-3 mt-2">
                    @foreach (var it in Model)
                    {
                        var url = $"{publicBase}/{it.RelativePath}";
                        <div class="col">
                            <div class="card h-100">
                                <img src="@url" class="card-img-top" alt="@it.Name" loading="lazy" />
                                <div class="card-body p-2">
                                    <div class="small text-truncate" title="@it.Name">@it.Name</div>
                                    <div class="text-muted small">@string.Format("{0:N0} B", it.SizeBytes)</div>
                                </div>
                                <div class="card-footer p-2 d-flex justify-content-between">
                                    <a class="btn btn-sm btn-outline-primary show-btn" data-url="@url" href="#">Göster</a>

@*                                     <a class="btn btn-sm btn-outline-primary" href="@url" target="_blank">Göster</a>
 *@                                    <form asp-action="Delete" method="post" onsubmit="return confirm('Silinsin mi?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="path" value="@it.RelativePath" />
                                        <input type="hidden" name="dir" value="@dir" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </section>
        </div>

        <!-- Resim Önizleme Modal -->
        <div class="modal fade" id="imgModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="imgTitle">Resim Önizleme</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body text-center">
                        <img id="imgModalSrc" src="" alt="" class="img-fluid rounded shadow" />
                    </div>
                    <div class="modal-footer">
                        <a id="imgFullLink" href="#" target="_blank" class="btn btn-primary">Tam Boy Aç</a>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Resim Popup -->
        <div id="imgPopup" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%;
     background:rgba(0,0,0,.8); z-index:9999; justify-content:center; align-items:center;">
            <img id="popupImg" src="" alt="" style="max-width:50%; max-height:50%; border:4px solid #fff; border-radius:8px;" />
        </div>

    </div>
</main>


@section Scripts {
    <script>
        // Elemanlar
        const dropArea      = document.getElementById('dropArea');
        const fileInput     = document.getElementById('fileInput');
        const statusDiv     = document.getElementById('uploadStatus');
        const progressBar   = document.getElementById('uploadProgress');
        const overlay       = document.getElementById('loadingOverlay');
        const overlayBar    = document.getElementById('overlayProgress');

        // (Önemli) Sayfa geneli drop'u devre dışı bırak (dosya tarayıcıda açılmasın)
        ['dragenter','dragover','dragleave','drop'].forEach(evt => {
          document.addEventListener(evt, e => {
            e.preventDefault(); e.stopPropagation();
          });
        });

        // Drop alanına tıkla → dosya seç
        dropArea.addEventListener('click', () => fileInput.click());

        // Drop alanı hover efekti
        ['dragenter','dragover'].forEach(evt=>{
          dropArea.addEventListener(evt, e=>{
            dropArea.classList.add('border-primary', 'bg-white');
          });
        });
        ['dragleave','drop'].forEach(evt=>{
          dropArea.addEventListener(evt, e=>{
            dropArea.classList.remove('border-primary', 'bg-white');
          });
        });

        // Dosya bırakma
        dropArea.addEventListener('drop', e => {
          const files = filterImages(e.dataTransfer?.files);
          if (!files.length) return;
          fileInput.files = files; // seçim durumunu da güncelle
          uploadFiles(files);
        });

        // Dosya seçilince otomatik yükle
        fileInput.addEventListener('change', () => {
          const files = filterImages(fileInput.files);
          if (files.length > 0) uploadFiles(files);
        });

        // Sadece resimleri kabul et (güvenlik için ince süzgeç)
        function filterImages(fileList) {
          if (!fileList || !fileList.length) return [];
          return Array.from(fileList).filter(f =>
            /^image\//i.test(f.type) || /\.(jpe?g|png|webp|gif)$/i.test(f.name)
          );
        }

        async function uploadFiles(files) {
          const fd = new FormData();
          for (const f of files) fd.append('files', f);

          // (Varsa) kırpma oranı alanı
          const aspect = document.getElementById('aspectSelect')?.value ?? "";
          fd.append('aspect', aspect);

          // Anti-forgery token (Form içinde __RequestVerificationToken input’u olmalı)
          const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

          // UI: hem küçük status’u hem overlay’i gösterebilirsin. Sadece overlay yetiyorsa statusDiv’i kaldır.
          statusDiv.style.display = 'block';
          progressBar.style.width = '0%';
          progressBar.textContent = '0%';

          overlay.style.display   = 'flex';
          overlayBar.style.width  = '0%';
          overlayBar.textContent  = '0%';

          const xhr = new XMLHttpRequest();
          xhr.open('POST', '/Tenant/ImageManager/UploadAjax'); // ← senin Area yolun
          xhr.setRequestHeader('RequestVerificationToken', token);

          // Yükleme ilerlemesi
          xhr.upload.addEventListener('progress', e => {
            if (e.lengthComputable) {
              const percent = Math.round((e.loaded / e.total) * 100);
              progressBar.style.width = percent + '%';
              progressBar.textContent = percent + '%';

              overlayBar.style.width  = percent + '%';
              overlayBar.textContent  = percent + '%';
            }
          });

          // Başarılı bitti
          xhr.onload = () => {
            statusDiv.style.display = 'none';
            overlay.style.display   = 'none';

            if (xhr.status === 200) {
              // İstersen JSON cevap okuyup dinamik ekleme yapabilirsin:
              // const resp = JSON.parse(xhr.responseText);
              // resp.urls.forEach(url => addCard(url));
              location.reload();
            } else {
              alert('Yükleme başarısız!');
            }
          };

          // Hata/iptal
          xhr.onerror = xhr.onabort = () => {
            statusDiv.style.display = 'none';
            overlay.style.display   = 'none';
            alert('Bağlantı hatası veya yükleme iptal edildi.');
          };

          xhr.send(fd);
        }

         document.querySelectorAll('.show-btn').forEach(btn=>{
          btn.addEventListener('click', e=>{
            e.preventDefault();
            const url  = btn.getAttribute('data-url');
            const name = btn.getAttribute('data-name');

            document.getElementById('imgModalSrc').src = url;
            document.getElementById('imgTitle').textContent = name;
            document.getElementById('imgFullLink').href = url;

            const modal = new bootstrap.Modal(document.getElementById('imgModal'));
            modal.show();
          });
        });
    </script>
}

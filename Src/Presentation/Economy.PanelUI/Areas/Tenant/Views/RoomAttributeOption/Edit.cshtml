@using Economy.Application.TenantUI.Dtos
@model RoomAttributeOptionEditVm

@{
    var isNew = Model.Id is null;
    ViewData["Title"] = isNew ? "Yeni Seçenek" : "Seçenek Düzenle";
}
<main>
    <div class="container-fluid">
        <!-- Breadcrumb start -->
        @await Html.PartialAsync("_breadcrumbs")
        <!-- Breadcrumb end -->
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    @(isNew ? "Yeni Seçenek Ekle" : "Seçenek Düzenle")
                </h5>
                <a asp-action="Index"
                   asp-route-attributeId="@Model.DefRoomAttributeId"
                   class="btn btn-sm btn-outline-secondary">
                    Geri
                </a>
            </div>

            <div class="card-body">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.Id)
                    @Html.HiddenFor(m => m.DefRoomAttributeId)
                    @Html.HiddenFor(m => m.AttributeCode)

                    <div class="row g-3">

                        <div class="col-md-4">
                            <label class="form-label">Özellik Kodu</label>
                            <input class="form-control" value="@Model.AttributeCode" readonly />
                            <div class="form-text">
                                Bu seçenek, <strong>@Model.AttributeCode</strong> özelliğine bağlıdır.
                            </div>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Value (Sistem Kodu)</label>
                            <input asp-for="Value" class="form-control" />
                            <span asp-validation-for="Value" class="text-danger"></span>
                            <div class="form-text">
                                Örn: <code>STANDARD</code>, <code>DELUXE</code>, <code>SEA</code> gibi.
                            </div>
                        </div>

                        <div class="col-md-2">
                            <label class="form-label">Sıra</label>
                            <input asp-for="SortOrder" class="form-control" type="number" />
                            <span asp-validation-for="SortOrder" class="text-danger"></span>
                        </div>

                        <div class="col-md-2 d-flex align-items-end">
                            <div class="form-check">
                                <input asp-for="IsActive" class="form-check-input" />
                                <label class="form-check-label" for="IsActive">Aktif</label>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <ul class="nav nav-tabs tab-light-secondary" role="tablist">
                                @for (int i = 0; i < Model.Translations.Count; i++)
                                {
                                    var t = Model.Translations[i];
                                    var code = (t.AppLanguageCode ?? "xx").ToLower();       // güvenli
                                    var tabId = $"tab-{code}-{i}";                        // benzersiz
                                    var paneId = $"pane-{code}-{i}";                      // benzersiz
                                                                                          <li class="nav-item" role="presentation">
                                                                                              <button class="gap-2 nav-link @(i == 0 ? "active" : null)"
                                                                                                      id="@tabId"
                                                                                                      type="button"
                                                                                                      role="tab"
                                                                                                      data-bs-toggle="tab"
                                                                                                      data-bs-target="#@paneId"
                                                                                                      aria-controls="@paneId"
                                                                                                      aria-selected="@(i == 0 ? "true" : "false")">
                                                                                                  <i class="@t.AppLanguageIcon?.ToLower()"></i>
                                                                                                  @t.AppLanguageCode?.ToUpper()
                                                                                              </button>
                                                                                          </li>
                                }
                            </ul>
                            <div class="tab-content pt-3">
                                @for (int i = 0; i < Model.Translations.Count; i++)
                                {
                                    var t = Model.Translations[i];
                                    var code = (t.AppLanguageCode ?? "xx").ToLower();
                                    var tabId = $"tab-{code}-{i}";
                                    var paneId = $"pane-{code}-{i}";

                                    <div id="@paneId" class="tab-pane fade @(i == 0 ? "show active" : null)" role="tabpanel" aria-labelledby="@tabId">
                                        <input type="hidden" name="Translations[@i].AppLanguageId" value="@t.AppLanguageId" />
                                        <input type="hidden" name="Translations[@i].AppLanguageCode" value="@t.AppLanguageCode" />
                                        <input type="hidden" name="Translations[@i].AppLanguageIcon" value="@t.AppLanguageIcon" />
                                        <input type="hidden" name="Translations[@i].Id" value="@t.Id" />

                                        <div class="row">
                                            <div class="col-md-6 mb-2">
                                                <div class="row">
                                                    <div class="col-md-12 mb-2">
                                                        <label class="form-label fw-semibold">Meta Title</label>
                                                        <input class="form-control" name="Translations[@i].DisplayName" value="@t.DisplayName" />
                                                    </div>
                       

                                                </div>
                                            </div>
                                        </div>

                                    </div>
                                }
                            </div>
                        </div>

                
                    </div>

                    <div class="mt-4 d-flex justify-content-between">
                        <button type="submit" class="btn btn-primary">
                            Kaydet
                        </button>

                        <a asp-action="Index"
                           asp-route-attributeId="@Model.DefRoomAttributeId"
                           class="btn btn-outline-secondary">
                            Vazgeç
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</main>



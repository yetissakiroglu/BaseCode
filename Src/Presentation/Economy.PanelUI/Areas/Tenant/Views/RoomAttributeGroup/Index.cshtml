@using Economy.Application.TenantUI.Dtos
@model List<RoomAttributeGroupListVm>



<main>
    <div class="container-fluid">
        <!-- Breadcrumb start -->
        @await Html.PartialAsync("_breadcrumbs")
        <!-- Breadcrumb end -->
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Oda Özellikleri</h5>
                <a asp-action="Create" class="btn btn-sm btn-primary">Yeni Özellik Grubu Ekle</a>
            </div>

            <div class="card-body">
                <table class="table table-sm table-striped align-middle">
                    <thead>
                        <tr>
                            <th>Ad</th>
                            <th>Durum</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Name </td>
                                <td>@(item.IsActive ? "Evet" : "Hayır")</td>
                                <td class="text-end">
                                    <a asp-area="Tenant" asp-controller="RoomAttribute" asp-action="Index"
                                       asp-route-attributeGroupId="@item.Id"
                                       class="btn btn-sm btn-outline-info">
                                        Özellikler
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Düzenle</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</main>

@using Economy.Panel.UI.Areas.Tenant.Controllers
@model dynamic
@{
    var sh = (BlockEditorController.HeroSharedVm)ViewBag.Shared;
    int pageBlockId = (int)ViewBag.PageBlockId;
    int languageId = (int)ViewBag.LanguageId;
}
<main>
    <div class="container-fluid">
@await Html.PartialAsync("_breadcrumbs")

<h4>Hero Editor</h4>
<form method="post" action="@Url.Action("SavePageBlock","BlockEditor", new { area="Tenant", pageBlockId, languageId })">
    @Html.AntiForgeryToken()
    <input type="hidden" name="type" value="Hero" />
    <div class="row g-3">
        <div class="col-md-3">
            <label class="form-label">Vertical Align</label>

            @{
                //Todo Block
                var t = sh.VerticalAlign == "top" ? "selected" : "";
                var y = sh.VerticalAlign == "center" ? "selected" : "";
                var z = sh.VerticalAlign == "bottom" ? "selected" : "";
            }

            <select class="form-select" name="VerticalAlign">
                <option value="top">top</option>
                <option value="center">center</option>
                <option value="bottom">bottom</option>
            </select>
            @* <select class="form-select" name="VerticalAlign">
        <option value="top" @(sh.VerticalAlign=="top"?"selected":"")>top</option>
        <option value="center" @(sh.VerticalAlign=="center"?"selected":"")>center</option>
        <option value="bottom" @(sh.VerticalAlign=="bottom"?"selected":"")>bottom</option>
      </select> *@
        </div>
        <div class="col-md-6">
            <label class="form-label">Background Url</label>
            <input class="form-control" name="BackgroundUrl" value="@sh.BackgroundUrl" />
        </div>
        <div class="col-12"><hr /></div>
        <div class="col-md-6">
            <label class="form-label">Heading</label>
            <input class="form-control" name="Heading" value="@Model.Heading" />
        </div>
        <div class="col-md-6">
            <label class="form-label">SubHeading</label>
            <input class="form-control" name="SubHeading" value="@Model.SubHeading" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Button Text</label>
            <input class="form-control" name="ButtonText" value="@Model.ButtonText" />
        </div>
        <div class="col-md-5">
            <label class="form-label">Button Url</label>
            <input class="form-control" name="ButtonUrl" value="@Model.ButtonUrl" />
        </div>
    </div>
    <div class="mt-3">
        <button class="btn btn-primary">Save</button>
        <a class="btn btn-outline-secondary" href="@Url.Action("Edit", "PageBlocks", new { area = "Tenant", id = pageBlockId })">Back</a>
    </div>
</form>
</div></main>
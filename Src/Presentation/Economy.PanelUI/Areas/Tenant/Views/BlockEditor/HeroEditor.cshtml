@using Economy.Core.Enums
@using Economy.Panel.UI.Areas.Tenant.Models
@model HeroLocVm
@{
    var shared = ViewBag.Shared as HeroSharedVm ?? new HeroSharedVm();

    // Controller’dan gelenler
    int langId = ViewBag.LanguageId is int lid ? lid : 0;
    int pageBlockId = ViewBag.PageBlockId is int pbid ? pbid : 0;

    // İsteğe bağlı: Controller ViewBag.LanguageName da yollar ise onu göster
    string? langName = ViewBag.LanguageName as string;
    string langBadge = !string.IsNullOrWhiteSpace(langName) ? langName : $"Dil ID: {langId}";

    ViewData["Title"] = "Hero Editor";
}

<main>
    <div class="container-fluid">
        @await Html.PartialAsync("_breadcrumbs")
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                            </div>
                            <div>
                                <div class="app-btn-list">
                                    <a href="/tenant/blocks/editblock?blockId=@pageBlockId" class="btn btn-primary">← Geri</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-12">

                <form asp-action="SaveBlockEditor" asp-controller="BlockEditor" asp-area="Tenant" method="post">
                    @Html.AntiForgeryToken()

                    <input type="hidden" name="PageBlockId" value="@pageBlockId" />
                    <input type="hidden" name="LanguageId" value="@langId" />
                    <input type="hidden" name="type" value="@((int)BlockType.Hero)" />

                    <div class="card">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <strong>Hero</strong>
                            <span class="badge bg-primary">@langBadge</span>
                        </div>

                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="form-label">Arkaplan URL</label>
                                    @await Html.PartialAsync("PartialViews/_ImageUrlEditor", shared.BackgroundUrl, new ViewDataDictionary(ViewData)
                                    {
                                        { "NamePrefix", "Shared.BackgroundUrl" },
                                                                        { "FormId", "mainForm" },
                                                                        { "PickerUrl", "/Tenant/ImageManager/Picker" }
                                    })

                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Dikey Hizalama</label>
                                    <select class="form-select" name="Shared.VerticalAlign">
                                        @{
                                            var va = shared.VerticalAlign ?? "center";
                                            string Opt(string v) => $"<option value=\"{v}\" {(va == v ? "selected" : "")}>{v}</option>";
                                        }
                                        @Html.Raw(Opt("top"))
                                        @Html.Raw(Opt("center"))
                                        @Html.Raw(Opt("bottom"))
                                    </select>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label">Başlık (heading)</label>
                                    <input class="form-control" asp-for="Heading" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Alt Başlık (subHeading)</label>
                                    <input class="form-control" asp-for="SubHeading" />
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label">Buton Metni (buttonText)</label>
                                    <input class="form-control" asp-for="ButtonText" />
                                </div>
                                <div class="col-md-8">
                                    <label class="form-label">Buton URL (buttonUrl)</label>
                                    <input class="form-control" asp-for="ButtonUrl" />
                                </div>
                            </div>
                        </div>

                        <div class="card-footer d-flex justify-content-between">
                            <button type="button" class="btn btn-outline-secondary" onclick="history.back()">← Geri</button>
                            <button type="submit" class="btn btn-primary">Güncelle</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</main>

@using Economy.Application.TenantUI.Dtos.AppMenuDtos
@using Economy.Panel.Application.Dtos.AppLanguageDtos
@model MenuItemDto

@{
    ViewData["Title"] = "Menu Yönetimi";
    var tree = ViewBag.Tree as List<MenuNodeDto> ?? new();
    var languages = ViewBag.Languages as List<AppLanguageDto> ?? new();
}



<main>
    <div class="container-fluid">
        <!-- Breadcrumb start -->
        @await Html.PartialAsync("_breadcrumbs")
        <!-- Breadcrumb end -->

        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                            </div>
                            <div>
                                <div class="app-btn-list">

                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <h4 class="mb-0">Menu Settings</h4>
                                        <form method="get" class="d-flex gap-2">
                                            <label class="col-form-label">Location:</label>
                                            <input type="text" name="location" value="@Model.Location" class="form-control" style="width:160px" />
                                            <button class="btn btn-outline-secondary" type="submit">Yükle</button>
                                        </form>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Hoverable Table start -->
            <div class="col-xl-12">
                <div class="card">
                    <div class="card-header">
                        <h5> Kayıtlar </h5>
                        <p>
                            Aşağıda kayıtlı bilgiler bulunmaktadır.
                        </p>
                    </div>
                    <div class="card-body">
                        <div class="row p-2">
                            <div class="col-lg-12">
                                <ul class="list-group menu-level" id="menu-root">
                                    @foreach (var root in tree.OrderBy(x => x.SortOrder))
                                    {
                                        @Html.Partial("_MenuNode", root)
                                    }
                                </ul>
                                <small class="text-muted d-block mt-2">
                                    Not: Bir öğeyi başka bir öğenin üstüne bırakırsanız, o öğenin altına taşınır (ParentId).
                                </small>
                            </div>





                            <div class="col-lg-12">
                                <div class="card">
                                    <div class="card-header">Yeni / Düzenle</div>
                                    <div class="card-body">
                                        <form asp-action="Save" method="post">
                                            @Html.AntiForgeryToken()
                                            @await Html.PartialAsync("_Form", Model)
                                            <div class="mt-3">
                                                <button class="btn btn-primary" type="submit">Kaydet</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- tables-end  -->
    </div>
</main>




@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>
    <script>
        function makeSortable(el){
          new Sortable(el, {
            group: 'menus',
            animation: 150,
            fallbackOnBody: true,
            swapThreshold: 0.65,
            onEnd: debounce(saveOrder, 500)
          });
        }
        function initSortables(){
          document.querySelectorAll('ul.menu-level').forEach(makeSortable);
        }
        function debounce(fn, delay){ let t; return function(){ clearTimeout(t); t=setTimeout(()=>fn.apply(this,arguments), delay); } }

        async function saveOrder(){
          const items = [];
          document.querySelectorAll('li[data-node-id]').forEach(li => {
            const id = parseInt(li.dataset.nodeId);
            const parentLi = li.parentElement.closest('li[data-node-id]');
            const parentId = parentLi ? parseInt(parentLi.dataset.nodeId) : null;
            const siblings = Array.from(li.parentElement.children);
            const sortOrder = siblings.indexOf(li);
            items.push({ id, parentId, sortOrder });
          });
          const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
          const res = await fetch('@Url.Action("Reorder")', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
            body: JSON.stringify({ items })
          });
          if(!res.ok){ console.warn('Reorder failed'); }
        }
        initSortables();
    </script>
}

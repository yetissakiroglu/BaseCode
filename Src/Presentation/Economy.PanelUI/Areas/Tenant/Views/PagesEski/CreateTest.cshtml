@using static Economy.Panel.UI.Areas.Tenant.Controllers.PagesEskiController
@model PageCreateVm

<div class="container py-3">
    <h4>Sayfa Oluştur</h4>
    @if (TempData["ok"] is string ok)
    {
        <div class="alert alert-success">@ok</div>
    }

    <form asp-action="CreateTest" method="post">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label class="form-label">Başlık</label>
            <input class="form-control" asp-for="Title" required />
        </div>

        <div class="mb-3">
            <label class="form-label">İçerik</label>
            <textarea class="form-control" asp-for="Content" rows="6"></textarea>
        </div>

        <!-- Tekil alanlar -->
        @for (int i = 0; i < Model.Singles.Count; i++)
        {
            @await Html.PartialAsync("_ImagePicker", (i, Model.Singles[i]))
        }

        <hr />

        <!-- Galeri grupları -->
        @for (int gi = 0; gi < Model.Galleries.Count; gi++)
        {
            @await Html.PartialAsync("_GalleryGroup", (gi, Model.Galleries[gi]))
        }
   
        <div class="text-end">
            <button class="btn btn-primary" type="submit">Kaydet</button>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/components/image-manager.js"></script>
}
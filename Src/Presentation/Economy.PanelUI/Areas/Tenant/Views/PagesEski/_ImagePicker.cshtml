@using Economy.Core.Dtos.Custom
@model (int Index, ImageFieldVm Field)

<div class="mb-3 col-md-6">
    <label class="form-label fw-semibold">@Model.Field.Label</label>
    <div class="input-group">
        <input class="form-control"
               name="Singles[@Model.Index].Url"
               id="Singles_@(Model.Index)_Url"
               value="@Model.Field.Url" />
        <input type="hidden" name="Singles[@Model.Index].Key" value="@Model.Field.Key" />
        <input type="hidden" name="Singles[@Model.Index].Label" value="@Model.Field.Label" />

        <button class="btn btn-outline-secondary btn-pick-single"
                type="button"
                data-target-input="#Singles_@(Model.Index)_Url"
                data-target-preview="#Singles_@(Model.Index)_Preview">
            Resim Seç
        </button>
    </div>
    <div class="mt-2">
        <img id="Singles_@(Model.Index)_Preview"
             src="@(string.IsNullOrWhiteSpace(Model.Field.Url) ? "" : Model.Field.Url)"
             class="img-thumbnail"
             style="max-height:160px; @(string.IsNullOrWhiteSpace(Model.Field.Url) ? "display:none;" : "")" />
    </div>
</div>

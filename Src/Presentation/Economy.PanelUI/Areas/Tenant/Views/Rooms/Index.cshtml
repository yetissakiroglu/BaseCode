@using Economy.Application.TenantUI.Dtos
@model List<RoomAttributeEditVm>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Oda Özellikleri</h5>
        <a asp-action="Create" class="btn btn-sm btn-primary">Yeni Özellik Ekle</a>
    </div>

    <div class="card-body">
        <table class="table table-sm table-striped align-middle">
            <thead>
                <tr>
                    <th>Kod</th>
                    <th>Ad (TR)</th>
                    <th>Ad (EN)</th>
                    <th>Grup</th>
                    <th>Tip</th>
                    <th>Filtre</th>
                    <th>Zorunlu</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Code</td>
                        <td>@item.NameTr</td>
                        <td>@item.NameEn</td>
                        <td>@item.Group</td>
                        <td>@item.InputType</td>
                        <td>@(item.IsFilterable ? "Evet" : "Hayır")</td>
                        <td>@(item.IsRequired ? "Evet" : "Hayır")</td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Düzenle</a>
                            <a asp-area="Admin" asp-controller="RoomAttributeOption" asp-action="Index"
                               asp-route-attributeId="@item.Id"
                               class="btn btn-sm btn-outline-info">
                                Seçenekler
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@using Economy.Application.TenantUI.Dtos
@model RoomAttributeValueEditVm  

@{
    ViewData["Title"] = "Oda Özellikleri";
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Oda Özellikleri</h5>
        <a asp-action="Edit" asp-route-id="@Model.RoomId" class="btn btn-sm btn-outline-secondary">
            Geri
        </a>
    </div>

    <div class="card-body">

        <form asp-action="SaveAttributes" method="post">
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.RoomId)

            @foreach (var group in Model.GroupedAttributes)
            {
                <div class="mb-4">
                    <h6 class="fw-bold mb-3 text-primary">@group.Key</h6>

                    <div class="row g-3">

                        @foreach (var attr in group.Value)
                        {
                            <div class="col-md-6 col-lg-4">
                                <label class="form-label fw-semibold">
                                    @attr.Name
                                </label>

                                @* OPTION – Dropdown *@
                                if (attr.Type == "Option")
                                {
                                    <select class="form-select"
                                            name="Values[@attr.AttributeId].OptionId">
                                        <option value="">Seçiniz</option>

                                        @foreach (var opt in attr.Options)
                                    {
                                        @(opt.Id == attr.SelectedOptionId ? "selected" : "")
                                            <option value="@opt.Id">
                                                @opt.DisplayName
                                            </option>
                                        }
                                    </select>
                                }

                                @* BOOL – Switch *@
                                else if (attr.Type == "Bool")
                                {
                                    <div class="form-check form-switch mt-1">
                                        <input type="checkbox"
                                               class="form-check-input"
                                               name="Values[@attr.AttributeId].BoolValue"
                                               value="true"
                                               @(attr.ValueBool == true ? "checked" : "") />
                                        <label class="form-check-label">Evet / Hayır</label>
                                    </div>
                                }

                                @* NUMBER *@
                                else if (attr.Type == "Number")
                                {
                                    <input type="number"
                                           class="form-control"
                                           name="Values[@attr.AttributeId].IntValue"
                                           value="@attr.ValueInt"
                                           placeholder="Değer giriniz" />
                                }

                                @* TEXT *@
                                else if (attr.Type == "Text")
                                {
                                    <input type="text"
                                           class="form-control"
                                           name="Values[@attr.AttributeId].TextValue"
                                           value="@attr.ValueText"
                                           placeholder="Metin giriniz" />
                                }

                                <input type="hidden" name="Values[@attr.AttributeId].AttributeId" value="@attr.AttributeId" />
                            </div>
                        }

                    </div>
                </div>
            }

            <div class="mt-4 text-end">
                <button type="submit" class="btn btn-primary">Kaydet</button>
            </div>

        </form>
    </div>
</div>

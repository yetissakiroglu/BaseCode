@using Economy.Application.TenantUI.Dtos
@using Economy.Application.TenantUI.Dtos.AppLanguageDtos
@using Economy.Core.Enums
@model BlockGroupBlockVm

@{
    var langs = (List<AppLanguageDto>)ViewBag.Languages;
    // Prefix'ten index'i çıkar (Blocks[3] gibi)
    var prefix = ViewData.TemplateInfo.HtmlFieldPrefix; // "Blocks[3]"
    var open = prefix?.IndexOf('[') ?? -1;
    var close = prefix?.IndexOf(']') ?? -1;
    var idx = (open >= 0 && close > open) ? prefix.Substring(open + 1, close - open - 1) : "0";
}
<!-- 🔴 Koleksiyon bağlama için şart -->


<div class="col">
    <input type="hidden" name="Blocks.Index" value="@idx" />

    <div class="card block-card" draggable="true">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div><strong>@Model.Type.GetDisplayName()</strong></div>
            <div class="d-flex align-items-center gap-2">
       @*          <div class="form-check">
                    <input class="form-check-input" asp-for="IsActive" />
                    <label class="form-check-label">Durum</label>
                </div> *@
              @*   <select asp-for="Stage" class="form-select form-select-sm" asp-items="Html.GetEnumSelectList<PageStage>()" style="width:130px">
                </select> *@
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="Type" />
@*                 <input type="hidden" asp-for="SortOrder" />
 *@            </div>
        </div>

        <div class="card-body">
            <div class="mb-3">
                <label class="form-label">Etiket Başlığı</label>
                <input class="form-control" asp-for="Tag" />
            </div>
            <label class="form-label">Shared JSON</label>
            <textarea class="form-control mb-2" asp-for="SharedJson" rows="4"></textarea>
                       
            <ul class="nav nav-tabs" role="tablist">
                @for (int i = 0; i < Model.Translations.Count; i++)
                {
                    var lid = Model.Translations[i].LanguageId;
                    var lang = langs.First(l => l.Id == lid);
                    <li class="nav-item">
                        <button class="nav-link @(i == 0 ? "active" : "")" data-bs-toggle="tab" data-bs-target="#t-@Model.GetHashCode()-@lid" type="button">@lang.Code.ToUpper()</button>
                    </li>
                }
            </ul>
            <div class="tab-content border p-2">
                @for (int i = 0; i < Model.Translations.Count; i++)
                {
                    var lid = Model.Translations[i].LanguageId;
                    <div class="tab-pane fade @(i == 0 ? "show active" : "")" id="t-@Model.GetHashCode()-@lid">
                        <input type="hidden" asp-for="Translations[i].Id" />
                        <input type="hidden" asp-for="Translations[i].LanguageId" />
                        <input type="hidden" asp-for="Translations[i].LanguageCode" />
                        <input type="hidden" asp-for="Translations[i].LanguageIcon" />

                        <label class="form-label">Localized JSON</label>
                        <textarea class="form-control" asp-for="Translations[i].LocalizedJson" rows="5"></textarea>
                        <div class="mt-1">
                            @if (Model.Id.HasValue)
                            {
                                <a class="btn btn-sm btn-outline-secondary" href='@Url.Action("EditBlockEditor", "BlockEditor", new { area = "Tenant", pageBlockId = Model.Id.Value, languageId = lid })'>Blok Tipine Özel Editör</a>
                            }
                            else
                            {
                                <span class="text-muted">Kaydettikten sonra tip-özel editör açılır.</span>
                            }
                            <!-- _BlockCard.cshtml header içine ekle -->
                            <button type="button"
                                    class="btn btn-sm btn-outline-danger remove-block"
                                    title="Kaldır">
                                Kaldır
                            </button>

                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

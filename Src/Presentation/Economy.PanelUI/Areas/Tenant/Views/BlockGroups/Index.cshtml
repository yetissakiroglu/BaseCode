@using Economy.Application.TenantUI.Dtos.AppBlockGroupDtos
@model List<AppBlockGroupListDto>
@{
    ViewData["Title"] = "Blok Grupları";
}

<main>
    <div class="container-fluid">
        @await Html.PartialAsync("_breadcrumbs")
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                            </div>
                            <div>
                                <div class="app-btn-list">
                                    <a class="btn btn-primary" asp-action="Index">Tüm Kayıtlar</a>
                                    <a class="btn btn-danger" asp-action="Create">Yeni Ekle</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-sm table-bottom-border table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Id</th>
                                        <th>Başlık</th>
                                        <th>Durum</th>
                                        <th>Klon</th>
                                        <th>Blok Sayısı</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var g in Model)
                                    {
                                        <tr>
                                            <td>@g.Id</td>
                                            <td>@g.Title</td>
                                            <td>@g.IsActive.GetAktifPasifText()</td>
                                            <td>@g.Columns.GetDisplayName()</td>
                                            <td>@g.BlockCount</td>
                                            <td>
                                                <a class="btn btn-sm btn-outline-secondary" asp-action="Edit1" asp-route-id="@g.Id">Blok Düzenle</a>
                                                <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@g.Id">Düzenle</a>
                                                <form asp-action="Delete" asp-route-id="@g.Id" method="post" style="display:inline">
                                                    <button class="btn btn-sm btn-outline-danger" onclick="return confirm('Silinsin mi?')">Sil</button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>
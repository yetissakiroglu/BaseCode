@using Economy.Application.TenantUI.Dtos
@using Economy.Application.TenantUI.Dtos.AppLanguageDtos
@using Economy.Core.Enums
@using Economy.Domain.Entites.TenantEntity.EntityAppLanguages
@using System.Reflection
@using System.ComponentModel.DataAnnotations
@model BlockGroupDto
@{
    ViewData["Title"] = "Sayfa Block Grubu Düzenle";
}

<main>
    <div class="container-fluid">
        @await Html.PartialAsync("_breadcrumbs")
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                            </div>
                            <div>
                                <div class="app-btn-list">
                                    <a class="btn btn-primary" asp-action="Index">Tüm Kayıtlar</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12">

                <form asp-action="Edit" method="post">
                    <div class="card mb-3">
                        <div class="card-header">Genel</div>
                        <div class="card-body">
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="Id" />
                            <div class="row g-3">

                                <div class="col-md-4">
                                    <label class="form-label">Columns</label>
                                    <select asp-for="Columns" class="form-select" asp-items="Html.GetEnumSelectList<BlockColumns>()"></select>
                                </div>
                            </div>
                            <div class="row mt-3">
                                <div class="col-md-6 col-xl-4">
                                    <div class="check-container">
                                        <label class="check-box">
                                            <input type="checkbox" asp-for="ShowTitle" />
                                            <span class="checkmark check-primary ms-2"></span>
                                            <span class="text-dark">Başlık Görünsün mü?</span>
                                        </label>
                                    </div>
                                </div>
                                <div class="col-md-6 col-xl-4">
                                    <div class="check-container">
                                        <label class="check-box">
                                            <input type="checkbox" asp-for="ShowDescription" />
                                            <span class="checkmark check-primary ms-2"></span>
                                            <span class="text-dark">Kısa Açıklama Görünsün mü?</span>
                                        </label>
                                    </div>
                                </div>
                            </div>

                            <hr class="custom-divider" />
                            <div class="row g-3">
                                <ul class="nav nav-tabs tab-light-secondary" role="tablist">
                                    @for (int i = 0; i < Model.Translations.Count; i++)
                                    {
                                        var t = Model.Translations[i];
                                        var code = (t.LanguageCode ?? "xx").ToLower();       // güvenli
                                        var tabId = $"tab-{code}-{i}";                        // benzersiz
                                        var paneId = $"pane-{code}-{i}";                      // benzersiz
                                                                                              <li class="nav-item" role="presentation">
                                                                                                  <button class="gap-2 nav-link @(i == 0 ? "active" : null)"
                                                                                                          id="@tabId"
                                                                                                          type="button"
                                                                                                          role="tab"
                                                                                                          data-bs-toggle="tab"
                                                                                                          data-bs-target="#@paneId"
                                                                                                          aria-controls="@paneId"
                                                                                                          aria-selected="@(i == 0 ? "true" : "false")">
                                                                                                      <i class="@t.LanguageIcon?.ToLower()"></i>
                                                                                                      @t.LanguageCode?.ToUpper()
                                                                                                  </button>
                                                                                              </li>
                                    }
                                </ul>
                                <div class="tab-content border border-top-0 p-3">
                                    @for (int i = 0; i < Model.Translations.Count; i++)
                                    {
                                        var t = Model.Translations[i];
                                        var code = (t.LanguageCode ?? "xx").ToLower();
                                        var tabId = $"tab-{code}-{i}";
                                        var paneId = $"pane-{code}-{i}";

                                        <div id="@paneId" class="tab-pane fade @(i == 0 ? "show active" : null)" role="tabpanel" aria-labelledby="@tabId">

                                            <input type="hidden" name="Translations[@i].LanguageId" value="@t.LanguageId" />
                                            <input type="hidden" name="Translations[@i].LanguageCode" value="@t.LanguageCode" />
                                            <input type="hidden" name="Translations[@i].LanguageIcon" value="@t.LanguageIcon" />
                                            <input type="hidden" name="Translations[@i].Id" value="@t.Id" />

                                            <div class="row g-3">

                                                <div class="col-md-6">
                                                    <label class="form-label">Başlık</label>
                                                    <input class="form-control" name="Translations[@i].Title" value="@t.Title" />
                                                </div>
                                                <div class="col-md-12">
                                                    <label class="form-label">Kısa Açıklama</label>
                                                    <textarea class="form-control" name="Translations[@i].Description" rows="2">@t.Description</textarea>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                            <hr class="my-4" />
                            <div class="mt-4 text-end">
                                <button class="btn btn-primary" type="submit">Kaydet</button>
                                <a class="btn btn-outline-secondary" href="/tenant/blockgroups">Vazgeç</a>
                            </div>

                        </div>
                    </div>

                    <div class="card mb-3 ">
                        <div class="card-body">
                            <div class="d-flex align-items-center justify-content-between mt-4">
                                <h5>Blocks</h5>
                                <div class="d-flex gap-2">
                                    <select id="newBlockType" class="form-select form-select-sm" style="width:220px">
                                        <option value="">Block type…</option>
                                        @foreach (var value in Enum.GetValues(typeof(BlockType)))
                                        {
                                            var fi = typeof(BlockType).GetField(value.ToString());
                                            var displayAttr = fi?.GetCustomAttribute<DisplayAttribute>();
                                            var displayName = displayAttr?.Name ?? value.ToString();

                                            <option value="@((int)value)">@displayName</option>
                                        }
                                    </select>
                                    <button class="btn btn-sm btn-outline-primary" type="button" id="btnAddNew">Add Block</button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div id="grid" class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3 mt-1 project-total-card">
                        @for (int i = 0; i < Model.Blocks.Count; i++)
                        {
                            <partial name="_BlockCard" for="Blocks[i]" />
                        }
                    </div>

                </form>
            </div>

        </div>
    </div>
</main>


@section Scripts {
    <script>
        const langs = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(((List<AppLanguageDto>)ViewBag.Languages).Select(l => l.Id)));
              document.getElementById('btnAddNew').addEventListener('click', async ()=>{
                const type = document.getElementById('newBlockType').value;
                if(!type) return;
                const idx = document.querySelectorAll('#grid .block-card').length;
                const url = '@Url.Action("BlockCardPartial", "BlockGroups", new { area = "Tenant" })' + `?type=${type}&index=${idx}` + langs.map(l=>`&languageIds=${l}`).join('');
                const resp = await fetch(url); const html = await resp.text();
                document.getElementById('grid').insertAdjacentHTML('beforeend', html);
                normalizeOrders();
              });
               function normalizeOrders(){
                document.querySelectorAll('#grid .block-card').forEach((el,idx)=>{ const input=el.querySelector('input[name$=".SortOrder"]'); if(input) input.value=idx; });
              }
    </script>
}
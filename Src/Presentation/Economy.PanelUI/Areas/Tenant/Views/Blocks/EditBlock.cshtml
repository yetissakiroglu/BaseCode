@using Economy.Application.TenantUI.Dtos.AppBlockDtos
@using Economy.Application.TenantUI.Dtos.AppLanguageDtos
@model AppBlockDto
@{
    ViewBag.Title = $"Blok Düzenle #{Model.Tag}";
    var langs = (List<AppLanguageDto>)ViewBag.Languages;
}
<main>
    <div class="container-fluid">
        @await Html.PartialAsync("_breadcrumbs")
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                            </div>
                            <div>
                                <div class="app-btn-list">
                                    <a class="btn btn-primary" asp-action="Index">Tüm Kayıtlar</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-12">
                <form method="post">
                    @Html.AntiForgeryToken()
                    <div class="card">
                        <div class="card-header d-flex gap-3 align-items-center">
                            <div><strong>Tipi:</strong> @Model.Type.GetDisplayName()</div>
                            <div class="form-check"><input class="form-check-input" asp-for="IsActive" /> <label class="form-check-label">Durumu</label></div>
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label">Etiket</label>
                                    <input class="form-control" asp-for="Tag" />
                                </div>
                                <div class="col-md-12">
                                    <label class="form-label">Shared JSON</label>
                                    <textarea class="form-control" asp-for="SharedJson" rows="3"></textarea>
                                </div>
                            </div>
                        </div>
                        <hr class="custom-divider" />
                        <div class="card-body">
                            <div class="row g-3">
                                @for (int i = 0; i < Model.Translations.Count; i++)
                                {
                                    var lid = Model.Translations[i].LanguageId;
                                    var ln = langs.First(x => x.Id == lid);
                                    <div class="col-md-6">
                                        <label class="form-label"><strong>@ln.Name (@ln.Code.ToUpper())</strong> </label>
                                        <input type="hidden" asp-for="Translations[i].Id" />
                                        <input type="hidden" asp-for="Translations[i].LanguageId" />
                                        <input type="hidden" asp-for="Translations[i].LanguageCode" />
                                        <input type="hidden" asp-for="Translations[i].LanguageIcon" />
                                        <input type="hidden" asp-for="Translations[i].LanguageName" />
                                        <textarea class="form-control" asp-for="Translations[i].LocalizedJson" rows="6"></textarea>
                                        <div class="mt-2">
                                            <a class="btn btn-sm btn-outline-secondary" href='@Url.Action("EditBlockEditor", "BlockEditor", new { area = "Tenant", pageBlockId = Model.Id ?? 0, languageId = lid })'>Blok Tipine Özel Editör</a>
                                        </div>
                                    </div>
                                }
                            </div>                         
                        </div>
                        <div class="card-footer d-flex justify-content-between">
                            <button type="button" class="btn btn-outline-secondary" onclick="history.back()">← Geri</button>
                            <button type="submit" class="btn btn-primary">Güncelle</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</main>
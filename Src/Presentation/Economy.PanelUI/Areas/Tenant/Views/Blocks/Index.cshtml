@using Economy.Application.TenantUI.Dtos.AppBlockDtos
@using Economy.Core.Enums
@using System.ComponentModel.DataAnnotations
@using System.Reflection

@model AppBlockListDto
@{
    ViewBag.Title = "Bloklar";
}

<main>
    <div class="container-fluid">
        @await Html.PartialAsync("_breadcrumbs")
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                                <form method="get" class="row g-2">
                                    <div class="col-auto">
                                        <select class="form-select" name="type">
                                            <option value="">Type</option>
                                            @foreach (var t in Enum.GetValues(typeof(BlockType)))
                                            {
                                                var v = (int)t;
                                                <option value="@v" selected="@(Model.FilterType.HasValue && (int)Model.FilterType.Value == v)">@t</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-auto"><input class="form-control" name="q" value="@Model.Q" placeholder="arama kriteri" /></div>
                                    <div class="col-auto"><button class="btn btn-primary">Filter</button></div>
                                </form>
                            </div>
                            <div>
                                <div class="app-btn-list">
                            
                                    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#apiModel">
                                        Yeni Blok
                                    </button>
                                    
                              
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
            @foreach (var it in Model.Items)
            {
                <div class="col">
                    <div class="card h-100">
                        <div class="card-header d-flex justify-content-between">
                            <div><strong>@it.Type.GetDisplayName()</strong> <span class="text-muted"># @it.Tag</span></div>
                        </div>
                        <div class="card-body">
                            <div><small>Durumu:</small> @it.IsActive.ToTurkishYesNo()</div>
                        </div>
                        <div class="card-footer d-flex gap-2">
                            <a class="btn btn-sm btn-primary"
                               href="@Url.Action("EditBlock", "Blocks", new { area = "Tenant", blockId = it.Id })">
                                Düzenle
                            </a>

                            <form asp-area="Tenant"
                                  asp-controller="Blocks"
                                  asp-action="Delete"
                                  method="post"
                                  onsubmit="return confirm('Bu bloğu silmek istediğinize emin misiniz?');">
                                <input type="hidden" name="id" value="@it.Id" />
                                <button type="submit" class="btn btn-sm btn-danger">Sil</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</main>
<!-- modal start -->
<!-- Modal -->
<div class="modal fade" id="apiModel" tabindex="-1" aria-labelledby="apiModelLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="get" action='@Url.Action("CreateBlock", "Blocks")'>
                <div class="modal-header border-0">
                    <h1 class="modal-title fs-6" id="apiModelLabel">Blok Oluştur</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>

                <div class="modal-body">
                    <label for="newBlockType" class="form-label">Blok Tipi</label>
                    <select id="newBlockType" name="blockType" class="form-select form-select-sm border-secondary" required>
                        <option value="">Seçiniz…</option>
                        @foreach (var value in Enum.GetValues(typeof(BlockType)))
                        {
                            var fi = typeof(BlockType).GetField(value.ToString());
                            var displayAttr = fi?.GetCustomAttribute<DisplayAttribute>();
                            var displayName = displayAttr?.Name ?? value.ToString();
                            <option value="@((int)value)">@displayName</option>
                        }
                    </select>
                </div>

                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">Kapat</button>
                    <button type="submit" class="btn btn-outline-primary">Ekle</button>
                </div>
            </form>
        </div>
    </div>
</div>


<!-- modal-end -->
@section Scripts {
    <script>


    </script>
}
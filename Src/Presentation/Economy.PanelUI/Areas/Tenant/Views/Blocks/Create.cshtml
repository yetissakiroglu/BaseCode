@model Economy.Panel.UI.Areas.Tenant.Models.BlockEditVm
@{
    ViewBag.Title = "Yeni Blok";
}
<main>
    <div class="container-fluid">
        @await Html.PartialAsync("_breadcrumbs")
        <div class="row m-1">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                            </div>
                            <div>
                                <div class="app-btn-list">
                                    <a class="btn btn-primary" asp-action="Index">Tüm Kayıtlar</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-12">
                <h3 class="mb-3">Yeni Blok (Sayfa #@Model.PageId)</h3>

                <form method="post">
                    @Html.AntiForgeryToken()

                    <div class="card mb-3">
                        <div class="card-header">Genel</div>
                        <div class="card-body row g-3">
                            <input type="hidden" asp-for="PageId" />
                            <div class="col-md-3">
                                <label class="form-label">Şablon</label>
                                <select class="form-select" asp-for="BlockTemplate">
                                    <option value="1">RichText</option>
                                    <option value="2">ImageText</option>
                                    <option value="3">Hero</option>
                                    <option value="4">Gallery</option>
                                    <option value="5">IncludeSnippet</option>
                                    <option value="6">PageList</option>
                                    <option value="7">RoomList</option>
                                    <option value="8">CampaignList</option>
                                    <!-- İstersen RoomList/CampaignList/PageList enumlarını da eklersin -->
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Sıra</label>
                                <input class="form-control" asp-for="SortOrder" />
                            </div>
                            <div class="col-md-2 d-flex align-items-center">
                                <div class="form-check mt-4">
                                    <input class="form-check-input" type="checkbox" asp-for="IsActive" />
                                    <label class="form-check-label">Aktif</label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card mb-3">
                        <div class="card-header">İçerik (Dil)</div>
                        <div class="card-body row g-3">
                            <input type="hidden" asp-for="LanguageId" />
                            <input type="hidden" asp-for="LanguageCode" />

                            <div class="col-md-6">
                                <label class="form-label">Başlık</label>
                                <input class="form-control" asp-for="Title" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Görsel</label>
                                <input class="form-control" asp-for="Image" />
                            </div>
                            <div class="col-md-12">
                                <label class="form-label">Özet</label>
                                <textarea class="form-control" asp-for="Summary" rows="2"></textarea>
                            </div>
                            <div class="col-md-12">
                                <label class="form-label">Metin</label>
                                <textarea class="form-control" asp-for="Body" rows="6"></textarea>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Buton Metni</label>
                                <input class="form-control" asp-for="ButtonText" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Buton URL</label>
                                <input class="form-control" asp-for="ButtonUrl" />
                            </div>
                            <div class="col-md-12">
                                <label class="form-label">JsonData</label>
                                <textarea class="form-control" asp-for="JsonData" rows="3"></textarea>
                                <div class="form-text">
                                    <strong>IncludeSnippet</strong>: {"snippetCode":"PET_POLICY_NOTE"}<br />
                                    <strong>PageList/RoomList/CampaignList</strong>:
                                    {"pageIds":[5,6], "slugs":["aile-odasi"], "take":12, "order":"sort_asc"}
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button class="btn btn-primary" type="submit">Kaydet</button>
                        <a class="btn btn-light" href="/tenant/blocks/index?pageId=@Model.PageId">Vazgeç</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</main>

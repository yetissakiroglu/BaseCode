@using Economy.Application.TenantUI.Dtos
@using Economy.Core.Enums

@model PageBlockIndexVm
@{
    ViewBag.Title = "Page Blocks";
}
<main>
    <div class="container-fluid">
        @await Html.PartialAsync("_breadcrumbs")

        <h3>Page Blocks</h3>

        <form method="get" class="row g-2 mb-3">
            <div class="col-auto"><input class="form-control" type="number" name="pageId" value="@Model.FilterPageId" placeholder="PageId" /></div>
            <div class="col-auto">
                <select class="form-select" name="type">
                    <option value="">Type</option>
                    @foreach (var t in Enum.GetValues(typeof(BlockType)))
                    {
                        var v = (int)t;
                        <option value="@v" selected="@(Model.FilterType.HasValue && (int)Model.FilterType.Value == v)">@t</option>
                    }
                </select>
            </div>
            <div class="col-auto"><input class="form-control" name="q" value="@Model.Q" placeholder="Search slug/json" /></div>
            <div class="col-auto"><button class="btn btn-primary">Filter</button></div>
        </form>

        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
            @foreach (var it in Model.Items)
            {
                <div class="col">
                    <div class="card h-100">
                        <div class="card-header d-flex justify-content-between">
                            <div><strong>@it.Type</strong> <span class="text-muted">#@it.Id</span></div>
                        </div>
                        <div class="card-body">
                            <div><small>Page:</small> @it.BlockGroupId </div>
                            <div><small>Order:</small> @it.SortOrder</div>
                            <div><small>Active:</small> @(it.IsActive ? "Yes" : "No")</div>
                            <div><small>Stage:</small> @it.Stage</div>
                        </div>
                        <div class="card-footer d-flex gap-2">
                            <a class="btn btn-sm btn-primary" href="@Url.Action("Edit", "BlockGroupBlocks", new { area = "Tenant", id = it.Id })">Edit</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</main>
@using Economy.Domain.Entites.TenantEntity.EntityAppContents
@model IEnumerable<AppPage>
@{
    ViewBag.Title = "Pages";
}
<main>
    <div class="container-fluid">
        @await Html.PartialAsync("_breadcrumbs")



        <div class="d-flex justify-content-between align-items-center mb-2">
            <h3>Pages</h3>
            <a class="btn btn-primary" href="@Url.Action("Edit", "Pages", new { area = "Tenant" })">+ New Page</a>
        </div>
        <table class="table table-sm align-middle">
            <thead><tr><th>ID</th><th>Slug</th><th>Stage</th><th>Active</th><th></th></tr></thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td>@p.Id</td>
                        <td>@p.Slug</td>
                        <td>@p.Stage</td>
                        <td>@(p.IsActive ? "Yes" : "No")</td>
                        <td><a class="btn btn-sm btn-outline-primary" href="@Url.Action("Edit", "Pages", new { area = "Tenant", id = p.Id })">Edit</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</main>
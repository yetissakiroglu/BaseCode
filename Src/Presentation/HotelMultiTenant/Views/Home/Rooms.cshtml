@model HotelMultiTenant.Services.RoomsVm
@{
    Layout = "_Layout";
}
<h1>@Model.Title</h1>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px;">
    @foreach (var r in Model.Rooms)
    {
        <article style="border:1px solid #ddd;border-radius:12px;padding:12px;">
            <img src="@r.ThumbUrl" alt="@r.Name" style="width:100%;height:140px;object-fit:cover;border-radius:8px;" />
            <h3>@r.Name</h3>
            <p>@r.ShortDesc</p>
            @if (r.PricePerNight is not null)
            {
                <strong>@r.PricePerNight.Value.ToString("C0") / gece</strong>
            }
        </article>
    }
</div>

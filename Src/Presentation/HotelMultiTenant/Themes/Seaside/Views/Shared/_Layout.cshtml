@using HotelMultiTenant.Multitenancy
@{
    var t = Context.GetTenant()?.Current;
    var name = t?.Settings.Domain ?? "Otel";
}
<!doctype html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@name – Seaside</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href="/themes/seaside.css" />
</head>
<body class="seaside">
    @await Html.PartialAsync("/Themes/Seaside/Views/Shared/_TopNav.cshtml")
    <main class="container">@RenderBody()</main>
    @await Html.PartialAsync("/Themes/Seaside/Views/Shared/_Footer.cshtml")
</body>
</html>

@using Economy.Core.Extensions
@using Economy.UI.Dtos
@using HotelMultiTenant.Multitenancy
@inject ICdnHelper Cdn

@model BlockDto
@{

    var shared = Model.Shared.SafeAs<HeroSharedVm>() ?? new();
    var loc = Model.Localized.SafeAs<HeroLocVm>() ?? new();

  
    var vAlign = shared.VerticalAlign == "top"
        ? "align-items-start"
        : shared.VerticalAlign == "bottom"
            ? "align-items-end"
            : "align-items-center";
}

<section class="block-hero position-relative overflow-hidden rounded-3" style="min-height:300px;">
    <div class="ratio ratio-21x9">
        <img src="@Cdn.Url(shared.BackgroundUrl,true)" class="w-100 h-100 object-fit-cover" alt="@loc.Heading" />
    </div>
    <div class="position-absolute top-0 start-0 w-100 h-100 d-flex @vAlign justify-content-center">
        <div class="container">
            <div class="row">
                <div class="col-lg-8">
                    <div class="p-4 p-md-5 bg-dark bg-opacity-75 text-white rounded-3">
                        @if (!string.IsNullOrWhiteSpace(loc.Heading))
                        {
                            <h2 class="h3 fw-bold mb-2">@loc.Heading</h2>
                        }
                        @if (!string.IsNullOrWhiteSpace(loc.SubHeading))
                        {
                            <p class="mb-3">@loc.SubHeading</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(loc.ButtonText))
                        {
                            <a href="@loc.ButtonUrl" class="btn btn-light btn-sm">@loc.ButtonText</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

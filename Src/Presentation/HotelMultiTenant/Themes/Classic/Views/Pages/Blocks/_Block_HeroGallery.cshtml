@using Economy.Core.Extensions
@using Economy.UI.Dtos
@using HotelMultiTenant.Multitenancy
@inject ICdnHelper Cdn

@model BlockDto
@{
    var shared = Model.Shared.SafeAs<GalleryHeroSharedVm>() ?? new();
    var loc = Model.Localized.SafeAs<GalleryHeroLocVm>() ?? new();

    var col = Math.Clamp(Model.Column, (byte)1, (byte)12);

    var vAlign = shared.VerticalAlign == "top"
        ? "align-items-start"
        : shared.VerticalAlign == "bottom"
            ? "align-items-end"
            : "align-items-center";
}


<div class="col-xl-@col col-lg-@col col-md-@col">
    <a href="@loc.ButtonUrl" class="destination-banner">
        <img src="assets/images/destination/destination-01.png" alt="@loc.Heading">
        <div class="destination-content">
    @*         <div class="ratting-badge">
                <i class="ri-star-s-fill"></i>
                <span>4.5</span>
            </div> *@
            <div class="destination-info">
                <div class="destination-name">
                    <p class="pera">@loc.Heading</p>
                    <div class="location">
                        <i class="ri-map-pin-line"></i>
                        <p class="name">@loc.SubHeading</p>
                    </div>
                </div>
                <div class="button-section">
                    <div class="arrow-btn">
                        <i class="ri-arrow-right-line"></i>
                    </div>
                </div>
            </div>
        </div>
    </a>
</div>


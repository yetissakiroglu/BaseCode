@{
    Layout = "_Layout";
}

@using Economy.Core.Enums
@using Economy.UI.Dtos
@model PageDetailDto

@{
    ViewData["Title"] = Model.MetaTitle ?? Model.Title ?? "";

    var cover = Model.CoverImageUrl
                ?? Model.Medias?.FirstOrDefault(m => m.IsCover)?.Url
                ?? Model.OgImageUrl;
}

@section HeadMeta {
    @* Meta title & description *@
    @if (!string.IsNullOrWhiteSpace(Model.MetaTitle))
    {
        <title>@Model.MetaTitle</title>
    }

    @if (!string.IsNullOrWhiteSpace(Model.MetaDescription))
    {
        <meta name="description" content="@Model.MetaDescription" />
    }

    @* OG image *@
    @if (!string.IsNullOrWhiteSpace(Model.OgImageUrl))
    {
        <meta property="og:image" content="@Model.OgImageUrl" />
    }

    @* Hreflang linkleri *@
    @if (Model.Hreflangs != null && Model.Hreflangs.Count > 0)
    {
        foreach (var h in Model.Hreflangs)
        {
            <link rel="alternate" hreflang="@h.Lang" href="@h.Url" />
        }
    }
}

<div class="page-detail">

    @* ---------------- Cover / Title ---------------- *@
    @await Html.PartialAsync("~/Themes/Classic/Views/Pages/Shared/_PageHero.cshtml", Model)


    @if (!Model.IsHomepage)
    {
        @* ---------------- Body HTML ---------------- *@
        @if (!string.IsNullOrWhiteSpace(Model.Body))
        {
            <article class="page-body mb-5">
                @Html.Raw(Model.Body)
            </article>
        }
    }



    @* ---------------- Block Groups ---------------- *@
    @foreach (var group in Model.Groups.OrderBy(g => g.SortOrder))
    {
        <section class="page-block-group mb-5">


            @if (group.ShowTitle)
            {
                <h2 class="h4 fw-semibold mb-2">@group.Title</h2>
            }

            @if (group.ShowDescription)
            {
                <p class="text-muted mb-4">@group.Description</p>
            }

            <div class="row g-4">
                @foreach (var block in group.Blocks.OrderBy(b => b.SortOrder))
                {
                    var col = Math.Clamp(block.Column, (byte)1, (byte)12);
                    <div class="col-md-@col">
                        @await Html.PartialAsync($"~/Themes/Classic/Views/Pages/Blocks/_Block_{block.Type}.cshtml", block)
                    </div>
                }
            </div>

        </section>
    }


    @* Sağ taraf: medya *@
    <div class="col-lg-4">
        @await Html.PartialAsync("~/Themes/Classic/Views/Pages/Shared/_PageMedias.cshtml", Model)
    </div>
</div>

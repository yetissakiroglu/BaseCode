@{
    Layout = "_Layout";
}

@using Economy.Core.Enums
@using Economy.UI.Dtos
@using HotelMultiTenant.Multitenancy
@model PageDetailDto
@inject ICdnHelper Cdn

@if (!Model.IsHomepage)
{
    @await Html.PartialAsync("_Breadcrumbs", Model)

    @* ---------------- Body HTML ---------------- *@
    @if (!string.IsNullOrWhiteSpace(Model.Body))
    {
        <article class="page-body mb-5">
            @Html.Raw(Model.Body)
        </article>
    }


    <!-- Destination area S t a r t -->
    <section class="tour-details-section section-padding2">
        <div class="tour-details-area">

            <div class="tour-details-container">
                <div class="container">
                    <div class="row">
                        <div class="col-lg-12">
                            <!-- Details Banner Slider -->
                            <div class="tour-details-banner">
                                <div class="row">
                                    <div class="col-lg-12">
                                        <div class="swiper tourSwiper-active radius-8">
                                            <div class="swiper-wrapper">
                                                @foreach (var itemImg in Model.Medias)
                                                {
                                                    <div class="swiper-slide">
                                                        @Html.Raw(Cdn.PictureHtml(itemImg.Url, new[] { 640, 960, 1280, 1600 }, "100vw", itemImg.Alt ?? "Slide", eagerLcp: true))
                                                    </div>
                                                }
                                            </div>
                                            <div class="swiper-button-next"><i class="ri-arrow-right-s-line"></i></div>
                                            <div class="swiper-button-prev"><i class="ri-arrow-left-s-line"></i></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!-- / Slider-->



                            <!-- Details Heading -->
                            <div class="details-heading pt-0">
                                <div class="d-flex flex-column">
                                    <h4 class="title text-capitalize">@Model.Title</h4>
                                </div>

                            </div>
                            <!-- / Details Heading -->
                            <!-- Service Feature -->
                            <ul class="service-feature py-20">
                                <li class="single"><i class="icon_set_1_icon-27"></i>Parking</li>
                                <li class="single"><i class="icon_set_1_icon-86"></i>Free Wifi</li>
                                <li class="single"><i class="icon_set_2_icon-116"></i>Plasma TV</li>
                                <li class="single"><i class="icon_set_2_icon-110"></i>Poll</li>
                                <li class="single"><i class="icon_set_1_icon-59"></i>Breakfast</li>
                                <li class="single"><i class="icon_set_1_icon-22"></i>Pet allowed</li>
                                <li class="single"><i class="icon_set_1_icon-13"></i>Accessibiliy</li>
                                <li class="single"><i class="icon_set_1_icon-23"></i>Private Balcony</li>
                            </ul>
                            <!-- / Service Feature -->
                        

                            <div class="mt-30">
                                <div class="row g-4">
                                    <!-- Left content -->
                                    <div class="col-xl-12 col-lg-12">
                                        <!-- Description tour -->
                                        <div class="tour-details-content">
                                            <h4 class="title text-capitalize">Hotel facilities</h4>

                                            @Html.Raw(Model.Body)


                                        </div>
                                        <!-- / Description tour -->

                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>


        </div>
    </section>
    <!--/ End-of Destination -->
}





@* ---------------- Block Groups ---------------- *@
@foreach (var group in Model.Groups.OrderBy(g => g.SortOrder))
{

    if (group.GroupType == GroupTypes.RoomView)
    {
        var colGroup = Math.Clamp((byte)group.Columns, (byte)1, (byte)12);

        <section class="feature-area feature-area-bg section-padding2">
            <div class="container">
                @if (group.ShowSectionTitle)
                {
                    <div class="row justify-content-center">
                        <div class="col-xl-@colGroup col-lg-@colGroup">
                            <div class="section-title mx-430 mx-auto text-center">
                                @if (group.ShowTitle)
                                {
                                    <span class="highlights fancy-font font-400">
                                        @group.SubHeadingTile
                                    </span>
                                    <h4 class="title">
                                        @group.Title
                                    </h4>
                                }
                                @if (group.ShowDescription)
                                {
                                    <p class="text-muted mb-4">@group.Description</p>
                                }
                            </div>
                        </div>
                    </div>
                }
                <div class="row g-4">
                    @foreach (var block in group.Blocks.OrderBy(b => b.SortOrder))
                    {
                        @await Html.PartialAsync($"~/Themes/Classic/Views/Pages/Blocks/_Block_{block.Type}.cshtml", block)
                    }
                </div>
            </div>
            <!-- shape -->
            <div class="shape">
                <img src="/assets/images/icon/shape.png" alt="travello">
            </div>
        </section>
    }


    if (group.GroupType == GroupTypes.Default)
    {
        var colGroup = Math.Clamp((byte)group.Columns, (byte)1, (byte)12);

        @if (group.ShowSectionTitle)
        {
            <section class="default-area default-bg-before">
                <div class="container">
                    <div class="row justify-content-center">
                        <div class="col-xl-@colGroup col-lg-@colGroup">
                            <div class="section-title mx-430 mx-auto text-center">
                                @if (group.ShowTitle)
                                {
                                    <span class="highlights fancy-font font-400">
                                        @group.SubHeadingTile
                                    </span>
                                    <h4 class="title">
                                        @group.Title
                                    </h4>
                                }
                                @if (group.ShowDescription)
                                {
                                    <p class="text-muted mb-4">@group.Description</p>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        }
        @foreach (var block in group.Blocks.OrderBy(b => b.SortOrder))
        {
            @await Html.PartialAsync($"~/Themes/Classic/Views/Pages/Blocks/_Block_{block.Type}.cshtml", block)
        }
    }






}



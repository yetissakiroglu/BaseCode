@model List<MyHotelSite.Models.GalleryItem>
<section class="page-hero"><h1>Galeri</h1></section>
<div class="grid">
    @foreach (var g in Model)
    {
        <a class="card" href="/@((string)Context.Items["Lang"]!)/gallery/@g.Slug" title="@g.Caption">
            <img src="@g.Url" alt="@g.Caption" style="width:100%;height:180px;object-fit:cover" />
            <div style="padding:.5rem 0">@g.Caption</div>
        </a>
    }
</div>

@model List<MyHotelSite.Models.Campaign>
<section class="page-hero"><h1>Kampanyalar</h1></section>
<div class="grid">
    @foreach (var c in Model)
    {
        <article class="card">
            <img src="@c.HeroImage" alt="@c.Title" style="width:100%;height:180px;object-fit:cover" />
            <h3>@c.Title</h3>
            <p>@c.ShortDescription</p>
            <a href="/@((string)Context.Items["Lang"]!)/campaign/@c.Slug">Detay</a>
        </article>
    }
</div>

@model MyHotelSite.Models.Campaign
<section class="page-hero">
    <h1>@Model.Title</h1>
</section>
<article class="campaign-detail">
    <img src="@Model.HeroImage" alt="@Model.Title" style="width:100%;max-height:360px;object-fit:cover" />
    <p>@Model.ShortDescription</p>
    @if (Model.ValidThrough.HasValue)
    {
        <div class="badge">Son gün: @Model.ValidThrough.Value.ToString("dd.MM.yyyy")</div>
    }
</article>

    </div>
</section> *@

<section id="subscribe">
    <h2>Abone Ol</h2>
    <form method="post" action="/@((string)Context.Items["Lang"]!)/subscription/subscribe">
        @Html.AntiForgeryToken()
        <input name="email" placeholder="E-posta" />
        <button type="submit">Abone Ol</button>
    </form>
</section>

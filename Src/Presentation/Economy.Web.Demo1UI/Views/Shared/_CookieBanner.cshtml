@inject MyHotelSite.Services.ISiteConfigAccessor Config
@inject MyHotelSite.Services.IViewLocalizerHelper L
@{
    var cfg = await Config.GetAsync(1);
    if (cfg.Technical?.CookieBannerEnabled != true)
    {
        <text></text>
        ; return;
    }
    var title = await L.T(Context, "cookie.title", "Cookies");
    var text = await L.T(Context, "cookie.text", "We use cookies to improve your experience.");
    var acc = await L.T(Context, "cookie.accept", "Accept");
    var rej = await L.T(Context, "cookie.reject", "Reject");
}
<div id="cookie-banner" style="position:fixed;bottom:0;left:0;right:0;background:#222;color:#fff;padding:1rem;display:none;justify-content:space-between;align-items:center;z-index:9999">
    <div><strong>@title</strong> — @text</div>
    <div>
        <button id="cookie-accept">@acc</button>
        <button id="cookie-reject" style="margin-left:.5rem;background:#555;color:#fff;border:0;padding:.5rem .75rem">@rej</button>
    </div>
</div>
<script>
    (function(){
      var KEY="cookie.pref";
      function setPref(v){ document.cookie=KEY+"="+v+"; path=/; max-age="+(3600*24*365)+"; SameSite=Lax"; }
      function hasPref(){ return (document.cookie||"").split("; ").some(x=>x.startsWith(KEY+"=")); }
      var banner=document.getElementById('cookie-banner');
      if(!hasPref()){ banner.style.display='flex'; }
      document.getElementById('cookie-accept').onclick=function(){ setPref("accept"); banner.style.display='none'; };
      document.getElementById('cookie-reject').onclick=function(){ setPref("reject"); banner.style.display='none'; };
    })();
</script>

@model (string? GtmId, string? GaId)
@if (!string.IsNullOrWhiteSpace(Model.GtmId))
{
    <script>
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});
        var f=d.getElementsByTagName(s)[0], j=d.createElement(s), dl=l!='dataLayer'?'&l='+l:''; j.async=true;
        j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl; f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer','@Model.GtmId');
    </script>
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=@Model.GtmId" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
}
@if (!string.IsNullOrWhiteSpace(Model.GaId))
{
    <script async src="https://www.googletagmanager.com/gtag/js?id=@Model.GaId"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', '@Model.GaId');
    </script>
}

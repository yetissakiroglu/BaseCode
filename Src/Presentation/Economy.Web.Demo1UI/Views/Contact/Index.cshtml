@using Economy.UI.Models
@model (SiteSettingDto? Setting, SiteTechnicalDto? Technical)

<section class="page-hero">
    <h1>İletişim</h1>
</section>

<section class="contact-info">
    <div><strong>Rezervasyon:</strong> <a href="tel:+905551112233">+90 555 111 22 33</a></div>
    <div><strong>WhatsApp:</strong> <a href="https://wa.me/905551112233">+90 555 111 22 33</a></div>
    <div><strong>Adres:</strong> Yeşilköy Mah. Orman Sok. No:12, Rize</div>
</section>

<section class="map">
    <iframe src="https://www.google.com/maps?q=Rize&output=embed" style="width:100%;height:320px;border:0" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
</section>

<section class="contact-form">
    <form method="post" action="/@((string)Context.Items["Lang"]!)/Contact/Send">
        @Html.AntiForgeryToken()

        <label>Ad Soyad</label>
        <input name="Name" required />
        <label>E-posta</label>
        <input name="Email" type="email" required />
        <label>Telefon</label>
        <input name="Phone" />
        <label>Mesaj</label>
        <textarea name="Message" required></textarea>
        <label><input type="checkbox" required /> KVKK metnini okudum, onaylıyorum.</label>
        <button type="submit">Gönder</button>
    </form>
</section>

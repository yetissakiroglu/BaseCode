@inject ILanguageService Langs
@{
    var baseUrl = "https://www.ornekotel.com"; // istersen appsettings üzerinden
    var requestPath = Context.Request.Path.Value ?? "/";
    var langs = await Langs.GetAsync();
    // ✅ Nonce üretiyoruz (her request için rastgele GUID)
    var nonce = Convert.ToBase64String(Guid.NewGuid().ToByteArray());

    string PathWithShort(string shortCode)
    {
        var segs = requestPath.Trim('/').Split('/', StringSplitOptions.RemoveEmptyEntries).ToList();
        if (segs.Count == 0) return "/" + shortCode;
        if (langs.Any(l => segs[0].Equals(l.ShortCode, StringComparison.OrdinalIgnoreCase) || segs[0].Equals(l.Code, StringComparison.OrdinalIgnoreCase)))
            segs[0] = shortCode;
        else segs.Insert(0, shortCode);
        return "/" + string.Join('/', segs);
    }
    var pageTitle = ViewData["OgTitle"] as string ?? ViewData["Title"] as string ?? "Karadeniz Otel — Doğa ile İç İçe";
    var pageDesc = ViewData["OgDescription"] as string ?? "Karadeniz'in kalbinde huzurlu konaklama.";
    var canonical = baseUrl + requestPath;
}
<!doctype html>
<html lang="@System.Threading.Thread.CurrentThread.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@pageTitle</title>
    <meta name="description" content="@pageDesc" />
    <link rel="canonical" href="@canonical" />
    @foreach (var l in langs)
    {
        <link rel="alternate" hreflang="@l.ShortCode" href="@(baseUrl + PathWithShort(l.ShortCode))" />
    }
    <link rel="alternate" hreflang="x-default" href="@(baseUrl + PathWithShort((await Langs.GetDefaultAsync()).ShortCode))" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
</head>
<body>
    <nav class="navbar navbar-expand-lg bg-light border-bottom">
        <div class="container">
            <a class="navbar-brand" href="/">Hotel</a>
            <div class="ms-auto">@await Component.InvokeAsync("LanguageSwitcher")</div>
        </div>
    </nav>
    <main class="container my-4">@RenderBody()</main>
    <footer class="border-top py-3"><div class="container text-center small text-muted">© @(DateTime.Now.Year) Karadeniz Otel</div></footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script nonce="@nonce">
        document.addEventListener('DOMContentLoaded', function () {
          document.querySelectorAll('form[data-autosubmit] select[name="culture"]').forEach(function (sel) {
            sel.addEventListener('change', function () {
              sel.form?.submit();
            });
          });
        });
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>

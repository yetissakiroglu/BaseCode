    @foreach (var l in langs)
    {
        <link rel="alternate" hreflang="@l.ShortCode" href="@(baseUrl + PathWithShort(l.ShortCode))" />
    }
    <link rel="alternate" hreflang="x-default" href="@(baseUrl + PathWithShort((await Langs.GetDefaultAsync()).ShortCode))" />


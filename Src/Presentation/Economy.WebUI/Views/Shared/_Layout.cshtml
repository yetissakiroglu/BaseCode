@inject ILanguageService Langs
@{
    var baseUrl = "https://www.ornekotel.com"; // istersen appsettings üzerinden
    var requestPath = Context.Request.Path.Value ?? "/";
    var langs = await Langs.GetAsync();
    // ✅ Nonce üretiyoruz (her request için rastgele GUID)
    var nonce = Convert.ToBase64String(Guid.NewGuid().ToByteArray());

    string PathWithShort(string shortCode)
    {
        var segs = requestPath.Trim('/').Split('/', StringSplitOptions.RemoveEmptyEntries).ToList();
        if (segs.Count == 0) return "/" + shortCode;
        if (langs.Any(l => segs[0].Equals(l.ShortCode, StringComparison.OrdinalIgnoreCase) || segs[0].Equals(l.Code, StringComparison.OrdinalIgnoreCase)))
            segs[0] = shortCode;
        else segs.Insert(0, shortCode);
        return "/" + string.Join('/', segs);
    }
    var pageTitle = ViewData["OgTitle"] as string ?? ViewData["Title"] as string ?? "Karadeniz Otel — Doğa ile İç İçe";
    var pageDesc = ViewData["OgDescription"] as string ?? "Karadeniz'in kalbinde huzurlu konaklama.";
    var canonical = baseUrl + requestPath;
}

@model IReadOnlyList<Economy.Web.UI.Models.BreadcrumbItem>
@{
    if (Model is null || Model.Count == 0) { return; }
}

<nav aria-label="breadcrumb" itemscope itemtype="https://schema.org/BreadcrumbList" class="mb-3">
    <ol class="breadcrumb mb-0">
        @for (var i = 0; i < Model.Count; i++)
        {
            var item = Model[i];
            <li class="breadcrumb-item @(item.IsCurrent ? "active" : null)"
                itemprop="itemListElement"
                itemscope itemtype="https://schema.org/ListItem"
                @(item.IsCurrent ? "aria-current=page" : "")>
                @if (!item.IsCurrent)
                {
                    <a itemprop="item" href="@item.Url"><span itemprop="name">@item.Title</span></a>
                }
                else
                {
                    <span itemprop="name">@item.Title</span>
                }
                <meta itemprop="position" content="@(i + 1)" />
            </li>
        }
    </ol>
</nav>

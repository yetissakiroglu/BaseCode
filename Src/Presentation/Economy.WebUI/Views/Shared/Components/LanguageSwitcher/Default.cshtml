@model IReadOnlyList<LangItem>
@{
    var current = ViewBag.Current as string;
}


<form method="post" asp-controller="Language" asp-action="Set" data-autosubmit>
    @Html.AntiForgeryToken()
    <select name="culture" class="form-select form-select-sm">
        @foreach (var l in Model)
        {
            <option value="@l.ShortCode" selected="@(l.Code == current ? "selected" : null)">@l.Name</option>
        }
    </select>
    <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
</form>

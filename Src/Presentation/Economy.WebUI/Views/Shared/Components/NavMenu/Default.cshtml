<ul class="navbar-nav me-auto mb-2 mb-lg-0">
    @foreach (var it in Model)
    {
        var hasChildren = it.Children != null && it.Children.Any();
        if (!hasChildren)
        {
            <li class="nav-item">
                <a class="nav-link @(it.Active ? "active" : "")"
                   href="@it.Href"
                   @(it.External ? "target=_blank rel=noopener" : null)>@it.Title</a>
            </li>
        }
        else
        {
            <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle @(it.Active ? "active" : "")"
                   href="#"
                   role="button" data-bs-toggle="dropdown">@it.Title</a>
                <ul class="dropdown-menu">
                    @foreach (var ch in it.Children!)
                    {
                        <li>
                            <a class="dropdown-item"
                               href="@ch.Href"
                               @(ch.External ? "target=_blank rel=noopener" : null)>@ch.Title</a>
                        </li>
                    }
                </ul>
            </li>
        }
    }
</ul>

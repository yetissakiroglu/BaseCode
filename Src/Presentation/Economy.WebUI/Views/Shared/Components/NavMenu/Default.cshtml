@model List<Economy.Web.UI.Models.MenuLinkVm>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    void RenderItems(List<Economy.Web.UI.Models.MenuLinkVm> items, bool isRoot = false, int level = 0)
    {
        <ul class="@(isRoot ? "listing d-none d-lg-block" : "submenu")" @(isRoot ? "id=navigation" : null)>
            @foreach (var it in items)
            {
                var hasChildren = it.Children != null && it.Children.Any();
                <li class="single-list">
                    @if (hasChildren)
                    {
                        <a href="javascript:void(0)" class="single @(it.Active ? "link-active" : null)">
                            @it.Title
                            @if (level == 0)
                            {
                                <i class="ri-arrow-down-s-line"></i>
                                ;
                            }
                            else
                            {

                                <i class="ri-arrow-right-s-line"></i>
                                ;
                            }
                        </a>
                        RenderItems(it.Children!, false, level + 1);
                    }
                    else
                    {
                        <a href="@it.Href"
                           class="single @(it.Active ? "link-active" : null)"
                           @(it.External ? "target=_blank rel=noopener" : null)>@it.Title</a>
                    }
                </li>
            }
        </ul>
    }
}


@{
    RenderItems(Model, true, 0);
}





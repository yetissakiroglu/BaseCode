@model BlogPost
@{
    ViewData["Title"] = Model.Title;
}
<article class="mb-4">
    <h1>@Model.Title</h1>
    <div class="text-muted small">@Model.UpdatedAt.ToLocalTime()</div>
    <div class="mt-3">@Html.Raw(Model.Html)</div>
    <div class="mt-3">
        @foreach (var t in Model.Tags)
        {
            <a class="badge bg-secondary text-decoration-none" asp-action="Index" asp-route-tag="@t">@t</a>
        }
    </div>
</article>

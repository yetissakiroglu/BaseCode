@inject Microsoft.Extensions.Localization.IStringLocalizer Localizer
@{
    ViewData["Title"] = Localizer["Views.Home.Title"]; var sliders = ViewBag.Sliders as List<SliderItem> ?? new();
}
<div id="hero" class="mb-4">
    @foreach (var s in sliders)
    {
        <div class="mb-3 p-4 rounded bg-light">
            <h2>@s.Title</h2><p class="text-muted">@s.Subtitle</p>
            <img src="@s.ImageUrl" class="img-fluid rounded" alt="@s.Title" />
        </div>
    }
</div>
<a class="btn btn-primary" href="@Url.Action("Index", "Rooms")">@Localizer["Odalarımız"]</a>

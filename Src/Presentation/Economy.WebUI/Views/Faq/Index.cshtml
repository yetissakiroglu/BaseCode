@model List<FaqItem>
@{
    ViewData["Title"] = "SSS";
    var q = ViewBag.Query as string;
}
<h1 class="mb-3">Sıkça Sorulan Sorular</h1>

<form class="mb-3" method="get">
    <div class="input-group">
        <input name="q" value="@q" class="form-control" placeholder="Ara..." />
        <button class="btn btn-outline-secondary" type="submit">Ara</button>
    </div>
</form>

<div class="accordion" id="faqAcc">
    @for (int i = 0; i < Model.Count; i++)
    {
        var f = Model[i]; var hid = "f" + f.Id;
        <div class="accordion-item">
            <h2 class="accordion-header" id="h@hid">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#@hid">@f.Question</button>
            </h2>
            <div id="@hid" class="accordion-collapse collapse" data-bs-parent="#faqAcc">
                <div class="accordion-body">@f.Answer</div>
            </div>
        </div>
    }
</div>

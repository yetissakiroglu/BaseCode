@model RoomDetail
@inject Microsoft.Extensions.Localization.IStringLocalizer Localizer
@{
    ViewData["Title"] = Model.Name;


}



<div class="row">
    <div class="col-md-7">
        <img src="@Model.CoverImage" class="img-fluid rounded mb-3" />
        <div class="row g-2">
            @foreach (var g in Model.Gallery)
            {
                <div class="col-4"><img src="@g" class="img-fluid rounded" /></div>
            }
        </div>
    </div>
    <div class="col-md-5">
        <h1>@Model.Name</h1>
        <div class="text-muted mb-2">@Localizer["Gecelik"] @Model.PricePerNight.ToString("C0")</div>
        <div>@Html.Raw(Model.HtmlDetail)</div>

        <div class="card mt-3">
            <div class="card-body">
                <h5 class="card-title">@Localizer["Rezervasyon Talebi"]</h5>
                <form id="rezForm" method="post" asp-action="Reserve">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="RoomSlug" value="@Model.Slug" />
                    <input type="hidden" name="recaptchaToken" />
                    <div class="row g-2">
                        <div class="col-6"><label class="form-label">Check-in</label><input type="date" name="CheckIn" class="form-control" required /></div>
                        <div class="col-6"><label class="form-label">Check-out</label><input type="date" name="CheckOut" class="form-control" required /></div>
                        <div class="col-6"><label class="form-label">@Localizer["Ad Soyad"]</label><input name="Name" class="form-control" required /></div>
                        <div class="col-6"><label class="form-label">Email</label><input type="email" name="Email" class="form-control" required /></div>
                        <div class="col-6"><label class="form-label">@Localizer["Telefon"]</label><input name="Phone" class="form-control" /></div>
                        <div class="col-6"><label class="form-label">Guests</label><input type="number" name="Guests" value="2" min="1" class="form-control" required /></div>
                        <div class="col-12"><label class="form-label">Notes</label><textarea name="Notes" rows="3" class="form-control"></textarea></div>
                    </div>
                    <button class="btn btn-success mt-3 w-100" type="submit">@Localizer["Talebi Gönder"]</button>
                </form>
            </div>
        </div>

        <div id="comments" class="mt-3"></div>
        <div class="card mt-2">
            <div class="card-body">
                <form id="cform">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="type" value="room" />
                    <input type="hidden" name="slug" value="@Model.Slug" />
                    <input type="hidden" name="recaptchaToken" />
                    <div class="row g-2">
                        <div class="col-md-4"><input name="name" class="form-control" placeholder="Adınız" required /></div>
                        <div class="col-md-4">
                            <select name="rating" class="form-select">
                                <option value="5">★★★★★</option>
                                <option value="4">★★★★</option>
                                <option value="3">★★★</option>
                                <option value="2">★★</option>
                                <option value="1">★</option>
                            </select>
                        </div>
                        <div class="col-12"><textarea name="text" class="form-control" rows="3" placeholder="Yorumunuz" required></textarea></div>
                    </div>
                    <button class="btn btn-primary mt-2" type="button" onclick="submitComment()">Gönder</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        async function attachRecaptchaToken(formId){ document.querySelector('#'+formId+' [name="recaptchaToken"]').value = 'demo-token'; }

        document.getElementById('rezForm')?.addEventListener('submit', async (e)=>{
          e.preventDefault(); const f=e.target; await attachRecaptchaToken('rezForm');
          const res=await fetch('@Url.Action("Reserve", "Rooms")',{ method:'POST', body:new FormData(f),
             headers:{'X-Requested-With':'XMLHttpRequest','RequestVerificationToken':f.querySelector('input[name="__RequestVerificationToken"]').value}});
          const j=await res.json(); alert(j.ok ? '@Localizer["Talebiniz alındı."] '+(j.reference??'') : '@Localizer["Gönderim başarısız."]');
          if(j.ok) f.reset();
        });

        async function loadComments(){
          const html = await (await fetch('@Url.Action("List", "Comments")'+'?type=room&slug=@Model.Slug')).text();
          document.getElementById('comments').innerHTML = html;
        }
        async function submitComment(){
          const f=document.getElementById('cform'); await attachRecaptchaToken('cform');
          const res=await fetch('@Url.Action("Create", "Comments")',{ method:'POST', body:new FormData(f),
             headers:{'X-Requested-With':'XMLHttpRequest','RequestVerificationToken':f.querySelector('input[name="__RequestVerificationToken"]').value}});
          const j=await res.json(); if(j.ok){ f.reset(); loadComments(); } else alert('Gönderilemedi');
        }
        loadComments();
    </script>
}

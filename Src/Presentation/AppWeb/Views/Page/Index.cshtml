@using AppWeb.Components
@model AppPageDto


<component type="typeof(_BreadcrumbsComponent)" render-mode="ServerPrerendered" param-Breadcrumbs="@Model.Breadcrumb" />

@{
    foreach (var item in Model.AppPageSections)
    {
        // `SectionType` değerini kontrol etmek için bir switch-case yapısı
        switch (item.AppSection.SectionType)
        {


            case SectionType.HTML:
                {

                    <component type="typeof(_PageComponent)" render-mode="ServerPrerendered" param-AppSection="@item.AppSection" />


                }
                break;
            case SectionType.Slide:
                {
            

                }
                break;
            default:
                {

                    // Varsayılan işleme mantığı
                }
                break;
        }
    }
}

<span>test </span>
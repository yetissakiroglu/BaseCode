@using AppWeb.Components
@using System.Globalization
@model AppPageDto

@{
    ViewData["Title"] = "Home Page";
}

@{
    if (Model is not null)
    {
        foreach (var item in Model.AppPageSections)
        {
            // `SectionType` değerini kontrol etmek için bir switch-case yapısı
            switch (item.AppSection.SectionType)
            {
                case SectionType.Slide:
                    {
                        <component type="typeof(_SlideHomeComponent)" render-mode="ServerPrerendered" param-AppSectionID="@item.AppSection.Id" param-LanguageCode="@Model.LanguageCode" />
                    }
                    break;
                case SectionType.Room:
                    {
                        <component type="typeof(_RoomHomeComponent)" render-mode="ServerPrerendered" param-AppSection="@item.AppSection" param-LanguageCode="@Model.LanguageCode" />
                    }
                    break;
                case SectionType.Service:
                    {
                        <component type="typeof(_ServiceHomeComponent)" render-mode="ServerPrerendered" param-AppSection="@item.AppSection" param-LanguageCode="@Model.LanguageCode" />
                    }
                    break;
                case SectionType.Corporate:
                    {
                        <component type="typeof(_CorporateComponent)" render-mode="ServerPrerendered" param-AppSection="@item.AppSection" />
                    }
                    break;
                default:
                    {

                        // Varsayılan işleme mantığı
                    }
                    break;
            }
        }
    }
}







@using Economy.Application.Dtos.AppPageDtos
@using Economy.Core.Extensions
@using MediatR
@inject IMediator _mediator
@code {
    [Parameter]
    public AppSectionDto AppSection { get; set; }
}


<section class="bg-white kurumsal">
    <div class="h1-introduce">
        <div class="container">
            <div class="row">
                <div class="col-sm-6 text-center ">
                    <div class="sc-heading style-02">
                        <div class="section_header overlay">
                            <span>HOŞGELDİNİZ</span>

                            <p>@AppSection.Name</p>
                            <img src="img/decoration-1.png" alt="Image">
                        </div>

                        <div class="description">
                            @AppSection.Content
                        </div>
                        <div class="head-button">
                            <a href="/tr/otelimiz" class="more-info">Daha Fazla Bilgi</a>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="sc-img-box row">
                        @foreach (var item in AppSection.AppSectionImages)
                        {
                            <div class="col-sm-6">
                                <a href="#">
                                    <img src="img/@item.Thumbnail" alt="">
                                </a>
                            </div>
                        }
                                              

                    </div>
                </div>
            </div>
        </div>
    </div>
</section>


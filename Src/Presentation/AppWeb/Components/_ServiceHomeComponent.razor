@using Economy.Application.Dtos.AppContentDtos
@using Economy.Application.Dtos.AppPageDtos
@using Economy.Application.Queries.AppContents
@using Economy.Core.Extensions
@using MediatR
@inject IMediator _mediator

@code {
    private class AppContentHtmlDto
    {
        public string? Image1 { get; set; }
        public string? Caption1 { get; set; }

        public string? Image2 { get; set; }
        public string? Caption2 { get; set; }

        public string? Image3 { get; set; }
        public string? Caption3 { get; set; }

        public string? Image4 { get; set; }
        public string? Caption4 { get; set; }
    }

    private List<string> errorMessages = new();
    private SectionTypeModel dataParse = new();
    private AppContentHtmlDto AppContentHtml = new();

    [Parameter]
    public AppSectionDto AppSection { get; set; }
    [Parameter]
    public string LanguageCode { get; set; }

    protected override async Task OnInitializedAsync()
    {
        dataParse = AppSection.Content.ParseSectionTypeModel();

        var result = await _mediator.Send(new GetAllAppContentByLanguageCodeByAppContentIdsQuery(dataParse.PageIDs, LanguageCode));
        if (result.IsSuccess)
        {
            var contents = result.Data;

            if (contents.Count > 0)
            {
                var t = contents[0].Translations.FirstOrDefault();
                AppContentHtml.Image1 = contents[0].Thumbnail;
                AppContentHtml.Caption1 = t?.Title;
            }

            if (contents.Count > 1)
            {
                var t = contents[1].Translations.FirstOrDefault();
                AppContentHtml.Image2 = contents[1].Thumbnail;
                AppContentHtml.Caption2 = t?.Title;
            }

            if (contents.Count > 2)
            {
                var t = contents[2].Translations.FirstOrDefault();
                AppContentHtml.Image3 = contents[2].Thumbnail;
                AppContentHtml.Caption3 = t?.Title;
            }

            if (contents.Count > 3)
            {
                var t = contents[3].Translations.FirstOrDefault();
                AppContentHtml.Image4 = contents[3].Thumbnail;
                AppContentHtml.Caption4 = t?.Title;
            }
        }
        else
        {
            // Eğer Messages listesi varsa, tüm mesajları al
            if (result.Message?.Messages != null && result.Message.Messages.Count() > 0)
            {
                errorMessages = result.Message.Messages.ToList();
            }
        }
    }
}
<div class="container margin_60_35">

    <h1 class="main_title"><em></em>@dataParse.SectionHeading <span>Hotel and Bed&amp;Breakfast</span></h1>
    <p class="lead styled">
        @dataParse.SectionDescription
    </p>

    <div class="row">
        <div class="col-lg-6">
            <div class="mosaic_container">
                <img src="@AppContentHtml.Image1" alt="" class="img-fluid">
                <span class="caption_2">@AppContentHtml.Caption1</span>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="col-12">
                <div class="mosaic_container">
                    <img src="@AppContentHtml.Image2" alt="" class="img-fluid">
                    <span class="caption_2">@AppContentHtml.Caption2</span>
                </div>
            </div>

            <div class="row">
                <div class="col-6">
                    <div class="mosaic_container">
                        <img src="@AppContentHtml.Image3" alt="" class="img-fluid">
                        <span class="caption_2">@AppContentHtml.Caption3</span>
                    </div>
                </div>
                <div class="col-6">
                    <div class="mosaic_container">
                        <img src="@AppContentHtml.Image4" alt="" class="img-fluid">
                        <span class="caption_2">@AppContentHtml.Caption4</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>





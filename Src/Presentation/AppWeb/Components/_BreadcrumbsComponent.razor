@using Economy.Domain.Models

@code {
    [Parameter]
    public List<BreadcrumbDto>? Breadcrumbs { get; set; }
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item active" aria-current="page">Home</li>
    </ol>
</nav>

<!-- Breadcrumbs S t a r t -->
<section class="breadcrumbs-area breadcrumb-bg">
    <div class="container">
@*         <h1 class="title wow fadeInUp" data-wow-delay="0.0s">@Breadcrumbs?.LastOrDefault()?.Name</h1>
 *@        <div class="breadcrumb-text">
            <nav aria-label="breadcrumb" class="breadcrumb-nav wow fadeInUp" data-wow-delay="0.1s">
                <ul class="breadcrumb listing">
                    @foreach (var item in Breadcrumbs)
                    {
                        if (item.Active)
                        {
                            <li class="breadcrumb-item single-list" aria-current="page">
                                <a href="javascript:void(0)"
                                   class="single active">@item.Name</a>
                            </li>
                        }else
                        {
                            <li class="breadcrumb-item single-list"><a href="@item.Url" class="single">@item.Name</a></li>
                        }
                       
                    }
                  
                </ul>
            </nav>
        </div>
    </div>

</section>
<!--/ End-of Breadcrumbs-->

@using Economy.Application.Dtos.AppContentDtos
@using Economy.Application.Dtos.AppPageDtos
@using Economy.Application.Queries.AppContents
@using Economy.Core.Extensions
@using MediatR
@inject IMediator _mediator

@code {
    private List<string> errorMessages = new();
    private List<AppContentDto> AppContents = new();


    [Parameter]
    public AppSectionDto AppSection { get; set; }
    [Parameter]
    public string LanguageCode { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var dataParse = AppSection.Content.ParseSectionTypeModel();

        var result = await _mediator.Send(new GetAllAppContentByLanguageCodeByAppContentIdsQuery(dataParse.PageIDs, LanguageCode));

        if (result.IsSuccess)
        {
            AppContents = result.Data;
        }
        else
        {
            // Eğer Messages listesi varsa, tüm mesajları al
            if (result.Message?.Messages != null && result.Message.Messages.Count() > 0)
            {
                errorMessages = result.Message.Messages.ToList();
            }
        }
    }
}

@{
    int index = 0;
}

@foreach (var item in AppContents)
{
    if (index % 2 == 0)
    {

        <div class="container_styled_1">
            <div class="container margin_60">
                <div class="row">
                    <div class="col-lg-5 offset-lg-1">
                        <figure class="room_pic">
                            <a href="@item.Translations.FirstOrDefault().Url"><img src="@item.Thumbnail" alt="@item.Translations.FirstOrDefault().Title" class="img-fluid"></a>
                            <span class="wow zoomIn"><sup>$</sup>120<small>Per night</small></span>
                        </figure>
                    </div>
                    <div class="col-lg-4 offset-lg-1">
                        <div class="room_desc_home">
                            <h3>@item.Translations.FirstOrDefault().Title </h3>
                            <p>
                                @item.Translations.FirstOrDefault().ShortDescription
                            </p>
                            <ul>
                                <li>
                                    <div class="tooltip_styled tooltip-effect-4">
                                        <span class="tooltip-item"><i class="icon_set_2_icon-104"></i></span>
                                        <div class="tooltip-content">
                                            King size bed
                                        </div>
                                    </div>
                                </li>
                                <li>
                                    <div class="tooltip_styled tooltip-effect-4">
                                        <span class="tooltip-item"><i class="icon_set_2_icon-118"></i></span>
                                        <div class="tooltip-content">
                                            Shower
                                        </div>
                                    </div>
                                </li>
                                <li>
                                    <div class="tooltip_styled tooltip-effect-4">
                                        <span class="tooltip-item"><i class="icon_set_2_icon-116"></i></span>
                                        <div class="tooltip-content">
                                            Plasma TV
                                        </div>
                                    </div>
                                </li>
                            </ul>
                            <a href="@item.Translations.FirstOrDefault().Url" target="_blank" class="btn_1_outline"> Odayı İncele </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {

        <div class="container margin_60">
            <div class="row">
                <div class="col-lg-5 offset-lg-1 order-lg-2">
                    <figure class="room_pic left">
                        <a href="@item.Translations.FirstOrDefault().Url">
                            <img src="@item.Thumbnail" alt="@item.Translations.FirstOrDefault().Title" class="img-fluid">
                        </a>
                        <span class="wow zoomIn"><sup>$</sup>150<small>Per night</small></span>
                    </figure>
                </div>
                <div class="col-lg-4 offset-lg-1 order-lg-1">
                    <div class="room_desc_home">
                        <h3>@item.Translations.FirstOrDefault().Title </h3>
                        <p>
                            @item.Translations.FirstOrDefault().ShortDescription
                        </p>
                        <ul>
                            <li>
                                <div class="tooltip_styled tooltip-effect-4">
                                    <span class="tooltip-item"><i class="icon_set_2_icon-104"></i></span>
                                    <div class="tooltip-content">
                                        King size bed
                                    </div>
                                </div>
                            </li>
                            <li>
                                <div class="tooltip_styled tooltip-effect-4">
                                    <span class="tooltip-item"><i class="icon_set_2_icon-111"></i></span>
                                    <div class="tooltip-content">
                                        Bathtub
                                    </div>
                                </div>
                            </li>
                            <li>
                                <div class="tooltip_styled tooltip-effect-4">
                                    <span class="tooltip-item"><i class="icon_set_2_icon-116"></i></span>
                                    <div class="tooltip-content">
                                        Plasma TV
                                    </div>
                                </div>
                            </li>
                            <li>
                                <div class="tooltip_styled tooltip-effect-4">
                                    <span class="tooltip-item"><i class="icon_set_2_icon-106"></i></span>
                                    <div class="tooltip-content">
                                        Safe box
                                    </div>
                                </div>
                            </li>
                        </ul>
                        <a href="@item.Translations.FirstOrDefault().Url" class="btn_1_outline">Odayı İncele</a>
                    </div>
                </div>
            </div>
        </div>
    }

    index++;
}




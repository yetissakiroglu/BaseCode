@using AppWeb.Providers
@inject LanguageProvider _languageProvider


@code {
    public string? LanguageCode { get; set; }
    protected override async Task OnInitializedAsync()
    {
         LanguageCode = _languageProvider.GetCurrentLanguage();
    }
}

<header>
    <div class="container">
        <div class="row">
            <div class="col-3">
                <a href="index.html" id="logo">
                    <img src="img/logo.png" width="190" height="23" alt="" data-retina="true">
                </a>
            </div>
            <nav class="col-9 position-relative">
                <a class="cmn-toggle-switch cmn-toggle-switch__htx open_close" href="javascript:void(0);"><span>Menu mobile</span></a>
                  <_LanguageComponent LanguageCode="@LanguageCode" />
                <div class="main-menu">
                    <div id="header_menu">
                        <img src="img/logo_m.png" width="141" height="40" alt="" data-retina="true">
                    </div>
                    <a href="#" class="open_close" id="close_in"><i class="icon_set_1_icon-77"></i></a>
                    <_MenuComponent LanguageCode="@LanguageCode" />
                </div>
            </nav>
        </div>
    </div>
</header>

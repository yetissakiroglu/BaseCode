@using AppWeb.Providers
@using Economy.Application.Dtos.AppSettingDtos
@using Economy.Application.Interfaces
@using Economy.Application.Queries.AppSettings
@using MediatR
@inject LanguageProvider _languageProvider
@inject IMediator _mediator
@code {
    public string? LanguageCode { get; set; }
    public AppLogoSettingDto AppLogoSetting { get; set; } = new AppLogoSettingDto();

    protected override async Task OnInitializedAsync()
    {
        LanguageCode = _languageProvider.GetCurrentLanguage();
        var result = await _mediator.Send(new GetAppLogoSettingQuery());
        if(result.IsSuccess)
        {
            AppLogoSetting = result.Data;            
        }
    }
}

<header>
    <div class="container">
        <div class="row">
            <div class="col-3">
                <a href="/@LanguageCode" id="logo">
                    <img src="@AppLogoSetting.WebLogoPath" width="190" height="23" alt="" data-retina="true">
                </a>
            </div>
            <nav class="col-9 position-relative">
                <a class="cmn-toggle-switch cmn-toggle-switch__htx open_close" href="javascript:void(0);"><span>Menu mobile</span></a>
                  <_LanguageComponent LanguageCode="@LanguageCode" />
                <div class="main-menu">
                    <div id="header_menu">
                        <img src="@AppLogoSetting.MobileLogoPath" width="141" height="40" alt="" data-retina="true">
                    </div>
                    <a href="#" class="open_close" id="close_in"><i class="icon_set_1_icon-77"></i></a>
                    <_MenuComponent LanguageCode="@LanguageCode" />
                </div>
            </nav>
        </div>
    </div>
</header>

@using Economy.Web.Demo1.Services
@inject ISiteConfigAccessor SiteCfg
@inject IHttpContextAccessor HttpCtx
@{
    var ctx = HttpCtx.HttpContext!;
    var lang = (string?)Context.Items["Lang"] ?? "tr";
        var cfg = await SiteCfg.GetAsync(lang); 
    var current = ctx.Items["Lang"]?.ToString() ?? cfg.Technical.SupportedLanguages.First();
    var langs = cfg.Technical.SupportedLanguages.Select(x => new { Code = x, Name = x.ToUpper() }).ToList();

    string BuildUrl(string code) {
        var req = ctx.Request;
        var path = req.Path.Value ?? "/";
        var parts = path.Split('/', StringSplitOptions.RemoveEmptyEntries).ToList();
        if (parts.Count==0) parts.Insert(0, code); else parts[0] = code;
        var newPath = "/" + string.Join('/', parts);
        return $"{req.Scheme}://{req.Host}{newPath}{req.QueryString}";
    }
}
<select onchange="if(this.value) window.location.href=this.value;">
@foreach (var l in langs)
{
        var t =l.Code == current ? "selected" : null;
        <option value="@BuildUrl(l.Code)" selected="@t">@l.Name</option>
}
</select>

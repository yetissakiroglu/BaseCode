@using Economy.UI.Models.PageDtos
@model PageUnifiedVm
@inject IHttpContextAccessor HttpCtx

@{
    var ctx = HttpCtx.HttpContext!;
    var req = ctx.Request;
    var hreflangs = Model.Hreflangs ?? new List<HreflangVm>();
}

<select onchange="if(this.value) window.location.href=this.value;">
    @foreach (var h in hreflangs)
    {
        var isCurrent = string.Equals(h.Lang, Model.Lang, StringComparison.OrdinalIgnoreCase);
        var url = $"{req.Scheme}://{req.Host}/{h.Url}";
        <option value="@url" selected="@(isCurrent ? "selected" : null)">
            @h.Lang.ToUpper()
        </option>
    }
</select>